# Canton DEX — Operator Backend Environment Variables
# Copy this file to .env and fill in the values.

# --- Canton Ledger Connection ---

# JSON Ledger API base URL (required for production / testnet).
CANTON_LEDGER_URL=http://localhost:7575

# Bearer JWT for the JSON Ledger API.
CANTON_LEDGER_TOKEN=

# JSON Ledger API user id (default: ledger-api-user).
CANTON_USER_ID=ledger-api-user

# --- Party Configuration ---

# Operator party (DEX market venue).
CANTON_OPERATOR=

# LP registrar party (manages LP token lifecycle).
CANTON_LP_REGISTRAR=

# Asset admin party (governs instruments).
CANTON_ADMIN=

# --- Network ---

# Display label for the Canton network (default: canton:devnet).
CANTON_NETWORK=canton:devnet

# Synchronizer id, e.g. global-domain::1220...
CANTON_SYNCHRONIZER=

# Daml package hash or prefix for template ids.
CANTON_DEX_PACKAGE_ID=

# --- Factory Contract IDs ---

# AllocationFactory contract id (from registry bootstrap).
CANTON_ALLOC_FACTORY_CID=

# SettlementFactory contract id (from registry bootstrap).
CANTON_SETTLE_FACTORY_CID=

# --- Server ---

# HTTP server port (default: 8080).
PORT=8080

# SQLite database path for the indexer (default: ./data/operator.db).
DB_PATH=./data/operator.db

# Indexer polling interval in milliseconds (default: 5000).
INDEXER_INTERVAL_MS=5000

# Admin auth token for /v1/admin/* routes. If unset, admin routes are unprotected.
OPERATOR_ADMIN_TOKEN=

# CORS allowed origins (comma-separated). If unset, allows all origins.
# Include the preview port you use for local UI testing.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:18081

# --- Testnet Party Faucet (testnet deployments only) ---

# Set to 1 to register POST /v1/testnet/party and GET /v1/testnet/hosting.
# Anything else leaves both routes unregistered (404). The faucet allocates a
# throwaway hosted party for an anonymous caller, so leave it off anywhere that
# is not a public testnet. Pair with VITE_ENABLE_TESTNET_PARTY=1 in the dApp.
DEX_TESTNET_ONBOARDING=0

# Parties the faucet may allocate per UTC day across all callers (default: 200).
DEX_TESTNET_PARTY_DAILY_CAP=200

# Parties the faucet may allocate per UTC day per client address (default: 3).
DEX_TESTNET_PARTY_IP_DAILY_CAP=3

# Test balances seeded onto each new party: "<instrumentId>:<amount>,..."
# (default: dUSD:10000). Amounts are clamped to 1000000 per instrument.
#
# The airdrop mints through Registry_Mint, so every instrument listed here must
# already be registered on the admin's Registry.V2 -- run
# `node --import tsx scripts/bootstrap-registry.ts` (registryV2.instruments in
# scripts/bootstrap-registry.json) first. The faucet registers nothing itself:
# an unregistered instrument makes POST /v1/testnet/party fail 503 with a
# message naming the bootstrap step.
DEX_TESTNET_AIRDROP=dUSD:10000

# Set to 1 only when a trusted reverse proxy sets X-Forwarded-For, so the
# per-IP cap is charged to the real client. Off by default: on a directly
# exposed server the header is caller-controlled and would defeat the cap.
DEX_TESTNET_TRUST_PROXY=0
