-- Executable proof behind the pool-liquidity concept docs. Each script runs a
-- full add- or remove-liquidity flow and checks that assets land with the right
-- party, that LP tokens are minted or burned to match, and that unsafe shortcuts
-- (stale price, expired request, forged or oversized mint, one-party settle) fail.

-- | DvP liquidity at the boundary, against Registry.V2 (holding-tracking +
-- iterated settlement + mint/burn accounts). Proves:
--   - atomic add: LP funds base+quote and receives LP tokens in one flow;
--   - remove delivers base+quote to the HOLDER and burns LP via burnAccount;
--   - stale-quote rejection;
--   - the settle is co-controlled (operator + lpRegistrar).
--
-- To keep the harness to one registry we use admin == lpRegistrar (the
-- two per-admin batches collapse to one); the choice still issues both.
-- Design context: `docs/concepts/design-tour.md#liquidity-and-pool-custody`.
module CantonDex.Tests.PoolLiquidityRulesTests where

import DA.Assert
import DA.List (head)
import DA.Map qualified as Map
import DA.TextMap qualified as TextMap
import DA.Time (addRelTime, hours)
import Daml.Script

import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.AllocationInstructionV2 qualified as V2
import Splice.Api.Token.AllocationRequestV2 qualified as V2
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.MetadataV1
import Splice.Testing.Utils (emptyExtraArgs)
import Splice.Util.Token.Wallet.BatchingUtilityV2 qualified as BU

import CantonDex.Dex.Pool
import CantonDex.Dex.PoolSlice qualified as Slice
import CantonDex.Dex.PoolState qualified as PS
import CantonDex.Dex.PoolModel qualified as PM
import CantonDex.Dex.PoolLiquidityRules qualified as Dvp
import CantonDex.Dex.LiquidityAllocationRequest qualified as LAR
import CantonDex.Lp.Policy qualified as LP
import CantonDex.Lp.Instrument qualified as Lp
import CantonDex.Registry.V2 qualified as RegV2
import CantonDex.Trading.Utils qualified as Utils
import CantonDex.Trading.AdminBatch qualified as AB

-- The pool's LP-token identifier: what a provider receives in return for the
-- base+quote it deposits.
lpId : Text
lpId = "BTC-USDC-LP"

-- A fixture: one Registry.V2 (admin = lpRegistrar = `registry`), an
-- Unfunded pool, its rules, the LP policy, and the operator's DvP rules.
data Fixture = Fixture with
    operator : Party
    registry : Party
    factoryCid : ContractId V2.AllocationFactory
    settleCid : ContractId V2.SettlementFactory
    poolId : PoolId
    poolCid : ContractId Pool
    stateCid : ContractId PS.PoolState
    policyCid : ContractId LP.LPTokenPolicy
    dvpCid : ContractId Dvp.PoolLiquidityRules

-- `lps` become Registry observers so they can exercise the factory.
setup : [Party] -> Script Fixture
setup = setupWithFee 30

-- Stand up the whole fixture at a chosen fee: allocate the parties, create the
-- one registry, and seed the pool, its state, the LP-token policy, and the rules
-- contract — everything a test needs before driving an add or remove.
setupWithFee : Int -> [Party] -> Script Fixture
setupWithFee feeBps lps = do
  -- Parties: `operator` runs the pool; `registry` is the token admin. Reusing one
  -- party as both admin and LP registrar keeps the harness to a single registry.
  operator <- allocateParty "operator"
  registry <- allocateParty "registry"   -- admin AND lpRegistrar
  -- The single Registry.V2 contract; below it is viewed as both the allocation
  -- factory and the settlement factory. `lps` are registered so they can allocate.
  reg <- submit registry $ createCmd RegV2.Registry with admin = registry; users = operator :: lps
  let factoryCid : ContractId V2.AllocationFactory = toInterfaceContractId reg
      settleCid : ContractId V2.SettlementFactory = toInterfaceContractId reg
      poolId = "BTC-USDC"
      lpInstrumentId = V2.InstrumentId with admin = registry; id = lpId
  -- Seed the pool definition: the BTC/USDC pair, its registrar/admin, and fee.
  poolCid <- submit operator $ createCmd Pool with
    poolId; operator; lpRegistrar = registry
    baseInstrumentId = V2.InstrumentId with admin = registry; id = "BTC"
    quoteInstrumentId = V2.InstrumentId with admin = registry; id = "USDC"
    lpInstrumentId
    feeBps
  -- Seed the pool's live state empty: no reserves, no LP supply, not yet funded.
  stateCid <- submit operator $ createCmd PS.PoolState with
    poolId; operator; lpRegistrar = registry
    status = PS_Unfunded
    reserves = PoolReserves with baseAmount = 0.0; quoteAmount = 0.0
    totalLpSupply = 0.0; publicReaders = []
  -- The LP-token policy (mint/burn authority for this pool's LP token), empty.
  policyCid <- submit registry $ createCmd LP.LPTokenPolicy with
    lpRegistrar = registry; operator; lpInstrumentId
    totalSupply = 0.0; active = True
  -- The rules contract whose Settle* choices drive every add and remove below.
  dvpCid <- submit (actAs [operator, registry]) $
    createCmd Dvp.PoolLiquidityRules with operator; lpRegistrar = registry
  pure Fixture with
    operator; registry; factoryCid; settleCid; poolId; poolCid; stateCid; policyCid; dvpCid

-- One registry administers base, quote, and LP here, so the per-admin
-- settlement map collapses to a single entry.
singleAdminBatches : Fixture -> ExtraArgs -> Map.Map Party AB.RegistryBatchInput
singleAdminBatches fx extraArgs =
  Map.fromList [(fx.registry, AB.RegistryBatchInput with factoryCid = fx.settleCid; extraArgs)]

-- Mint a Registry.V2 holding directly (Holding is signatory admin+owner).
mintHolding : Party -> Party -> Text -> Decimal -> Script (ContractId RegV2.Holding)
mintHolding registry owner instrumentId amount =
  submit (actAs [registry, owner]) $ createCmd RegV2.Holding with
    admin = registry; owner; instrumentId; amount; locked = False

-- Create an allocation via the factory under `party`'s authority.
mkAlloc
  : ContractId V2.AllocationFactory -> Party -> V2.SettlementInfo
  -> V2.AllocationSpecification -> [ContractId V2.Holding] -> Time
  -> Script (ContractId V2.Allocation)
mkAlloc factoryCid party settlement spec inputHoldingCids requestedAt = do
  res <- submit party $ exerciseCmd factoryCid V2.AllocationFactory_Allocate with
    settlement; allocation = spec; requestedAt; inputHoldingCids
    actors = [party]; extraArgs = emptyExtraArgs
  case res.output of
    V2.AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "allocation must complete"

-- Build a plain allocation spec: who administers it, who authorizes it, the
-- transfer legs it moves, and whether it is already committed.
mkSpec : Party -> V2.Account -> [V2.TransferLeg] -> Bool -> V2.AllocationSpecification
mkSpec admin authorizer legs committed = V2.AllocationSpecification with
  admin; authorizer
  transferLegSides = Utils.legsToSides authorizer legs
  settlementDeadline = None; nextIterationFunding = None; committed
  meta = emptyMetadata

-- Like `mkSpec` but carries a settlement deadline on the allocation, so
-- the on-ledger expiry invariant (`enforceAllocationDeadline`) has a
-- source to check against.
mkSpecDeadline : Party -> V2.Account -> [V2.TransferLeg] -> Bool -> Time -> V2.AllocationSpecification
mkSpecDeadline admin authorizer legs committed deadline =
  (mkSpec admin authorizer legs committed) with settlementDeadline = Some deadline

-- The add flow's deposit specs are iterated-enabled, so the settle can attach
-- the off-ratio refund leg.
depositSpec : Party -> V2.Account -> V2.TransferLeg -> V2.AllocationSpecification
depositSpec admin authorizer leg =
  (mkSpec admin authorizer [leg] True) with nextIterationFunding = Some TextMap.empty

-- Operator creates the directional LiquidityAllocationRequest the LP/holder
-- accepts; each settle is bound to that request. The choice builds the canonical
-- specs on-ledger from these scalars; the tests author matching allocations
-- via their local `mkSpec` (byte-identical, since admin == lpRegistrar ==
-- registry here).
requestAdd
  : Fixture -> Party -> Decimal -> Decimal -> Decimal -> Optional Time -> Time
  -> Script (ContractId LAR.LiquidityAllocationRequest)
requestAdd fx recipient baseAmount quoteAmount lpAmount settleAt now =
  submit fx.operator $ exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_RequestAddLiquidity with
    poolCid = fx.poolCid; recipient; baseAmount; quoteAmount; lpAmount
    requestedAt = now; settleAt

-- The remove-side counterpart of `requestAdd`: the operator posts the request
-- naming the base/quote amounts to return and how much LP to burn.
requestRemove
  : Fixture -> Party -> [Decimal] -> [Decimal] -> Decimal -> Optional Time -> Time
  -> Script (ContractId LAR.LiquidityAllocationRequest)
requestRemove fx holder baseOuts quoteOuts lpBurnAmount settleAt now =
  submit fx.operator $ exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_RequestRemoveLiquidity with
    poolCid = fx.poolCid; holder; baseOuts; quoteOuts; lpBurnAmount
    requestedAt = now; settleAt

-- Complete one allocation returned by a PoolLiquidityRules preview. The
-- fixture uses one Registry.V2 for both asset and LP-token operations.
completePlannedAllocation
  : Fixture -> Party -> V2.AllocationFactory_Allocate
  -> Script (ContractId V2.Allocation)
completePlannedAllocation fx actor allocationArg = do
  result <- submit actor $ exerciseCmd fx.factoryCid allocationArg
  case result.output of
    V2.AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "planned allocation must complete"

settlePreparedAdd
  : Fixture -> Dvp.AddLiquidityPreparationArgs -> Time
  -> Script Dvp.PoolLiquidityRules_SettleAddResult
settlePreparedAdd fx preparation requestedAt = do
  allocationPlan <- submit (actAs [fx.operator, fx.registry]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_PreviewAddAllocations with
      preparation
      requestedAt
  operatorBaseReceiverCid <-
    completePlannedAllocation fx fx.operator allocationPlan.baseReceiver
  operatorQuoteReceiverCid <-
    completePlannedAllocation fx fx.operator allocationPlan.quoteReceiver
  registrarMintCid <-
    completePlannedAllocation fx fx.registry allocationPlan.lpMintSender
  _settlementPlan <- submit (actAs [fx.operator, fx.registry]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_PreviewAddSettlement with
      preparation
      operatorBaseReceiverCid
      operatorQuoteReceiverCid
      registrarMintCid
  submit (actAs [fx.operator, fx.registry]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_SettleAddLiquidity with
      expectedPoolId = preparation.expectedPoolId
      poolCid = preparation.poolCid
      poolStateCid = preparation.poolStateCid
      lpPolicyCid = preparation.lpPolicyCid
      requestCid = preparation.requestCid
      acceptanceCid = preparation.acceptanceCid
      recipient = preparation.recipient
      lpBaseDepositCid = preparation.lpBaseDepositCid
      lpQuoteDepositCid = preparation.lpQuoteDepositCid
      lpReceiptCid = preparation.lpReceiptCid
      baseFactoryCid = fx.factoryCid
      quoteFactoryCid = fx.factoryCid
      lpFactoryCid = fx.factoryCid
      baseAmount = preparation.baseAmount
      quoteAmount = preparation.quoteAmount
      minLpTokens = preparation.minLpTokens
      knownTotalLpSupply = preparation.knownTotalLpSupply
      requestedAt
      batchesByAdmin = singleAdminBatches fx emptyExtraArgs
      operatorBaseReceiverCid = Some operatorBaseReceiverCid
      operatorQuoteReceiverCid = Some operatorQuoteReceiverCid
      registrarMintCid = Some registrarMintCid
      allocationContextByAdmin = Map.empty

-- Exercise the settle without the optional staged-allocation cids: the choice
-- authors those allocations through the factory fields, each with its admin's
-- context from `batchesByAdmin`.
settlePreparedAddLegacy
  : Fixture -> Dvp.AddLiquidityPreparationArgs -> Time
  -> Script Dvp.PoolLiquidityRules_SettleAddResult
settlePreparedAddLegacy fx preparation requestedAt =
  submit (actAs [fx.operator, fx.registry]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_SettleAddLiquidity with
      expectedPoolId = preparation.expectedPoolId
      poolCid = preparation.poolCid
      poolStateCid = preparation.poolStateCid
      lpPolicyCid = preparation.lpPolicyCid
      requestCid = preparation.requestCid
      acceptanceCid = preparation.acceptanceCid
      recipient = preparation.recipient
      lpBaseDepositCid = preparation.lpBaseDepositCid
      lpQuoteDepositCid = preparation.lpQuoteDepositCid
      lpReceiptCid = preparation.lpReceiptCid
      baseFactoryCid = fx.factoryCid
      quoteFactoryCid = fx.factoryCid
      lpFactoryCid = fx.factoryCid
      baseAmount = preparation.baseAmount
      quoteAmount = preparation.quoteAmount
      minLpTokens = preparation.minLpTokens
      knownTotalLpSupply = preparation.knownTotalLpSupply
      requestedAt
      batchesByAdmin = singleAdminBatches fx emptyExtraArgs
      operatorBaseReceiverCid = None
      operatorQuoteReceiverCid = None
      registrarMintCid = None
      -- The in-choice authoring path uses a per-admin allocation-factory context,
      -- distinct from the settlement context in `batchesByAdmin`.
      allocationContextByAdmin = Map.fromList [(fx.registry, emptyExtraArgs)]

settlePreparedRemove
  : Fixture -> Dvp.RemoveLiquidityPreparationArgs -> Time
  -> Script Dvp.PoolLiquidityRules_SettleRemoveResult
settlePreparedRemove fx preparation requestedAt = do
  allocationPlan <- submit (actAs [fx.operator, fx.registry]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_PreviewRemoveAllocations with
      preparation
      requestedAt
  registrarBurnReceiverCid <-
    completePlannedAllocation fx fx.registry allocationPlan.lpBurnReceiver
  _settlementPlan <- submit (actAs [fx.operator, fx.registry]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_PreviewRemoveSettlement with
      preparation
      registrarBurnReceiverCid
  submit (actAs [fx.operator, fx.registry]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_SettleRemoveLiquidity with
      expectedPoolId = preparation.expectedPoolId
      poolCid = preparation.poolCid
      poolStateCid = preparation.poolStateCid
      lpPolicyCid = preparation.lpPolicyCid
      requestCid = preparation.requestCid
      acceptanceCid = preparation.acceptanceCid
      holder = preparation.holder
      lpTokensToRedeem = preparation.lpTokensToRedeem
      knownTotalLpSupply = preparation.knownTotalLpSupply
      minBaseOut = preparation.minBaseOut
      minQuoteOut = preparation.minQuoteOut
      baseSliceCids = preparation.baseSliceCids
      quoteSliceCids = preparation.quoteSliceCids
      holderBaseReceiptCid = preparation.holderBaseReceiptCid
      holderQuoteReceiptCid = preparation.holderQuoteReceiptCid
      holderBurnSenderCid = preparation.holderBurnSenderCid
      lpFactoryCid = fx.factoryCid
      requestedAt
      batchesByAdmin = singleAdminBatches fx emptyExtraArgs
      registrarBurnReceiverCid = Some registrarBurnReceiverCid
      allocationContextByAdmin = Map.empty

settlePreparedRemoveLegacy
  : Fixture -> Dvp.RemoveLiquidityPreparationArgs -> Time
  -> Script Dvp.PoolLiquidityRules_SettleRemoveResult
settlePreparedRemoveLegacy fx preparation requestedAt =
  submit (actAs [fx.operator, fx.registry]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_SettleRemoveLiquidity with
      expectedPoolId = preparation.expectedPoolId
      poolCid = preparation.poolCid
      poolStateCid = preparation.poolStateCid
      lpPolicyCid = preparation.lpPolicyCid
      requestCid = preparation.requestCid
      acceptanceCid = preparation.acceptanceCid
      holder = preparation.holder
      lpTokensToRedeem = preparation.lpTokensToRedeem
      knownTotalLpSupply = preparation.knownTotalLpSupply
      minBaseOut = preparation.minBaseOut
      minQuoteOut = preparation.minQuoteOut
      baseSliceCids = preparation.baseSliceCids
      quoteSliceCids = preparation.quoteSliceCids
      holderBaseReceiptCid = preparation.holderBaseReceiptCid
      holderQuoteReceiptCid = preparation.holderQuoteReceiptCid
      holderBurnSenderCid = preparation.holderBurnSenderCid
      lpFactoryCid = fx.factoryCid
      requestedAt
      batchesByAdmin = singleAdminBatches fx emptyExtraArgs
      registrarBurnReceiverCid = None
      -- Fallback authoring uses a per-admin allocation-factory context, distinct
      -- from the settlement context in `batchesByAdmin`.
      allocationContextByAdmin = Map.fromList [(fx.registry, emptyExtraArgs)]

-- Drive a DvP add of `baseAmount` BTC + `quoteAmount` USDC by `lp`,
-- returning the settle result. Builds the LP's deposit + receipt
-- allocations matching the legs PoolLiquidityRules settles.
dvpAdd
  : Fixture -> ContractId PS.PoolState -> ContractId LP.LPTokenPolicy -> Party
  -> Decimal -> Decimal -> Decimal -> Decimal -> Decimal -> Time
  -> Script Dvp.PoolLiquidityRules_SettleAddResult
dvpAdd fx stateCid policyCid lp baseAmount quoteAmount knownSupply reserveBase reserveQuote now = do
  let lpAcct = Utils.basicAccount lp
      opAcct = Utils.basicAccount fx.operator
      settlement = PM.poolSettlement fx.poolCid fx.operator
      baseDepositLeg = V2.TransferLeg with
        transferLegId = "lp-base-deposit"; sender = lpAcct; receiver = opAcct
        amount = baseAmount; instrumentId = "BTC"; meta = emptyMetadata
      quoteDepositLeg = V2.TransferLeg with
        transferLegId = "lp-quote-deposit"; sender = lpAcct; receiver = opAcct
        amount = quoteAmount; instrumentId = "USDC"; meta = emptyMetadata
      -- Mirror PoolLiquidityRules' mint computation so the receipt leg matches.
      lpAmount =
        if knownSupply == 0.0 then PM.sqrtDecimal (baseAmount * quoteAmount)
        else min ((baseAmount * knownSupply) / reserveBase)
                 ((quoteAmount * knownSupply) / reserveQuote)
      lpMintLeg = Lp.lpMintLeg lpAcct lpId lpAmount
      baseSpec = depositSpec fx.registry lpAcct baseDepositLeg
      quoteSpec = depositSpec fx.registry lpAcct quoteDepositLeg
      receiptSpec = mkSpec fx.registry lpAcct [lpMintLeg] False
  baseHold <- mintHolding fx.registry lp "BTC" baseAmount
  quoteHold <- mintHolding fx.registry lp "USDC" quoteAmount
  reqCid <- requestAdd fx lp baseAmount quoteAmount lpAmount None now
  lpBaseDeposit <- mkAlloc fx.factoryCid lp settlement baseSpec [toInterfaceContractId baseHold] now
  lpQuoteDeposit <- mkAlloc fx.factoryCid lp settlement quoteSpec [toInterfaceContractId quoteHold] now
  lpReceipt <- mkAlloc fx.factoryCid lp settlement receiptSpec [] now
  let preparation = Dvp.AddLiquidityPreparationArgs with
        expectedPoolId = fx.poolId; poolCid = fx.poolCid; poolStateCid = stateCid
        lpPolicyCid = policyCid; requestCid = Some reqCid; acceptanceCid = None
        recipient = lp
        lpBaseDepositCid = lpBaseDeposit; lpQuoteDepositCid = lpQuoteDeposit
        lpReceiptCid = lpReceipt
        baseAmount; quoteAmount; minLpTokens = 0.0
        knownTotalLpSupply = knownSupply
  settlePreparedAddLegacy fx preparation now

-- First-funding add with an explicit receipt amount, allowing a test to place
-- the requested mint immediately above or below the symmetric dust bound.
dvpAddWithLp
  : Fixture -> ContractId PS.PoolState -> ContractId LP.LPTokenPolicy -> Party
  -> Decimal -> Decimal -> Decimal -> Time
  -> Script Dvp.PoolLiquidityRules_SettleAddResult
dvpAddWithLp fx stateCid policyCid lp baseAmount quoteAmount lpAmount now = do
  let lpAcct = Utils.basicAccount lp
      opAcct = Utils.basicAccount fx.operator
      settlement = PM.poolSettlement fx.poolCid fx.operator
      baseDepositLeg = V2.TransferLeg with
        transferLegId = "lp-base-deposit"; sender = lpAcct; receiver = opAcct
        amount = baseAmount; instrumentId = "BTC"; meta = emptyMetadata
      quoteDepositLeg = V2.TransferLeg with
        transferLegId = "lp-quote-deposit"; sender = lpAcct; receiver = opAcct
        amount = quoteAmount; instrumentId = "USDC"; meta = emptyMetadata
      lpMintLeg = Lp.lpMintLeg lpAcct lpId lpAmount
      baseSpec = depositSpec fx.registry lpAcct baseDepositLeg
      quoteSpec = depositSpec fx.registry lpAcct quoteDepositLeg
      receiptSpec = mkSpec fx.registry lpAcct [lpMintLeg] False
  baseHold <- mintHolding fx.registry lp "BTC" baseAmount
  quoteHold <- mintHolding fx.registry lp "USDC" quoteAmount
  reqCid <- requestAdd fx lp baseAmount quoteAmount lpAmount None now
  lpBaseDeposit <- mkAlloc fx.factoryCid lp settlement baseSpec [toInterfaceContractId baseHold] now
  lpQuoteDeposit <- mkAlloc fx.factoryCid lp settlement quoteSpec [toInterfaceContractId quoteHold] now
  lpReceipt <- mkAlloc fx.factoryCid lp settlement receiptSpec [] now
  let preparation = Dvp.AddLiquidityPreparationArgs with
        expectedPoolId = fx.poolId; poolCid = fx.poolCid; poolStateCid = stateCid
        lpPolicyCid = policyCid; requestCid = Some reqCid; acceptanceCid = None
        recipient = lp
        lpBaseDepositCid = lpBaseDeposit; lpQuoteDepositCid = lpQuoteDeposit
        lpReceiptCid = lpReceipt
        baseAmount; quoteAmount; minLpTokens = 0.0; knownTotalLpSupply = 0.0
  settlePreparedAdd fx preparation now

-- Happy path: a first add funds an empty pool and mints LP tokens to the
-- provider, all in one atomic settlement. Asserts the pool turns Active with the
-- deposited reserves and a matching LP supply, that the operator's two reserve
-- slices are recorded, and that Alice ends up holding the freshly minted LP token.
-- | Proves add-liquidity atomically deposits both assets and mints LP holdings.
testDvpAddLiquidity : Script ()
testDvpAddLiquidity = do
  alice <- allocateParty "alice"
  fx <- setup [alice]
  now <- getTime
  res <- dvpAdd fx fx.stateCid fx.policyCid alice 10.0 200000.0 0.0 0.0 0.0 now

  -- Reserves + supply set; status Active; two operator-authored slices.
  Some state <- queryContractId fx.operator res.poolStateCid
  state.status === PS_Active
  state.reserves.baseAmount === 10.0
  state.reserves.quoteAmount === 200000.0
  let expectedLp = PM.sqrtDecimal 2000000.0
  state.totalLpSupply === expectedLp
  res.lpTokensMinted === expectedLp
  Some baseSlice <- queryContractId fx.operator res.baseSliceCid
  Some quoteSlice <- queryContractId fx.operator res.quoteSliceCid
  baseSlice.operator === fx.operator
  baseSlice.amount === 10.0
  quoteSlice.amount === 200000.0

  -- Alice received the freshly-minted LP holding (DvP).
  aliceHoldings <- query @RegV2.Holding alice
  let lpHoldings = filter (\(_, h) -> h.instrumentId == lpId && h.owner == alice && not h.locked) aliceHoldings
  length lpHoldings === 1
  (snd (head lpHoldings)).amount === expectedLp

  -- Policy supply changes and reserve-slice records must represent real,
  -- positive value. Failed submissions leave the live policy untouched.
  submitMustFail fx.registry $ exerciseCmd res.lpPolicyCid LP.LPTokenPolicy_RecordMint with
    amount = 0.0
  submitMustFail fx.registry $ exerciseCmd res.lpPolicyCid LP.LPTokenPolicy_RecordBurn with
    amount = expectedLp + 0.0000000001
  submitMustFail fx.operator $ createCmd Slice.PoolSlice with
    poolId = fx.poolId
    operator = fx.operator
    side = BaseSide
    instrumentId = baseSlice.instrumentId
    allocationCid = baseSlice.allocationCid
    amount = 0.0
  pure ()

-- Off-ratio add: LP tokens are minted against the limiting side, so the
-- unmatched remainder of the other leg must NOT reach the reserves — it is
-- refunded to the provider in the same settlement.
-- | Proves an off-ratio deposit refunds excess instead of donating it.
testDvpAddOffRatioRefundsExcess : Script ()
testDvpAddOffRatioRefundsExcess = do
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  carol <- allocateParty "carol"
  fx <- setup [alice, bob, carol]
  now <- getTime
  addRes <- dvpAdd fx fx.stateCid fx.policyCid alice 10.0 200000.0 0.0 0.0 0.0 now
  let supply = PM.sqrtDecimal 2000000.0
  -- Bob deposits 5 BTC + 150000 USDC into a 10 : 200000 pool. Base is the
  -- limiting side: 5 BTC matches 100000 USDC, leaving 50000 USDC unmatched.
  res <- dvpAdd fx addRes.poolStateCid addRes.lpPolicyCid bob 5.0 150000.0 supply 10.0 200000.0 now

  res.baseAdded === Some 5.0
  res.quoteAdded === Some 100000.0
  -- Minted against the limiting side only; the excess quote bought nothing.
  res.lpTokensMinted === (5.0 * supply) / 10.0
  assertMsg "excess quote must not buy LP tokens"
    (res.lpTokensMinted < (150000.0 * supply) / 200000.0)

  Some state <- queryContractId fx.operator res.poolStateCid
  state.reserves.baseAmount === 15.0
  state.reserves.quoteAmount === 300000.0
  state.totalLpSupply === supply + res.lpTokensMinted
  Some baseSlice <- queryContractId fx.operator res.baseSliceCid
  Some quoteSlice <- queryContractId fx.operator res.quoteSliceCid
  baseSlice.amount === 5.0
  quoteSlice.amount === 100000.0

  -- Bob holds the unmatched quote, unlocked; his base went in whole.
  bobHoldings <- query @RegV2.Holding bob
  let bobUnlocked instrumentId =
        [ h.amount | (_, h) <- bobHoldings, h.instrumentId == instrumentId, not h.locked ]
  bobUnlocked "USDC" === [50000.0]
  bobUnlocked "BTC" === []

  -- The same holds with the sides swapped: carol is long base against the
  -- 15 : 300000 pool, so 2.5 of her 10 BTC come back.
  let supply2 = state.totalLpSupply
  res2 <- dvpAdd fx res.poolStateCid res.lpPolicyCid carol 10.0 150000.0 supply2 15.0 300000.0 now
  res2.baseAdded === Some 7.5
  res2.quoteAdded === Some 150000.0
  res2.lpTokensMinted === (150000.0 * supply2) / 300000.0
  Some state2 <- queryContractId fx.operator res2.poolStateCid
  state2.reserves.baseAmount === 22.5
  state2.reserves.quoteAmount === 450000.0
  carolHoldings <- query @RegV2.Holding carol
  let carolUnlocked instrumentId =
        [ h.amount | (_, h) <- carolHoldings, h.instrumentId == instrumentId, not h.locked ]
  carolUnlocked "BTC" === [2.5]
  carolUnlocked "USDC" === []
  pure ()

-- Partial redemption: the holder receives a pro-rata share of both reserves,
-- the redeemed LP amount burns, and the unredeemed LP balance stays unlocked.
-- | Proves remove-liquidity pays the holder and burns only redeemed LP tokens.
testDvpRemoveDeliversToHolder : Script ()
testDvpRemoveDeliversToHolder = do
  alice <- allocateParty "alice"
  fx <- setup [alice]
  now <- getTime
  addRes <- dvpAdd fx fx.stateCid fx.policyCid alice 10.0 1000.0 0.0 0.0 0.0 now
  let lpAmount = 100.0
      lpToRedeem = 40.0
      aliceAcct = Utils.basicAccount alice
      opAcct = Utils.basicAccount fx.operator
      settlement = PM.poolSettlement fx.poolCid fx.operator
      baseOutLeg = V2.TransferLeg with
        transferLegId = "lp-base-out-0"; sender = opAcct; receiver = aliceAcct
        amount = 4.0; instrumentId = "BTC"; meta = emptyMetadata
      quoteOutLeg = V2.TransferLeg with
        transferLegId = "lp-quote-out-0"; sender = opAcct; receiver = aliceAcct
        amount = 400.0; instrumentId = "USDC"; meta = emptyMetadata
      burnLeg = Lp.lpBurnLeg aliceAcct lpId lpToRedeem

  aliceHs <- query @RegV2.Holding alice
  let (lpHoldCid, _) = head (filter (\(_, h) -> h.instrumentId == lpId && not h.locked) aliceHs)

  let baseReceiptSpec = mkSpec fx.registry aliceAcct [baseOutLeg] False
      quoteReceiptSpec = mkSpec fx.registry aliceAcct [quoteOutLeg] False
      burnSpec = mkSpec fx.registry aliceAcct [burnLeg] True
  reqCid <- requestRemove fx alice [4.0] [400.0] lpToRedeem None now
  baseReceipt <- mkAlloc fx.factoryCid alice settlement baseReceiptSpec [] now
  quoteReceipt <- mkAlloc fx.factoryCid alice settlement quoteReceiptSpec [] now
  burnSender <- mkAlloc fx.factoryCid alice settlement burnSpec [toInterfaceContractId lpHoldCid] now

  let preparation = Dvp.RemoveLiquidityPreparationArgs with
        expectedPoolId = fx.poolId; poolCid = fx.poolCid
        poolStateCid = addRes.poolStateCid; lpPolicyCid = addRes.lpPolicyCid
        requestCid = Some reqCid; acceptanceCid = None
        holder = alice; lpTokensToRedeem = lpToRedeem; knownTotalLpSupply = lpAmount
        minBaseOut = 0.0; minQuoteOut = 0.0
        baseSliceCids = [addRes.baseSliceCid]; quoteSliceCids = [addRes.quoteSliceCid]
        holderBaseReceiptCid = baseReceipt; holderQuoteReceiptCid = quoteReceipt
        holderBurnSenderCid = burnSender
  remRes <- settlePreparedRemoveLegacy fx preparation now

  -- Reserves, slices, and LP supply all retain the same 60% remainder.
  Some state <- queryContractId fx.operator remRes.poolStateCid
  state.reserves.baseAmount === 6.0
  state.reserves.quoteAmount === 600.0
  state.totalLpSupply === 60.0
  state.status === PS_Active
  remRes.baseReturned === 4.0
  remRes.quoteReturned === 400.0
  Some baseSliceCid <- pure remRes.boundaryBaseSliceCid
  Some quoteSliceCid <- pure remRes.boundaryQuoteSliceCid
  Some baseSlice <- queryContractId fx.operator baseSliceCid
  Some quoteSlice <- queryContractId fx.operator quoteSliceCid
  baseSlice.amount === 6.0
  quoteSlice.amount === 600.0
  after <- query @RegV2.Holding alice
  let lpLeft = filter (\(_, h) -> h.instrumentId == lpId && h.owner == alice && not h.locked) after
      btcOut = filter (\(_, h) -> h.instrumentId == "BTC" && h.owner == alice && not h.locked) after
      usdcOut = filter (\(_, h) -> h.instrumentId == "USDC" && h.owner == alice && not h.locked) after
  [h.amount | (_, h) <- lpLeft] === [60.0]
  assertMsg "alice received BTC back" (any (\(_, h) -> h.amount == 4.0) btcOut)
  assertMsg "alice received USDC back" (any (\(_, h) -> h.amount == 400.0) usdcOut)
  pure ()

-- The settle re-checks the quote against current state: a knownTotalLpSupply
-- that disagrees with PoolState aborts.
-- | Proves settlement rejects a liquidity quote built from stale PoolState.
testStaleQuoteRejected : Script ()
testStaleQuoteRejected = do
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  fx <- setup [alice, bob]
  now <- getTime
  addRes <- dvpAdd fx fx.stateCid fx.policyCid alice 10.0 200000.0 0.0 0.0 0.0 now
  -- bob attempts an add quoting a stale supply (0.0) while the pool is
  -- now funded — the stale-quote assert must fail.
  let bobAcct = Utils.basicAccount bob
      opAcct = Utils.basicAccount fx.operator
      settlement = PM.poolSettlement fx.poolCid fx.operator
      baseDepositLeg = V2.TransferLeg with
        transferLegId = "lp-base-deposit"; sender = bobAcct; receiver = opAcct
        amount = 1.0; instrumentId = "BTC"; meta = emptyMetadata
      quoteDepositLeg = V2.TransferLeg with
        transferLegId = "lp-quote-deposit"; sender = bobAcct; receiver = opAcct
        amount = 20000.0; instrumentId = "USDC"; meta = emptyMetadata
      lpMintLeg = Lp.lpMintLeg bobAcct lpId 100.0
      bBaseSpec = depositSpec fx.registry bobAcct baseDepositLeg
      bQuoteSpec = depositSpec fx.registry bobAcct quoteDepositLeg
      bRcptSpec = mkSpec fx.registry bobAcct [lpMintLeg] False
  -- Fund Bob and build his standard add allocations (two deposits + a mint
  -- receipt); everything is well-formed here, only the quoted supply is stale.
  bBtc <- mintHolding fx.registry bob "BTC" 1.0
  bUsdc <- mintHolding fx.registry bob "USDC" 20000.0
  bReq <- requestAdd fx bob 1.0 20000.0 100.0 None now
  bBase <- mkAlloc fx.factoryCid bob settlement bBaseSpec [toInterfaceContractId bBtc] now
  bQuote <- mkAlloc fx.factoryCid bob settlement bQuoteSpec [toInterfaceContractId bUsdc] now
  bRcpt <- mkAlloc fx.factoryCid bob settlement bRcptSpec [] now
  let preparation = Dvp.AddLiquidityPreparationArgs with
        expectedPoolId = fx.poolId; poolCid = fx.poolCid
        poolStateCid = addRes.poolStateCid; lpPolicyCid = addRes.lpPolicyCid
        requestCid = Some bReq; acceptanceCid = None; recipient = bob
        lpBaseDepositCid = bBase; lpQuoteDepositCid = bQuote; lpReceiptCid = bRcpt
        baseAmount = 1.0; quoteAmount = 20000.0; minLpTokens = 0.0
        knownTotalLpSupply = 0.0   -- STALE: pool is funded now
  submitMustFail (actAs [fx.operator, fx.registry]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_PreviewAddAllocations with
      preparation
      requestedAt = now
  pure ()

-- The settle choices are co-controlled (operator, lpRegistrar): the
-- operator alone cannot drive them.
-- | Proves both operator and LP registrar must authorize liquidity settlement.
testSettleRequiresCoControl : Script ()
testSettleRequiresCoControl = do
  alice <- allocateParty "alice"
  fx <- setup [alice]
  now <- getTime
  addRes <- dvpAdd fx fx.stateCid fx.policyCid alice 10.0 200000.0 0.0 0.0 0.0 now
  let preparation = Dvp.RemoveLiquidityPreparationArgs with
        expectedPoolId = fx.poolId; poolCid = fx.poolCid
        poolStateCid = addRes.poolStateCid; lpPolicyCid = addRes.lpPolicyCid
        requestCid = Some (coerceContractId addRes.baseSliceCid); acceptanceCid = None
        holder = alice; lpTokensToRedeem = PM.sqrtDecimal 2000000.0
        knownTotalLpSupply = PM.sqrtDecimal 2000000.0
        minBaseOut = 0.0; minQuoteOut = 0.0
        baseSliceCids = [addRes.baseSliceCid]; quoteSliceCids = [addRes.quoteSliceCid]
        holderBaseReceiptCid = coerceContractId addRes.baseSliceCid
        holderQuoteReceiptCid = coerceContractId addRes.baseSliceCid
        holderBurnSenderCid = coerceContractId addRes.baseSliceCid
  -- Operator alone (no lpRegistrar) cannot settle a remove.
  submitMustFail fx.operator $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_SettleRemoveLiquidity with
      expectedPoolId = preparation.expectedPoolId
      poolCid = preparation.poolCid
      poolStateCid = preparation.poolStateCid
      lpPolicyCid = preparation.lpPolicyCid
      requestCid = preparation.requestCid
      acceptanceCid = preparation.acceptanceCid
      holder = preparation.holder
      lpTokensToRedeem = preparation.lpTokensToRedeem
      knownTotalLpSupply = preparation.knownTotalLpSupply
      minBaseOut = preparation.minBaseOut
      minQuoteOut = preparation.minQuoteOut
      baseSliceCids = preparation.baseSliceCids
      quoteSliceCids = preparation.quoteSliceCids
      holderBaseReceiptCid = preparation.holderBaseReceiptCid
      holderQuoteReceiptCid = preparation.holderQuoteReceiptCid
      holderBurnSenderCid = preparation.holderBurnSenderCid
      lpFactoryCid = fx.factoryCid
      requestedAt = now
      batchesByAdmin = singleAdminBatches fx emptyExtraArgs
      registrarBurnReceiverCid = Some (coerceContractId addRes.baseSliceCid)
      allocationContextByAdmin = Map.empty
  pure ()

-- Multi-slice remove: two adds create two slices per side; a full
-- redemption draws across BOTH (per-slice delivery legs), proving the
-- ordered covering-prefix draw rather than a single-slice-only path.
-- | Proves a withdrawal can draw an ordered prefix of multiple reserve slices.
testDvpMultiSliceRemove : Script ()
testDvpMultiSliceRemove = do
  alice <- allocateParty "alice"
  fx <- setup [alice]
  now <- getTime
  add1 <- dvpAdd fx fx.stateCid fx.policyCid alice 10.0 200000.0 0.0 0.0 0.0 now
  let lp1 = PM.sqrtDecimal 2000000.0
  add2 <- dvpAdd fx add1.poolStateCid add1.lpPolicyCid alice 5.0 100000.0 lp1 10.0 200000.0 now
  let lp2 = min (5.0 * lp1 / 10.0) (100000.0 * lp1 / 200000.0)
      total = lp1 + lp2
      aliceAcct = Utils.basicAccount alice
      opAcct = Utils.basicAccount fx.operator
      settlement = PM.poolSettlement fx.poolCid fx.operator
      -- Two delivery legs per side (one per sourced slice).
      bLeg0 = V2.TransferLeg with
        transferLegId = "lp-base-out-0"; sender = opAcct; receiver = aliceAcct
        amount = 10.0; instrumentId = "BTC"; meta = emptyMetadata
      bLeg1 = V2.TransferLeg with
        transferLegId = "lp-base-out-1"; sender = opAcct; receiver = aliceAcct
        amount = 5.0; instrumentId = "BTC"; meta = emptyMetadata
      qLeg0 = V2.TransferLeg with
        transferLegId = "lp-quote-out-0"; sender = opAcct; receiver = aliceAcct
        amount = 200000.0; instrumentId = "USDC"; meta = emptyMetadata
      qLeg1 = V2.TransferLeg with
        transferLegId = "lp-quote-out-1"; sender = opAcct; receiver = aliceAcct
        amount = 100000.0; instrumentId = "USDC"; meta = emptyMetadata
      burnLeg = Lp.lpBurnLeg aliceAcct lpId total

  -- Alice's two LP holdings (both locked for the burn).
  aliceHs <- query @RegV2.Holding alice
  let lpCids = [cid | (cid, h) <- aliceHs, h.instrumentId == lpId && not h.locked]
  length lpCids === 2

  let baseReceiptSpec = mkSpec fx.registry aliceAcct [bLeg0, bLeg1] False
      quoteReceiptSpec = mkSpec fx.registry aliceAcct [qLeg0, qLeg1] False
      burnSpec = mkSpec fx.registry aliceAcct [burnLeg] True
  reqCid <- requestRemove fx alice [10.0, 5.0] [200000.0, 100000.0] total None now
  baseReceipt <- mkAlloc fx.factoryCid alice settlement baseReceiptSpec [] now
  quoteReceipt <- mkAlloc fx.factoryCid alice settlement quoteReceiptSpec [] now
  burnSender <- mkAlloc fx.factoryCid alice settlement burnSpec (map toInterfaceContractId lpCids) now

  let preparation = Dvp.RemoveLiquidityPreparationArgs with
        expectedPoolId = fx.poolId; poolCid = fx.poolCid
        poolStateCid = add2.poolStateCid; lpPolicyCid = add2.lpPolicyCid
        requestCid = Some reqCid; acceptanceCid = None
        holder = alice; lpTokensToRedeem = total; knownTotalLpSupply = total
        minBaseOut = 0.0; minQuoteOut = 0.0
        baseSliceCids = [add1.baseSliceCid, add2.baseSliceCid]
        quoteSliceCids = [add1.quoteSliceCid, add2.quoteSliceCid]
        holderBaseReceiptCid = baseReceipt; holderQuoteReceiptCid = quoteReceipt
        holderBurnSenderCid = burnSender
  remRes <- settlePreparedRemove fx preparation now

  -- Both slices per side consumed; pool drained; alice got it all back.
  remRes.baseReturned === 15.0
  remRes.quoteReturned === 300000.0
  Some state <- queryContractId fx.operator remRes.poolStateCid
  state.reserves.baseAmount === 0.0
  state.status === PS_Unfunded
  None <- queryContractId fx.operator add1.baseSliceCid
  None <- queryContractId fx.operator add2.baseSliceCid
  after <- query @RegV2.Holding alice
  let lpLeft = filter (\(_, h) -> h.instrumentId == lpId && h.owner == alice) after
  length lpLeft === 0
  pure ()

-- A non-admin cannot forge a mint allocation. The factory's
-- owner-None branch requires `admin `elem` actors`, and the choice is
-- `controller actors`, so a non-admin can't author one.
-- | Proves a non-admin cannot author the registry mint allocation.
testMintRequiresAdmin : Script ()
testMintRequiresAdmin = do
  mallory <- allocateParty "mallory"
  fx <- setup [mallory]
  now <- getTime
  let malloryAcct = Utils.basicAccount mallory
      settlement = PM.poolSettlement fx.poolCid fx.operator
      forgedMintLeg = Lp.lpMintLeg malloryAcct lpId 1000.0
      -- authorizer = the standard mint account; mallory tries to author it.
      forgedSpec = Lp.mintSenderSpec fx.registry forgedMintLeg
  submitMustFail mallory $ exerciseCmd fx.factoryCid V2.AllocationFactory_Allocate with
    settlement; allocation = forgedSpec; requestedAt = now
    inputHoldingCids = []; actors = [mallory]; extraArgs = emptyExtraArgs
  pure ()

-- The settle reads the deadline from the
-- LP's accepted allocation, NOT from a caller-supplied argument. An
-- allocation whose `settlementDeadline` is already in the past must be
-- rejected regardless of what the caller passes. This proves the expiry
-- check is bound to ledger state.
-- | Proves add-liquidity rejects a deposit allocation past its deadline.
testExpiredAddRejected : Script ()
testExpiredAddRejected = do
  alice <- allocateParty "alice"
  fx <- setup [alice]
  now <- getTime
  let pastDeadline = addRelTime now (hours (-1))
      aliceAcct = Utils.basicAccount alice
      opAcct = Utils.basicAccount fx.operator
      settlement = PM.poolSettlement fx.poolCid fx.operator
      baseDepositLeg = V2.TransferLeg with
        transferLegId = "lp-base-deposit"; sender = aliceAcct; receiver = opAcct
        amount = 10.0; instrumentId = "BTC"; meta = emptyMetadata
      quoteDepositLeg = V2.TransferLeg with
        transferLegId = "lp-quote-deposit"; sender = aliceAcct; receiver = opAcct
        amount = 200000.0; instrumentId = "USDC"; meta = emptyMetadata
      lpMintLeg = Lp.lpMintLeg aliceAcct lpId (PM.sqrtDecimal 2000000.0)
  baseHold <- mintHolding fx.registry alice "BTC" 10.0
  quoteHold <- mintHolding fx.registry alice "USDC" 200000.0
  -- The QUOTE-deposit allocation carries an already-expired deadline; the
  -- base deposit is fresh. The settle must still abort, proving every
  -- LP-authored allocation is deadline-checked, not just the base leg.
  let baseSpec = depositSpec fx.registry aliceAcct baseDepositLeg
      quoteSpec = (depositSpec fx.registry aliceAcct quoteDepositLeg) with
        settlementDeadline = Some pastDeadline
      receiptSpec = mkSpec fx.registry aliceAcct [lpMintLeg] False
  reqCid <- requestAdd fx alice 10.0 200000.0 (PM.sqrtDecimal 2000000.0) None now
  lpBaseDeposit <- mkAlloc fx.factoryCid alice settlement baseSpec [toInterfaceContractId baseHold] now
  lpQuoteDeposit <- mkAlloc fx.factoryCid alice settlement quoteSpec [toInterfaceContractId quoteHold] now
  lpReceipt <- mkAlloc fx.factoryCid alice settlement receiptSpec [] now
  let preparation = Dvp.AddLiquidityPreparationArgs with
        expectedPoolId = fx.poolId; poolCid = fx.poolCid; poolStateCid = fx.stateCid
        lpPolicyCid = fx.policyCid; requestCid = Some reqCid; acceptanceCid = None
        recipient = alice
        lpBaseDepositCid = lpBaseDeposit; lpQuoteDepositCid = lpQuoteDeposit
        lpReceiptCid = lpReceipt
        baseAmount = 10.0; quoteAmount = 200000.0; minLpTokens = 0.0
        knownTotalLpSupply = 0.0
  -- Even with a fresh `requestedAt`, the settle must abort on the expired
  -- ledger-anchored deadline.
  submitMustFail (actAs [fx.operator, fx.registry]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_PreviewAddAllocations with
      preparation
      requestedAt = now
  pure ()

-- Symmetric to the add case, on the remove side: a past deadline on a
-- holder receipt allocation (NOT the burn-sender) must still abort the
-- settle, proving all holder-authored allocations are deadline-checked.
-- | Proves remove-liquidity checks every holder-authored allocation deadline.
testExpiredRemoveRejected : Script ()
testExpiredRemoveRejected = do
  alice <- allocateParty "alice"
  fx <- setup [alice]
  now <- getTime
  addRes <- dvpAdd fx fx.stateCid fx.policyCid alice 10.0 200000.0 0.0 0.0 0.0 now
  let lpAmount = PM.sqrtDecimal 2000000.0
      pastDeadline = addRelTime now (hours (-1))
      aliceAcct = Utils.basicAccount alice
      opAcct = Utils.basicAccount fx.operator
      settlement = PM.poolSettlement fx.poolCid fx.operator
      baseOutLeg = V2.TransferLeg with
        transferLegId = "lp-base-out-0"; sender = opAcct; receiver = aliceAcct
        amount = 10.0; instrumentId = "BTC"; meta = emptyMetadata
      quoteOutLeg = V2.TransferLeg with
        transferLegId = "lp-quote-out-0"; sender = opAcct; receiver = aliceAcct
        amount = 200000.0; instrumentId = "USDC"; meta = emptyMetadata
      burnLeg = Lp.lpBurnLeg aliceAcct lpId lpAmount
  aliceHs <- query @RegV2.Holding alice
  let (lpHoldCid, _) = head (filter (\(_, h) -> h.instrumentId == lpId && not h.locked) aliceHs)
  -- The BASE-receipt allocation is expired; the burn-sender is fresh.
  let baseReceiptSpec = mkSpecDeadline fx.registry aliceAcct [baseOutLeg] False pastDeadline
      quoteReceiptSpec = mkSpec fx.registry aliceAcct [quoteOutLeg] False
      burnSpec = mkSpec fx.registry aliceAcct [burnLeg] True
  reqCid <- requestRemove fx alice [10.0] [200000.0] lpAmount None now
  baseReceipt <- mkAlloc fx.factoryCid alice settlement baseReceiptSpec [] now
  quoteReceipt <- mkAlloc fx.factoryCid alice settlement quoteReceiptSpec [] now
  burnSender <- mkAlloc fx.factoryCid alice settlement burnSpec [toInterfaceContractId lpHoldCid] now
  let preparation = Dvp.RemoveLiquidityPreparationArgs with
        expectedPoolId = fx.poolId; poolCid = fx.poolCid
        poolStateCid = addRes.poolStateCid; lpPolicyCid = addRes.lpPolicyCid
        requestCid = Some reqCid; acceptanceCid = None
        holder = alice; lpTokensToRedeem = lpAmount; knownTotalLpSupply = lpAmount
        minBaseOut = 0.0; minQuoteOut = 0.0
        baseSliceCids = [addRes.baseSliceCid]; quoteSliceCids = [addRes.quoteSliceCid]
        holderBaseReceiptCid = baseReceipt; holderQuoteReceiptCid = quoteReceipt
        holderBurnSenderCid = burnSender
  submitMustFail (actAs [fx.operator, fx.registry]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_PreviewRemoveAllocations with
      preparation
      requestedAt = now
  pure ()

-- A supplied allocation whose spec is not one
-- the accepted request named must be rejected — the operator cannot
-- substitute a different allocation shape than the LP authored.
-- | Proves settle cannot substitute an allocation from another request shape.
testSettleRejectsForeignAllocation : Script ()
testSettleRejectsForeignAllocation = do
  alice <- allocateParty "alice"
  fx <- setup [alice]
  now <- getTime
  let aliceAcct = Utils.basicAccount alice
      opAcct = Utils.basicAccount fx.operator
      settlement = PM.poolSettlement fx.poolCid fx.operator
      baseDepositLeg = V2.TransferLeg with
        transferLegId = "lp-base-deposit"; sender = aliceAcct; receiver = opAcct
        amount = 10.0; instrumentId = "BTC"; meta = emptyMetadata
      quoteDepositLeg = V2.TransferLeg with
        transferLegId = "lp-quote-deposit"; sender = aliceAcct; receiver = opAcct
        amount = 200000.0; instrumentId = "USDC"; meta = emptyMetadata
      lpMintLeg = Lp.lpMintLeg aliceAcct lpId (PM.sqrtDecimal 2000000.0)
      baseSpec = depositSpec fx.registry aliceAcct baseDepositLeg
      quoteSpec = depositSpec fx.registry aliceAcct quoteDepositLeg
      receiptSpec = mkSpec fx.registry aliceAcct [lpMintLeg] False
      forgedBaseLeg = baseDepositLeg with amount = 999.0
      forgedSpec = depositSpec fx.registry aliceAcct forgedBaseLeg
  baseHold <- mintHolding fx.registry alice "BTC" 999.0
  quoteHold <- mintHolding fx.registry alice "USDC" 200000.0
  reqCid <- requestAdd fx alice 10.0 200000.0 (PM.sqrtDecimal 2000000.0) None now
  lpBaseDeposit <- mkAlloc fx.factoryCid alice settlement forgedSpec [toInterfaceContractId baseHold] now
  lpQuoteDeposit <- mkAlloc fx.factoryCid alice settlement quoteSpec [toInterfaceContractId quoteHold] now
  lpReceipt <- mkAlloc fx.factoryCid alice settlement receiptSpec [] now
  let preparation = Dvp.AddLiquidityPreparationArgs with
        expectedPoolId = fx.poolId; poolCid = fx.poolCid; poolStateCid = fx.stateCid
        lpPolicyCid = fx.policyCid; requestCid = Some reqCid; acceptanceCid = None
        recipient = alice
        lpBaseDepositCid = lpBaseDeposit; lpQuoteDepositCid = lpQuoteDeposit
        lpReceiptCid = lpReceipt
        baseAmount = 10.0; quoteAmount = 200000.0; minLpTokens = 0.0
        knownTotalLpSupply = 0.0
  submitMustFail (actAs [fx.operator, fx.registry]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_PreviewAddAllocations with
      preparation
      requestedAt = now
  pure ()

-- The request's `settleAt` is the single
-- authoritative deadline. A request whose settleAt is already past must be
-- rejected even when every supplied allocation is itself fresh.
-- | Proves an expired liquidity request cannot settle with fresh allocations.
testSettleRejectsExpiredRequest : Script ()
testSettleRejectsExpiredRequest = do
  alice <- allocateParty "alice"
  fx <- setup [alice]
  now <- getTime
  let pastDeadline = addRelTime now (hours (-1))
      aliceAcct = Utils.basicAccount alice
      opAcct = Utils.basicAccount fx.operator
      settlement = PM.poolSettlement fx.poolCid fx.operator
      baseDepositLeg = V2.TransferLeg with
        transferLegId = "lp-base-deposit"; sender = aliceAcct; receiver = opAcct
        amount = 10.0; instrumentId = "BTC"; meta = emptyMetadata
      quoteDepositLeg = V2.TransferLeg with
        transferLegId = "lp-quote-deposit"; sender = aliceAcct; receiver = opAcct
        amount = 200000.0; instrumentId = "USDC"; meta = emptyMetadata
      lpMintLeg = Lp.lpMintLeg aliceAcct lpId (PM.sqrtDecimal 2000000.0)
      baseSpec = depositSpec fx.registry aliceAcct baseDepositLeg
      quoteSpec = depositSpec fx.registry aliceAcct quoteDepositLeg
      receiptSpec = mkSpec fx.registry aliceAcct [lpMintLeg] False
  baseHold <- mintHolding fx.registry alice "BTC" 10.0
  quoteHold <- mintHolding fx.registry alice "USDC" 200000.0
  reqCid <- requestAdd fx alice 10.0 200000.0 (PM.sqrtDecimal 2000000.0) (Some pastDeadline) now
  lpBaseDeposit <- mkAlloc fx.factoryCid alice settlement baseSpec [toInterfaceContractId baseHold] now
  lpQuoteDeposit <- mkAlloc fx.factoryCid alice settlement quoteSpec [toInterfaceContractId quoteHold] now
  lpReceipt <- mkAlloc fx.factoryCid alice settlement receiptSpec [] now
  let preparation = Dvp.AddLiquidityPreparationArgs with
        expectedPoolId = fx.poolId; poolCid = fx.poolCid; poolStateCid = fx.stateCid
        lpPolicyCid = fx.policyCid; requestCid = Some reqCid; acceptanceCid = None
        recipient = alice
        lpBaseDepositCid = lpBaseDeposit; lpQuoteDepositCid = lpQuoteDeposit
        lpReceiptCid = lpReceipt
        baseAmount = 10.0; quoteAmount = 200000.0; minLpTokens = 0.0
        knownTotalLpSupply = 0.0
  submitMustFail (actAs [fx.operator, fx.registry]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_PreviewAddAllocations with
      preparation
      requestedAt = now
  pure ()

-- The minted amount is read from the LP receipt but bounded: a receipt claiming
-- more than the on-ledger fair share is rejected to prevent dilution.
-- | Proves LP mint above the fair-share dust bound is rejected.
testAddRejectsOverMint : Script ()
testAddRejectsOverMint = do
  alice <- allocateParty "alice"
  fx <- setup [alice]
  now <- getTime
  let fairLp = PM.sqrtDecimal 2000000.0
      overLp = fairLp + 1.0   -- claims more than the fair first-funding share
      aliceAcct = Utils.basicAccount alice
      opAcct = Utils.basicAccount fx.operator
      settlement = PM.poolSettlement fx.poolCid fx.operator
      baseDepositLeg = V2.TransferLeg with
        transferLegId = "lp-base-deposit"; sender = aliceAcct; receiver = opAcct
        amount = 10.0; instrumentId = "BTC"; meta = emptyMetadata
      quoteDepositLeg = V2.TransferLeg with
        transferLegId = "lp-quote-deposit"; sender = aliceAcct; receiver = opAcct
        amount = 200000.0; instrumentId = "USDC"; meta = emptyMetadata
      lpMintLeg = Lp.lpMintLeg aliceAcct lpId overLp
      baseSpec = depositSpec fx.registry aliceAcct baseDepositLeg
      quoteSpec = depositSpec fx.registry aliceAcct quoteDepositLeg
      receiptSpec = mkSpec fx.registry aliceAcct [lpMintLeg] False
  baseHold <- mintHolding fx.registry alice "BTC" 10.0
  quoteHold <- mintHolding fx.registry alice "USDC" 200000.0
  reqCid <- requestAdd fx alice 10.0 200000.0 overLp None now
  lpBaseDeposit <- mkAlloc fx.factoryCid alice settlement baseSpec [toInterfaceContractId baseHold] now
  lpQuoteDeposit <- mkAlloc fx.factoryCid alice settlement quoteSpec [toInterfaceContractId quoteHold] now
  lpReceipt <- mkAlloc fx.factoryCid alice settlement receiptSpec [] now
  let preparation = Dvp.AddLiquidityPreparationArgs with
        expectedPoolId = fx.poolId; poolCid = fx.poolCid; poolStateCid = fx.stateCid
        lpPolicyCid = fx.policyCid; requestCid = Some reqCid; acceptanceCid = None
        recipient = alice
        lpBaseDepositCid = lpBaseDeposit; lpQuoteDepositCid = lpQuoteDeposit
        lpReceiptCid = lpReceipt
        baseAmount = 10.0; quoteAmount = 200000.0; minLpTokens = 0.0
        knownTotalLpSupply = 0.0
  submitMustFail (actAs [fx.operator, fx.registry]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_PreviewAddAllocations with
      preparation
      requestedAt = now
  pure ()

-- The over-mint bound is symmetric with the dust tolerance.
-- A receipt a hair (< dust) above the on-ledger fair share is ACCEPTED —
-- this is the cross-language sqrt rounding the bound defends, and a strict
-- `<= fairLp` would wrongly abort it.
-- | Proves conservative LP mint within the symmetric dust bound is accepted.
testAddAcceptsWithinDust : Script ()
testAddAcceptsWithinDust = do
  alice <- allocateParty "alice"
  fx <- setup [alice]
  now <- getTime
  let fairLp = PM.sqrtDecimal 2000000.0
      nearLp = fairLp + 0.0000005   -- half the 1e-6 dust tolerance, above fair
  res <- dvpAddWithLp fx fx.stateCid fx.policyCid alice 10.0 200000.0 nearLp now
  res.lpTokensMinted === nearLp
  Some state <- queryContractId fx.operator res.poolStateCid
  state.totalLpSupply === nearLp
  pure ()

-- TSv2 actor authorization: accept must check the actor list. The operator is
-- the request signatory (so it can see the request) but is NOT the targeted lp;
-- it must not be able to consume the request with its own actor list.
-- | Proves only the named LP can accept its liquidity allocation request.
testAcceptRejectsUnauthorizedActor : Script ()
testAcceptRejectsUnauthorizedActor = do
  alice <- allocateParty "alice"
  fx <- setup [alice]
  now <- getTime
  let lpAmount = PM.sqrtDecimal 2000000.0
  reqCid <- requestAdd fx alice 10.0 200000.0 lpAmount None now
  let reqIface = toInterfaceContractId @V2.AllocationRequest reqCid
  -- operator accepting with its own actor list → rejected.
  submitMustFail fx.operator $ exerciseCmd reqIface
    (V2.AllocationRequest_Accept with actors = [fx.operator]; extraArgs = emptyExtraArgs)
  -- alice supplying a non-lp actor list → rejected.
  submitMustFail alice $ exerciseCmd reqIface
    (V2.AllocationRequest_Accept with actors = [fx.operator]; extraArgs = emptyExtraArgs)
  pure ()

-- Canonical stock-wallet flow. The LP/holder calls the standard
-- `AllocationRequest_Accept`, which consumes the request but first leaves an
-- operator-visible `LiquidityAllocationAcceptance` receipt. The settle then
-- binds to that evidence (the live request is gone). Also asserts the two
-- failure modes: binding to the consumed request fails, and settling with no
-- binding at all fails.
-- | Proves acceptance evidence binds the request before successful settlement.
testAcceptCreatesEvidenceThenSettleSucceeds : Script ()
testAcceptCreatesEvidenceThenSettleSucceeds = do
  alice <- allocateParty "alice"
  fx <- setup [alice]
  now <- getTime
  let lpAmount = PM.sqrtDecimal 2000000.0
      lpAcct = Utils.basicAccount alice
      opAcct = Utils.basicAccount fx.operator
      settlement = PM.poolSettlement fx.poolCid fx.operator
      baseDepositLeg = V2.TransferLeg with
        transferLegId = "lp-base-deposit"; sender = lpAcct; receiver = opAcct
        amount = 10.0; instrumentId = "BTC"; meta = emptyMetadata
      quoteDepositLeg = V2.TransferLeg with
        transferLegId = "lp-quote-deposit"; sender = lpAcct; receiver = opAcct
        amount = 200000.0; instrumentId = "USDC"; meta = emptyMetadata
      lpMintLeg = Lp.lpMintLeg lpAcct lpId lpAmount
      baseSpec = depositSpec fx.registry lpAcct baseDepositLeg
      quoteSpec = depositSpec fx.registry lpAcct quoteDepositLeg
      receiptSpec = mkSpec fx.registry lpAcct [lpMintLeg] False
  baseHold <- mintHolding fx.registry alice "BTC" 10.0
  quoteHold <- mintHolding fx.registry alice "USDC" 200000.0
  reqCid <- requestAdd fx alice 10.0 200000.0 lpAmount None now
  lpBaseDeposit <- mkAlloc fx.factoryCid alice settlement baseSpec [toInterfaceContractId baseHold] now
  lpQuoteDeposit <- mkAlloc fx.factoryCid alice settlement quoteSpec [toInterfaceContractId quoteHold] now
  lpReceipt <- mkAlloc fx.factoryCid alice settlement receiptSpec [] now

  let preparation requestCid acceptanceCid = Dvp.AddLiquidityPreparationArgs with
        expectedPoolId = fx.poolId; poolCid = fx.poolCid; poolStateCid = fx.stateCid
        lpPolicyCid = fx.policyCid; requestCid; acceptanceCid; recipient = alice
        lpBaseDepositCid = lpBaseDeposit; lpQuoteDepositCid = lpQuoteDeposit
        lpReceiptCid = lpReceipt
        baseAmount = 10.0; quoteAmount = 200000.0; minLpTokens = 0.0
        knownTotalLpSupply = 0.0

  -- alice (the request observer) exercises the standard accept → consumes the
  -- request and leaves the acceptance evidence.
  _ <- submit alice $ exerciseCmd (toInterfaceContractId @V2.AllocationRequest reqCid)
    (V2.AllocationRequest_Accept with actors = [alice]; extraArgs = emptyExtraArgs)

  -- Settlement must reject a consumed request without acceptance evidence.
  submitMustFail (actAs [fx.operator, fx.registry]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_PreviewAddAllocations with
      preparation = preparation (Some reqCid) None
      requestedAt = now

  -- Settling with neither request nor evidence fails (no binding to validate
  -- against): proves the evidence is load-bearing, not optional.
  submitMustFail (actAs [fx.operator, fx.registry]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_PreviewAddAllocations with
      preparation = preparation None None
      requestedAt = now

  -- The operator discovers the acceptance evidence and settles against it.
  accs <- query @LAR.LiquidityAllocationAcceptance fx.operator
  accCid <- case accs of
    ((cid, _) :: _) -> pure cid
    [] -> abort "accept must leave acceptance evidence"
  res <- settlePreparedAdd fx (preparation None (Some accCid)) now
  res.lpTokensMinted === lpAmount
  -- The evidence is consumed by settle (cleanup); none left behind.
  remaining <- query @LAR.LiquidityAllocationAcceptance fx.operator
  remaining === []
  pure ()

-- One-command wallet flow via the standard batching utility (Splice 0.6.11):
-- the LP `createAndExercise`s `BatchingUtility_ExecuteBatch` carrying the
-- request accept plus all three `AllocationFactory_Allocate` calls. Input
-- holdings are threaded through the utility's holding map: the registry locks
-- only the instruments each allocation needs and returns the rest via
-- `authorizerChangeCids` (the V2 batching contract), so the base allocate's
-- untouched USDC funds the quote allocate inside the same transaction. The
-- operator settle then binds to the acceptance receipt exactly as in the
-- stock accept flow.
-- | Proves the standard batching utility can accept and allocate in one action.
testBatchedUtilityAddLiquidity : Script ()
testBatchedUtilityAddLiquidity = do
  alice <- allocateParty "alice"
  fx <- setup [alice]
  now <- getTime
  let lpAmount = PM.sqrtDecimal 2000000.0
      lpAcct = Utils.basicAccount alice
      opAcct = Utils.basicAccount fx.operator
      settlement = PM.poolSettlement fx.poolCid fx.operator
      baseDepositLeg = V2.TransferLeg with
        transferLegId = "lp-base-deposit"; sender = lpAcct; receiver = opAcct
        amount = 10.0; instrumentId = "BTC"; meta = emptyMetadata
      quoteDepositLeg = V2.TransferLeg with
        transferLegId = "lp-quote-deposit"; sender = lpAcct; receiver = opAcct
        amount = 200000.0; instrumentId = "USDC"; meta = emptyMetadata
      lpMintLeg = Lp.lpMintLeg lpAcct lpId lpAmount
      baseSpec = depositSpec fx.registry lpAcct baseDepositLeg
      quoteSpec = depositSpec fx.registry lpAcct quoteDepositLeg
      receiptSpec = mkSpec fx.registry lpAcct [lpMintLeg] False
  baseHold <- mintHolding fx.registry alice "BTC" 10.0
  quoteHold <- mintHolding fx.registry alice "USDC" 200000.0
  reqCid <- requestAdd fx alice 10.0 200000.0 lpAmount None now

  let allocAction spec = BU.TSA_AllocationFactory_AllocateV2 BU.ChoiceCall with
        cid = coerceContractId fx.factoryCid
        arg = V2.AllocationFactory_Allocate with
          settlement; allocation = spec; requestedAt = now
          -- Funded from the utility's holding map, not per-call cids.
          inputHoldingCids = []
          extraArgs = emptyExtraArgs; actors = [alice]
      acceptAction = BU.TSA_AllocationRequest_AcceptV2 BU.ChoiceCall with
        cid = coerceContractId reqCid
        arg = V2.AllocationRequest_Accept with
          actors = [alice]; extraArgs = emptyExtraArgs
      inputHoldingMap = BU.holdingMapFromList
        [ ( BU.ScopedAccount with admin = fx.registry; account = lpAcct
          , TextMap.fromList
              [ ("BTC", [toInterfaceContractId baseHold])
              , ("USDC", [toInterfaceContractId quoteHold])
              ] ) ]

  -- ONE top-level command: create the utility and execute the whole batch.
  res <- submit alice $ createAndExerciseCmd
    (BU.BatchingUtility with user = alice)
    BU.BatchingUtility_ExecuteBatch with
      inputHoldingMap
      actions =
        [ acceptAction
        , allocAction baseSpec
        , allocAction quoteSpec
        , allocAction receiptSpec
        ]
      archiveAfterExecution = True

  let allocCids =
        [ cid
        | BU.TSAR_AllocationInstructionResultV2 r <- res.actionResults
        , V2.AllocationInstructionResult_Completed cid <- [r.output]
        ]
  (lpBaseDeposit, lpQuoteDeposit, lpReceipt) <- case allocCids of
    [b, q, r] -> pure (b, q, r)
    _ -> abort "batch must complete exactly three allocations"

  accs <- query @LAR.LiquidityAllocationAcceptance fx.operator
  accCid <- case accs of
    ((cid, _) :: _) -> pure cid
    [] -> abort "batched accept must leave acceptance evidence"

  let preparation = Dvp.AddLiquidityPreparationArgs with
        expectedPoolId = fx.poolId; poolCid = fx.poolCid; poolStateCid = fx.stateCid
        lpPolicyCid = fx.policyCid; requestCid = None; acceptanceCid = Some accCid
        recipient = alice
        lpBaseDepositCid = lpBaseDeposit; lpQuoteDepositCid = lpQuoteDeposit
        lpReceiptCid = lpReceipt
        baseAmount = 10.0; quoteAmount = 200000.0; minLpTokens = 0.0
        knownTotalLpSupply = 0.0
  res2 <- settlePreparedAdd fx preparation now
  res2.lpTokensMinted === lpAmount
  remaining <- query @LAR.LiquidityAllocationAcceptance fx.operator
  remaining === []
  pure ()
