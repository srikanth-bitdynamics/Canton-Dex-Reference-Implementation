-- What this file proves, in plain terms:
-- A liquidity pool records how much of each asset it holds (its "reserves").
-- The real assets sit in separate holding records called "slices". These
-- tests prove the recorded reserves always equal the sum of the actual
-- slices, and that the on-ledger reconcile check refuses to pass whenever the
-- two disagree, so the operator cannot quietly misstate the pool's balance.
-- Design context: `docs/concepts/design-tour.md#liquidity-and-pool-custody`.
--
-- | PoolState.reserves integrity.
--
-- Drives the on-ledger audit anchor `PoolRules_ReconcileState` against the
-- Registry.V2 fixture from PoolLiquidityRulesTests:
--   * reconcile succeeds after a full add -> swap -> remove lifecycle,
--     at every stage, with the then-active slice set;
--   * reconcile fails when the slice list omits a slice;
--   * reconcile catches a desynced (operator-fabricated) PoolState;
--   * reconcile rejects a slice belonging to a different pool.
module CantonDex.Tests.PoolStateInvariantTests where

import DA.Assert
import DA.List (head)
import DA.Map qualified as Map
import DA.Optional (fromSome)
import Daml.Script

import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.MetadataV1
import Splice.Testing.Utils (emptyExtraArgs)

import CantonDex.Dex.Pool
import CantonDex.Dex.PoolState qualified as PS
import CantonDex.Dex.PoolSlice qualified as PSlice
import CantonDex.Dex.PoolRules qualified as PRules
import CantonDex.Dex.PoolModel qualified as PM
import CantonDex.Dex.PoolLiquidityRules qualified as Dvp
import CantonDex.Lp.Instrument qualified as Lp
import CantonDex.Registry.V2 qualified as RegV2
import CantonDex.Testing.MockRegistry qualified as Mock
import CantonDex.Tests.PoolLiquidityRulesTests qualified as PLT
import CantonDex.Trading.Utils qualified as Utils
import CantonDex.Trading.AdminBatch qualified as AB

-- Setup helper: creates the PoolRules contract (the operator's on-ledger audit
-- rules) that every test below runs its reconcile check through.
mkRules : PLT.Fixture -> Script (ContractId PRules.PoolRules)
mkRules fx = submit fx.operator $ createCmd PRules.PoolRules with operator = fx.operator

-- Setup helper: builds the reconcile command. Reconcile re-adds up the given
-- slices and checks that total against the reserves recorded in the PoolState,
-- aborting if the two do not match.
reconcileCmd
  : PLT.Fixture -> ContractId PRules.PoolRules -> ContractId PS.PoolState
  -> [ContractId PSlice.PoolSlice]
  -> Commands PRules.PoolRules_ReconcileResult
reconcileCmd fx rulesCid stateCid sliceCids =
  exerciseCmd rulesCid PRules.PoolRules_ReconcileState with
    expectedPoolId = fx.poolId
    poolCid = fx.poolCid
    poolStateCid = stateCid
    sliceCids

-- Asserts: the recorded reserves stay exactly correct at every point in a
-- pool's life; reconcile passes cleanly after each stage below.
-- Full lifecycle: add -> swap (through Registry.V2) -> full remove, with a
-- clean reconcile after every stage.
-- | Proves reserve reconciliation succeeds after add, swap, and remove.
testReconcileAfterAddSwapRemove : Script ()
testReconcileAfterAddSwapRemove = do
  -- Two traders and a fresh, empty pool wired to the reconcile rules.
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  fx <- PLT.setup [alice, bob]
  rulesCid <- mkRules fx
  now <- getTime

  -- Add: 10 BTC / 200000 USDC.
  addRes <- PLT.dvpAdd fx fx.stateCid fx.policyCid alice 10.0 200000.0 0.0 0.0 0.0 now
  rec1 <- submit fx.operator $
    reconcileCmd fx rulesCid addRes.poolStateCid [addRes.baseSliceCid, addRes.quoteSliceCid]
  rec1.sliceCount === 2
  rec1.baseTotal === 10.0
  rec1.quoteTotal === 200000.0

  -- Swap: bob swaps 100 USDC -> BTC through the same Registry.V2.
  -- Register the swap intent, mint bob his 100 USDC, and package that holding
  -- into an allocation the pool is allowed to draw from during the swap.
  reqRes <- submit fx.operator $ exerciseCmd rulesCid PRules.PoolRules_RequestSwap with
    poolCid = fx.poolCid; swapper = bob
    inputInstrumentId = HoldingV2.InstrumentId with admin = fx.registry; id = "USDC"
    inputAmount = 100.0
    requestedAt = now; settleAt = None
    quoteBinding = Some (PRules.SwapQuoteBinding with
      expectedPoolId = fx.poolId
      poolStateCid = addRes.poolStateCid
      inputSliceCid = addRes.quoteSliceCid
      outputSliceCids = [addRes.baseSliceCid]
      minOutputAmount = 0.0)
  usdcHold <- PLT.mintHolding fx.registry bob "USDC" 100.0
  swapAlloc <- PLT.mkAlloc fx.factoryCid bob reqRes.settlement (head reqRes.allocationSpecs)
    [toInterfaceContractId usdcHold] now
  -- readAs registry: the settle fetches the swapper's locked holding
  -- (admin+owner stakeholders); on a real ledger the wallet discloses it
  -- (see RealRegistryDvpTests), in-script readAs stands in for that.
  swapRes <- submit (actAs [fx.operator] <> readAs [fx.registry]) $ exerciseCmd rulesCid PRules.PoolRules_Swap with
    expectedPoolId = fx.poolId; poolCid = fx.poolCid
    poolStateCid = addRes.poolStateCid
    swapperAccount = Utils.basicAccount bob
    inputInstrumentId = (HoldingV2.InstrumentId with admin = fx.registry; id = "USDC"); inputAmount = 100.0; minOutputAmount = 0.0
    swapperAllocationCidsByAdmin = Map.fromList [(fx.registry, swapAlloc)]
    inputSliceCid = addRes.quoteSliceCid
    outputSliceCids = [addRes.baseSliceCid]
    batchesByAdmin = Map.fromList [(fx.registry, AB.RegistryBatchInput fx.settleCid emptyExtraArgs)]
    swapAllocationRequestCids = [reqRes.swapRequestCid]
    quoteBinding = reqRes.quoteBinding
  let newBaseSliceCid = fromSome swapRes.boundaryOutputSliceCid
  rec2 <- submit fx.operator $
    reconcileCmd fx rulesCid swapRes.poolStateCid [swapRes.inputSliceCid, newBaseSliceCid]
  rec2.sliceCount === 2
  rec2.baseTotal === 10.0 - swapRes.amountOut
  rec2.quoteTotal === 200100.0

  -- Remove: alice redeems the full LP position; the pool drains.
  -- Describe what alice gets back and gives up: a leg paying out the base
  -- (BTC), a leg paying out the quote (USDC), and a leg burning her LP tokens.
  let lpAmount = PM.sqrtDecimal 2000000.0
      baseOut = 10.0 - swapRes.amountOut
      quoteOut = 200100.0
      aliceAcct = Utils.basicAccount alice
      opAcct = Utils.basicAccount fx.operator
      settlement = PM.poolSettlement fx.poolCid fx.operator
      baseOutLeg = V2.TransferLeg with
        transferLegId = "lp-base-out-0"; sender = opAcct; receiver = aliceAcct
        amount = baseOut; instrumentId = "BTC"; meta = emptyMetadata
      quoteOutLeg = V2.TransferLeg with
        transferLegId = "lp-quote-out-0"; sender = opAcct; receiver = aliceAcct
        amount = quoteOut; instrumentId = "USDC"; meta = emptyMetadata
      burnLeg = Lp.lpBurnLeg aliceAcct PLT.lpId lpAmount
  -- Find alice's unlocked LP holding and build the matching allocations: the
  -- receipts that let the pool pay her the base and quote, plus the sender
  -- allocation that surrenders her LP tokens to be burned.
  aliceHs <- query @RegV2.Holding alice
  let (lpHoldCid, _) = head (filter (\(_, h) -> h.instrumentId == PLT.lpId && not h.locked) aliceHs)
  reqCid <- PLT.requestRemove fx alice [baseOut] [quoteOut] lpAmount None now
  baseReceipt <- PLT.mkAlloc fx.factoryCid alice settlement
    (PLT.mkSpec fx.registry aliceAcct [baseOutLeg] False) [] now
  quoteReceipt <- PLT.mkAlloc fx.factoryCid alice settlement
    (PLT.mkSpec fx.registry aliceAcct [quoteOutLeg] False) [] now
  burnSender <- PLT.mkAlloc fx.factoryCid alice settlement
    (PLT.mkSpec fx.registry aliceAcct [burnLeg] True) [toInterfaceContractId lpHoldCid] now
  let preparation = Dvp.RemoveLiquidityPreparationArgs with
        expectedPoolId = fx.poolId; poolCid = fx.poolCid
        poolStateCid = swapRes.poolStateCid; lpPolicyCid = addRes.lpPolicyCid
        requestCid = Some reqCid; acceptanceCid = None
        holder = alice; lpTokensToRedeem = lpAmount; knownTotalLpSupply = lpAmount
        minBaseOut = 0.0; minQuoteOut = 0.0
        baseSliceCids = [newBaseSliceCid]; quoteSliceCids = [swapRes.inputSliceCid]
        holderBaseReceiptCid = baseReceipt; holderQuoteReceiptCid = quoteReceipt
        holderBurnSenderCid = burnSender
  remRes <- PLT.settlePreparedRemove fx preparation now
  remRes.baseReturned === baseOut
  remRes.quoteReturned === quoteOut
  -- Drained pool reconciles against the empty slice set.
  rec3 <- submit fx.operator $ reconcileCmd fx rulesCid remRes.poolStateCid []
  rec3.sliceCount === 0
  rec3.baseTotal === 0.0
  rec3.quoteTotal === 0.0

-- An incomplete slice list understates the sum and must abort.
-- | Proves reconciliation rejects an incomplete active-slice set.
testReconcileFailsOnMissingSlice : Script ()
testReconcileFailsOnMissingSlice = do
  -- Seed a pool with 10 BTC / 200000 USDC, so its two slices are known.
  alice <- allocateParty "alice"
  fx <- PLT.setup [alice]
  rulesCid <- mkRules fx
  now <- getTime
  addRes <- PLT.dvpAdd fx fx.stateCid fx.policyCid alice 10.0 200000.0 0.0 0.0 0.0 now
  -- Quote slice omitted: quote sum 0 /= 200000.
  submitMustFail fx.operator $
    reconcileCmd fx rulesCid addRes.poolStateCid [addRes.baseSliceCid]

-- A desynced PoolState (operator CAN fabricate one — it is the documented
-- trust boundary) is caught by reconcile against the real slices.
-- | Proves reconciliation detects PoolState reserves that disagree with slices.
testReconcileCatchesDesyncedReserves : Script ()
testReconcileCatchesDesyncedReserves = do
  -- Seed a real pool (10 BTC / 200000 USDC) with two honest slices.
  alice <- allocateParty "alice"
  fx <- PLT.setup [alice]
  rulesCid <- mkRules fx
  now <- getTime
  addRes <- PLT.dvpAdd fx fx.stateCid fx.policyCid alice 10.0 200000.0 0.0 0.0 0.0 now
  -- Then hand-build a PoolState that lies about the base reserve (999 BTC).
  badStateCid <- submit fx.operator $ createCmd PS.PoolState with
    poolId = fx.poolId; operator = fx.operator; lpRegistrar = fx.registry
    status = PS_Active
    reserves = PoolReserves with baseAmount = 999.0; quoteAmount = 200000.0
    totalLpSupply = PM.sqrtDecimal 2000000.0
    publicReaders = []
  submitMustFail fx.operator $
    reconcileCmd fx rulesCid badStateCid [addRes.baseSliceCid, addRes.quoteSliceCid]

-- A slice from a different pool must be rejected even when the sums would
-- otherwise be inflated to match.
-- | Proves reconciliation rejects a slice belonging to another pool.
testReconcileRejectsForeignSlice : Script ()
testReconcileRejectsForeignSlice = do
  -- Seed this pool (10 BTC / 200000 USDC) with its two honest slices.
  alice <- allocateParty "alice"
  fx <- PLT.setup [alice]
  rulesCid <- mkRules fx
  now <- getTime
  addRes <- PLT.dvpAdd fx fx.stateCid fx.policyCid alice 10.0 200000.0 0.0 0.0 0.0 now
  -- Fabricate a slice that names a different pool ("SOME-OTHER-POOL").
  foreignSliceCid <- submit fx.operator $ createCmd PSlice.PoolSlice with
    poolId = "SOME-OTHER-POOL"
    operator = fx.operator
    side = BaseSide
    instrumentId = HoldingV2.InstrumentId with admin = fx.registry; id = "BTC"
    allocationCid = coerceContractId addRes.baseSliceCid  -- never fetched
    amount = 1.0
  submitMustFail fx.operator $
    reconcileCmd fx rulesCid addRes.poolStateCid
      [addRes.baseSliceCid, addRes.quoteSliceCid, foreignSliceCid]

-- A swapper that is the operator/pool account is rejected: the swap-in leg
-- (sender = swapper, receiver = pool) and every output leg (sender = pool,
-- receiver = swapper) would be self-transfers, leaving the settle batch unable
-- to balance. The guard fails it loudly instead of producing an opaque
-- conservation error. Every other parameter is a well-formed swap, so the
-- failure is attributable to the swapper == pool account.
-- | Proves the operator account cannot trade against its own pool inventory.
testSwapRejectsOperatorAsSwapper : Script ()
testSwapRejectsOperatorAsSwapper = do
  -- Seed a pool (10 BTC / 200000 USDC) with alice's liquidity; bob will swap.
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  fx <- PLT.setup [alice, bob]
  rulesCid <- mkRules fx
  now <- getTime
  addRes <- PLT.dvpAdd fx fx.stateCid fx.policyCid alice 10.0 200000.0 0.0 0.0 0.0 now
  -- A valid swap allocation authored by bob — only swapperAccount is wrong.
  reqRes <- submit fx.operator $ exerciseCmd rulesCid PRules.PoolRules_RequestSwap with
    poolCid = fx.poolCid; swapper = bob
    inputInstrumentId = HoldingV2.InstrumentId with admin = fx.registry; id = "USDC"
    inputAmount = 100.0
    requestedAt = now; settleAt = None
    quoteBinding = Some (PRules.SwapQuoteBinding with
      expectedPoolId = fx.poolId
      poolStateCid = addRes.poolStateCid
      inputSliceCid = addRes.quoteSliceCid
      outputSliceCids = [addRes.baseSliceCid]
      minOutputAmount = 0.0)
  usdcHold <- PLT.mintHolding fx.registry bob "USDC" 100.0
  swapAlloc <- PLT.mkAlloc fx.factoryCid bob reqRes.settlement (head reqRes.allocationSpecs)
    [toInterfaceContractId usdcHold] now
  submitMustFail (actAs [fx.operator] <> readAs [fx.registry]) $
    exerciseCmd rulesCid PRules.PoolRules_Swap with
      expectedPoolId = fx.poolId; poolCid = fx.poolCid
      poolStateCid = addRes.poolStateCid
      swapperAccount = Utils.basicAccount fx.operator  -- == pool/operator account
      inputInstrumentId = (HoldingV2.InstrumentId with admin = fx.registry; id = "USDC"); inputAmount = 100.0; minOutputAmount = 0.0
      swapperAllocationCidsByAdmin = Map.fromList [(fx.registry, swapAlloc)]
      inputSliceCid = addRes.quoteSliceCid
      outputSliceCids = [addRes.baseSliceCid]
      batchesByAdmin = Map.fromList [(fx.registry, AB.RegistryBatchInput fx.settleCid emptyExtraArgs)]
      swapAllocationRequestCids = [reqRes.swapRequestCid]
      quoteBinding = reqRes.quoteBinding

-- Same-symbol cross-admin routing --------------------------------------
--
-- Two registries can both issue an asset called "USD". A pool whose base is
-- {adminA,"USD"} and quote {adminB,"USD"} shares a text id across sides, so the
-- swap side must be decided by FULL instrument identity. This proves each
-- direction routes correctly and a same-symbol input under a foreign admin is
-- rejected rather than mis-routed as base.
-- | Proves swap routing keys on full instrument identity, not the bare id.
testSameSymbolCrossAdminSwapRoutesByIdentity : Script ()
testSameSymbolCrossAdminSwapRoutesByIdentity = do
  operator <- allocateParty "op-samesym"
  adminA <- allocateParty "adminA-samesym"
  adminB <- allocateParty "adminB-samesym"
  lpReg <- allocateParty "lpreg-samesym"
  bob <- allocateParty "bob-samesym"
  now <- getTime

  let baseId = HoldingV2.InstrumentId with admin = adminA; id = "USD"
      quoteId = HoldingV2.InstrumentId with admin = adminB; id = "USD"
      lpInstrumentId = HoldingV2.InstrumentId with admin = lpReg; id = "USD-LP"
      poolId = "USD-USD"

  poolCid <- submit operator $ createCmd Pool with
    poolId; operator; lpRegistrar = lpReg
    baseInstrumentId = baseId; quoteInstrumentId = quoteId
    lpInstrumentId; feeBps = 30
  stateCid <- submit operator $ createCmd PS.PoolState with
    poolId; operator; lpRegistrar = lpReg
    status = PS_Active
    reserves = PoolReserves with baseAmount = 1000.0; quoteAmount = 1000.0
    totalLpSupply = 1000.0; publicReaders = []
  rulesCid <- submit operator $ createCmd PRules.PoolRules with operator

  -- A mock allocation cid to back each slice; the routing decision never
  -- fetches it, so one shared cid suffices.
  let sliceSettlement = V2.SettlementInfo with
        executors = [operator]; id = "slice-mock"; cid = None; meta = emptyMetadata
      sliceSpec = Utils.mkIteratedAllocationSpecification
        adminA (Utils.basicAccount operator) None [] None False
  mockAllocRaw <- submit adminA $ createCmd Mock.MockAllocation with
    admin = adminA; settlement = sliceSettlement; spec = sliceSpec
    createdAt = now; numIterations = 0
  let mockAlloc : ContractId V2.Allocation = toInterfaceContractId mockAllocRaw

  baseSliceCid <- submit operator $ createCmd PSlice.PoolSlice with
    poolId; operator; side = BaseSide; instrumentId = baseId
    allocationCid = mockAlloc; amount = 1000.0
  quoteSliceCid <- submit operator $ createCmd PSlice.PoolSlice with
    poolId; operator; side = QuoteSide; instrumentId = quoteId
    allocationCid = mockAlloc; amount = 1000.0

  -- The admin whose spec carries the "swap-in" sender leg is the input admin.
  let swapInAdmin specs = head
        [ s.admin | s <- specs
        , any (\l -> l.transferLegId == "swap-in" && l.side == V2.SenderSide)
            s.transferLegSides ]
      requestSwap inputId inSliceCid outSliceCids =
        submit operator $ exerciseCmd rulesCid PRules.PoolRules_RequestSwap with
          poolCid; swapper = bob; inputInstrumentId = inputId; inputAmount = 100.0
          requestedAt = now; settleAt = None
          quoteBinding = Some (PRules.SwapQuoteBinding with
            expectedPoolId = poolId; poolStateCid = stateCid
            inputSliceCid = inSliceCid; outputSliceCids = outSliceCids
            minOutputAmount = 0.0)

  -- Input = base identity {adminA,"USD"}: routes as base, swap-in under adminA.
  baseReq <- requestSwap baseId baseSliceCid [quoteSliceCid]
  length baseReq.allocationSpecs === 2
  swapInAdmin baseReq.allocationSpecs === adminA

  -- Input = quote identity {adminB,"USD"}: routes as quote, swap-in under adminB.
  quoteReq <- requestSwap quoteId quoteSliceCid [baseSliceCid]
  length quoteReq.allocationSpecs === 2
  swapInAdmin quoteReq.allocationSpecs === adminB

  -- A same-symbol "USD" under a foreign admin is not a pool instrument and is
  -- rejected, not silently mis-routed as base.
  adminC <- allocateParty "adminC-samesym"
  let foreignId = HoldingV2.InstrumentId with admin = adminC; id = "USD"
  submitMustFail operator $ exerciseCmd rulesCid PRules.PoolRules_RequestSwap with
    poolCid; swapper = bob; inputInstrumentId = foreignId; inputAmount = 100.0
    requestedAt = now; settleAt = None
    quoteBinding = Some (PRules.SwapQuoteBinding with
      expectedPoolId = poolId; poolStateCid = stateCid
      inputSliceCid = baseSliceCid; outputSliceCids = [quoteSliceCid]
      minOutputAmount = 0.0)
  pure ()
