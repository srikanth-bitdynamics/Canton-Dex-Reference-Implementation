-- | Cross-registry settlement tests. Base and quote use the upstream
-- `TestTokenV2_RegistryV2`, whose choices require a disclosed `TokenRules`
-- contract. LP mint and burn use `Registry.V2`, which supports the owner=None
-- mint account and requires no choice context. The tests prove that each
-- admin's context reaches its own settlement batch.
-- Design context: `docs/concepts/design-tour.md#cross-registry-settlement`.
module CantonDex.Tests.RealRegistryDvpTests where

import DA.Assert
import DA.Foldable (foldMap)
import DA.List (head)
import DA.Map qualified as Map
import DA.Optional (fromSome, isNone)
import DA.Text qualified as T
import DA.TextMap qualified as TextMap
import Daml.Script

import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.AllocationInstructionV2 qualified as V2
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.MetadataV1

import Splice.Testing.Utils (discloseMany', queryDisclosure', Disclosures', emptyExtraArgs)
import Splice.Testing.TokenStandard.RegistryApiV2 (getAllocationFactory)
import Splice.Testing.Registries.TestTokenV2_RegistryV2 qualified as TT2
import Splice.Testing.Tokens.TestTokenV2 qualified as TestTokenV2
import Splice.Testing.Tokens.TestTokenV2.Holding qualified as TTHolding

import CantonDex.Dex.Pool
import CantonDex.Dex.PoolState qualified as PS
import CantonDex.Dex.PoolModel qualified as PM
import CantonDex.Dex.MatchedTrade qualified as MT
import CantonDex.Dex.PoolLiquidityRules qualified as Dvp
import CantonDex.Dex.PoolRules qualified as PRules
import CantonDex.Dex.LiquidityAllocationRequest qualified as LAR
import CantonDex.Lp.Policy qualified as LP
import CantonDex.Lp.Instrument qualified as Lp
import CantonDex.Registry.V2 qualified as RegV2
import CantonDex.Trading.Utils qualified as Utils

lpId : Text
lpId = "BTC-USDC-LP"

-- Collect the LP's unlocked V2 holding contract ids for an instrument.
holdingCidsFor : Party -> Text -> Script [ContractId V2.Holding]
holdingCidsFor owner instrId = do
  hs <- queryInterface @V2.Holding owner
  pure [ cid | (cid, Some v) <- hs, v.instrumentId.id == instrId, v.account.owner == Some owner, isNone v.lock ]

-- Read the amounts from those holdings.
unlockedAmountsFor : Party -> Text -> Script [Decimal]
unlockedAmountsFor owner instrId = do
  hs <- queryInterface @V2.Holding owner
  pure [ v.amount | (_, Some v) <- hs, v.instrumentId.id == instrId, v.account.owner == Some owner, isNone v.lock ]

-- Author an LP allocation through the reference registry, which needs no choice
-- context. `readAs` models the factory disclosure supplied by an integration.
lpAlloc
  : Fixture -> Party -> V2.SettlementInfo -> V2.AllocationSpecification
  -> [ContractId V2.Holding] -> Time -> Script (ContractId V2.Allocation)
lpAlloc fx party settlement spec inputHoldingCids now = do
  res <- submit (actAs party <> readAs [fx.lpRegistrar]) $
    exerciseCmd (toInterfaceContractId fx.lpReg : ContractId V2.AllocationFactory)
      V2.AllocationFactory_Allocate with
        settlement; allocation = spec; requestedAt = now
        inputHoldingCids; actors = [party]; extraArgs = emptyExtraArgs
  case res.output of
    V2.AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "lpAlloc: allocation must complete"

-- Author an allocation through the TestTokenV2 registry: enrich the factory
-- choice with TokenRules context and disclosure, then submit it as `party`.
ttAlloc
  : TT2.TestTokenV2Registry -> Party -> V2.SettlementInfo -> V2.AllocationSpecification
  -> [ContractId V2.Holding] -> Time -> Script (ContractId V2.Allocation)
ttAlloc reg party settlement spec inputHoldingCids now = do
  enriched <- getAllocationFactory reg V2.AllocationFactory_Allocate with
    settlement; allocation = spec; requestedAt = now
    inputHoldingCids; actors = [party]; extraArgs = emptyExtraArgs
  res <- submit (actAs party <> discloseMany' enriched.disclosures) $
    exerciseCmd enriched.factoryCid enriched.arg
  case res.output of
    V2.AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "ttAlloc: allocation must complete"

-- Disclose TokenRules + every TestTokenV2 holding the registry administers,
-- so the settle's TT2 SettleBatch can see the locked deposit holdings it
-- consumes (mirrors getSettlementFactory's lockedDs enrichment).
ttSettleDisclosures : Fixture -> Script Disclosures'
ttSettleDisclosures fx = do
  toks <- query @TTHolding.Token fx.ttAdmin
  ds <- forA toks (\(cid, _) -> queryDisclosure' @TTHolding.Token fx.ttAdmin cid)
  pure (fx.ttDisclosures <> mconcat ds)

mkSpec : Party -> V2.Account -> [V2.TransferLeg] -> Bool -> V2.AllocationSpecification
mkSpec admin authorizer legs committed = V2.AllocationSpecification with
  admin; authorizer
  transferLegSides = Utils.legsToSides authorizer legs
  settlementDeadline = None; nextIterationFunding = None; committed
  meta = emptyMetadata

-- The add flow's deposit specs are iterated-enabled, so the settle can attach
-- the off-ratio refund leg.
depositSpec : Party -> V2.Account -> V2.TransferLeg -> V2.AllocationSpecification
depositSpec admin authorizer leg =
  (mkSpec admin authorizer [leg] True) with nextIterationFunding = Some TextMap.empty

data Fixture = Fixture with
  operator : Party
  lpRegistrar : Party
  ttAdmin : Party
  ttReg : TT2.TestTokenV2Registry
  lpReg : ContractId RegV2.Registry      -- our V2 self-registry (LP side)
  poolId : PoolId
  poolCid : ContractId Pool
  stateCid : ContractId PS.PoolState
  policyCid : ContractId LP.LPTokenPolicy
  dvpCid : ContractId Dvp.PoolLiquidityRules
  rulesCid : ContractId PRules.PoolRules
  ttFactoryCid : ContractId V2.AllocationFactory
  ttSettleCid : ContractId V2.SettlementFactory
  ttDisclosures : Disclosures'
  ttContext : ChoiceContext

-- base = "X", quote = "Y" (TestTokenV2 instruments administered by ttAdmin).
setup : Party -> Script Fixture
setup lp = do
  operator <- allocateParty "operator"
  lpRegistrar <- allocateParty "lp-registrar"
  ttReg <- TT2.initialize TT2.defaultTestTokenV2RegistryConfig
  let ttAdmin = ttReg.admin
  -- LP side: our context-free, mint-capable self-registry.
  lpRegCid <- submit lpRegistrar $ createCmd RegV2.Registry with
    admin = lpRegistrar; users = [operator, lp]
  -- Mint the LP's base and quote TestTokenV2 holdings.
  TT2.mint ttReg (Utils.basicAccount lp) "X" 10.0
  TT2.mint ttReg (Utils.basicAccount lp) "Y" 200000.0
  let poolId = "X-Y"
      lpInstrumentId = V2.InstrumentId with admin = lpRegistrar; id = lpId
  poolCid <- submit operator $ createCmd Pool with
    poolId; operator; lpRegistrar; admin = ttAdmin
    baseInstrumentId = "X"; quoteInstrumentId = "Y"; lpInstrumentId
    feeBps = 30
  stateCid <- submit operator $ createCmd PS.PoolState with
    poolId; operator; lpRegistrar
    status = PS_Unfunded
    reserves = PoolReserves with baseAmount = 0.0; quoteAmount = 0.0
    totalLpSupply = 0.0; publicReaders = []
  dvpCid <- submit (actAs [operator, lpRegistrar]) $
    createCmd Dvp.PoolLiquidityRules with operator; lpRegistrar
  rulesCid <- submit operator $ createCmd PRules.PoolRules with operator
  policyCid <- submit lpRegistrar $ createCmd LP.LPTokenPolicy with
    lpRegistrar; operator; lpInstrumentId
    totalSupply = 0.0; active = True
  -- The TestTokenV2 factory cid + its uniform choice context/disclosure
  -- (basic accounts => one context reused across all TT2 choices).
  now <- getTime
  let sampleSpec = mkSpec ttAdmin (Utils.basicAccount lp)
        [ V2.TransferLeg with
            transferLegId = "sample"; sender = Utils.basicAccount lp
            receiver = Utils.basicAccount operator; amount = 10.0
            instrumentId = "X"; meta = emptyMetadata ] True
  enriched <- getAllocationFactory ttReg V2.AllocationFactory_Allocate with
    settlement = PM.poolSettlement poolCid operator
    allocation = sampleSpec; requestedAt = now
    inputHoldingCids = []; actors = [lp]; extraArgs = emptyExtraArgs
  [(tokenRulesCid, _)] <- query @TestTokenV2.TokenRules ttAdmin
  ttD <- queryDisclosure' @TestTokenV2.TokenRules ttAdmin tokenRulesCid
  pure Fixture with
    operator; lpRegistrar; ttAdmin; ttReg; lpReg = lpRegCid
    poolId; poolCid; stateCid; policyCid; dvpCid; rulesCid
    ttFactoryCid = enriched.factoryCid
    ttSettleCid = coerceContractId enriched.factoryCid
    ttDisclosures = ttD
    ttContext = enriched.arg.extraArgs.context

-- Author the LP's three add allocations and return them with the request.
authorAdd
  : Fixture -> Party -> Decimal -> Decimal -> Time
  -> Script ( ContractId LAR.LiquidityAllocationRequest
            , ContractId V2.Allocation, ContractId V2.Allocation, ContractId V2.Allocation )
authorAdd fx lp baseAmount quoteAmount now = do
  let lpAcct = Utils.basicAccount lp
      opAcct = Utils.basicAccount fx.operator
      settlement = PM.poolSettlement fx.poolCid fx.operator
      lpAmount = PM.sqrtDecimal (baseAmount * quoteAmount)
      baseLeg = V2.TransferLeg with
        transferLegId = "lp-base-deposit"; sender = lpAcct; receiver = opAcct
        amount = baseAmount; instrumentId = "X"; meta = emptyMetadata
      quoteLeg = V2.TransferLeg with
        transferLegId = "lp-quote-deposit"; sender = lpAcct; receiver = opAcct
        amount = quoteAmount; instrumentId = "Y"; meta = emptyMetadata
      lpMintLeg = Lp.lpMintLeg lpAcct lpId lpAmount
  reqCid <- submit fx.operator $ exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_RequestAddLiquidity with
    poolCid = fx.poolCid; recipient = lp; baseAmount; quoteAmount; lpAmount
    requestedAt = now; settleAt = None
  baseCids <- holdingCidsFor lp "X"
  quoteCids <- holdingCidsFor lp "Y"
  -- Base and quote deposits use the TestTokenV2 registry.
  baseDep <- ttAlloc fx.ttReg lp settlement (depositSpec fx.ttAdmin lpAcct baseLeg) baseCids now
  quoteDep <- ttAlloc fx.ttReg lp settlement (depositSpec fx.ttAdmin lpAcct quoteLeg) quoteCids now
  -- LP mint receipt via our self-registry (mint account, no context).
  let receiptSpec = mkSpec fx.lpRegistrar lpAcct [lpMintLeg] False
  rres <- submit lp $ exerciseCmd (toInterfaceContractId fx.lpReg : ContractId V2.AllocationFactory)
    V2.AllocationFactory_Allocate with
      settlement; allocation = receiptSpec; requestedAt = now
      inputHoldingCids = []; actors = [lp]; extraArgs = emptyExtraArgs
  let V2.AllocationInstructionResult_Completed receiptCid = rres.output
  pure (reqCid, baseDep, quoteDep, receiptCid)

-- Build the DvP-add SettleAddLiquidity command, parameterized on the
-- pool.admin (base/quote) choice context. base/quote settle via the real
-- TestTokenV2 factory; LP mint via our self-registry.
mkSettleAdd
  : Fixture -> ContractId LAR.LiquidityAllocationRequest -> Party
  -> ContractId V2.Allocation -> ContractId V2.Allocation -> ContractId V2.Allocation
  -> Time -> ExtraArgs -> Commands Dvp.PoolLiquidityRules_SettleAddResult
mkSettleAdd fx reqCid lp baseDep quoteDep receiptCid now poolAdminCtx =
  exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_SettleAddLiquidity with
    expectedPoolId = fx.poolId; poolCid = fx.poolCid; poolStateCid = fx.stateCid
    lpPolicyCid = fx.policyCid; requestCid = Some reqCid; acceptanceCid = None; recipient = lp
    lpBaseDepositCid = baseDep; lpQuoteDepositCid = quoteDep; lpReceiptCid = receiptCid
    baseFactoryCid = fx.ttFactoryCid; quoteFactoryCid = fx.ttFactoryCid
    lpFactoryCid = toInterfaceContractId fx.lpReg
    baseQuoteSettleCid = fx.ttSettleCid; lpSettleCid = coerceContractId fx.lpReg
    baseAmount = 10.0; quoteAmount = 200000.0; minLpTokens = 0.0; knownTotalLpSupply = 0.0
    requestedAt = now; poolAdminExtraArgs = poolAdminCtx; lpRegistrarExtraArgs = emptyExtraArgs

-- Run a full DvP add and return its result for tests that need a funded pool.
addSettle : Fixture -> Party -> Time -> Script Dvp.PoolLiquidityRules_SettleAddResult
addSettle fx lp now = do
  (reqCid, baseDep, quoteDep, receiptCid) <- authorAdd fx lp 10.0 200000.0 now
  settleDisc <- ttSettleDisclosures fx
  let poolAdminCtx = ExtraArgs with context = fx.ttContext; meta = emptyMetadata
  submit (foldMap actAs [fx.operator, fx.lpRegistrar] <> discloseMany' settleDisc) $
    mkSettleAdd fx reqCid lp baseDep quoteDep receiptCid now poolAdminCtx

-- A DvP add settles across both registries when the base/quote batch receives
-- the TestTokenV2 context. The pool becomes active, its reserves are backed by
-- allocations, and the LP receives newly minted LP tokens.
-- | Proves cross-registry add-liquidity settles deposits and LP mint atomically.
testRealRegistryDvpAddSettles : Script ()
testRealRegistryDvpAddSettles = do
  lp <- allocateParty "lp"
  fx <- setup lp
  now <- getTime
  res <- addSettle fx lp now
  Some state <- queryContractId fx.operator res.poolStateCid
  state.status === PS_Active
  state.reserves.baseAmount === 10.0
  state.reserves.quoteAmount === 200000.0
  res.lpTokensMinted === PM.sqrtDecimal 2000000.0
  -- The LP received the minted LP holding from the reference registry.
  lpHoldings <- query @RegV2.Holding lp
  let mintedLp = filter (\(_, h) -> h.instrumentId == lpId && h.owner == lp && not h.locked) lpHoldings
  length mintedLp === 1

-- Without poolAdminExtraArgs, the context-requiring base/quote factory rejects
-- the missing `testTokenV2/tokenRules` value before settlement.
-- | Proves a context-requiring upstream registry rejects missing choice context.
testRealRegistryDvpRejectsMissingContext : Script ()
testRealRegistryDvpRejectsMissingContext = do
  lp <- allocateParty "lp"
  fx <- setup lp
  now <- getTime
  (reqCid, baseDep, quoteDep, receiptCid) <- authorAdd fx lp 10.0 200000.0 now
  settleDisc <- ttSettleDisclosures fx
  result <- trySubmit (foldMap actAs [fx.operator, fx.lpRegistrar] <> discloseMany' settleDisc) $
    mkSettleAdd fx reqCid lp baseDep quoteDep receiptCid now emptyExtraArgs
  case result of
    Right _ -> abort "expected a missing-context failure"
    Left e ->
      assertMsg ("expected missing tokenRules context, got: " <> show e)
        (T.isInfixOf "tokenRules" (show e))

-- An off-ratio add takes only the ratio-matched part of the deposit. The
-- upstream registry returns the unmatched remainder as an unlocked holding.
-- | Proves cross-registry add refunds off-ratio excess as unlocked holdings.
testRealRegistryDvpAddRefundsOffRatioExcess : Script ()
testRealRegistryDvpAddRefundsOffRatioExcess = do
  lp <- allocateParty "lp"
  fx <- setup lp
  now <- getTime
  addRes <- addSettle fx lp now
  let supply = PM.sqrtDecimal 2000000.0
      lpAcct = Utils.basicAccount lp
      opAcct = Utils.basicAccount fx.operator
      settlement = PM.poolSettlement fx.poolCid fx.operator
      -- 5 X + 150000 Y into a 10 : 200000 pool: base limits, so 50000 Y is
      -- unmatched and must come back.
      baseAmount = 5.0
      quoteAmount = 150000.0
      lpAmount = (baseAmount * supply) / 10.0
      baseLeg = V2.TransferLeg with
        transferLegId = "lp-base-deposit"; sender = lpAcct; receiver = opAcct
        amount = baseAmount; instrumentId = "X"; meta = emptyMetadata
      quoteLeg = V2.TransferLeg with
        transferLegId = "lp-quote-deposit"; sender = lpAcct; receiver = opAcct
        amount = quoteAmount; instrumentId = "Y"; meta = emptyMetadata
      lpMintLeg = Lp.lpMintLeg lpAcct lpId lpAmount
  TT2.mint fx.ttReg lpAcct "X" baseAmount
  TT2.mint fx.ttReg lpAcct "Y" quoteAmount
  reqCid <- submit fx.operator $ exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_RequestAddLiquidity with
    poolCid = fx.poolCid; recipient = lp; baseAmount; quoteAmount; lpAmount
    requestedAt = now; settleAt = None
  baseCids <- holdingCidsFor lp "X"
  quoteCids <- holdingCidsFor lp "Y"
  baseDep <- ttAlloc fx.ttReg lp settlement (depositSpec fx.ttAdmin lpAcct baseLeg) baseCids now
  quoteDep <- ttAlloc fx.ttReg lp settlement (depositSpec fx.ttAdmin lpAcct quoteLeg) quoteCids now
  rres <- submit lp $ exerciseCmd (toInterfaceContractId fx.lpReg : ContractId V2.AllocationFactory)
    V2.AllocationFactory_Allocate with
      settlement; allocation = mkSpec fx.lpRegistrar lpAcct [lpMintLeg] False; requestedAt = now
      inputHoldingCids = []; actors = [lp]; extraArgs = emptyExtraArgs
  let V2.AllocationInstructionResult_Completed receiptCid = rres.output
  settleDisc <- ttSettleDisclosures fx
  res <- submit (foldMap actAs [fx.operator, fx.lpRegistrar] <> discloseMany' settleDisc) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_SettleAddLiquidity with
      expectedPoolId = fx.poolId; poolCid = fx.poolCid; poolStateCid = addRes.poolStateCid
      lpPolicyCid = addRes.lpPolicyCid; requestCid = Some reqCid; acceptanceCid = None
      recipient = lp
      lpBaseDepositCid = baseDep; lpQuoteDepositCid = quoteDep; lpReceiptCid = receiptCid
      baseFactoryCid = fx.ttFactoryCid; quoteFactoryCid = fx.ttFactoryCid
      lpFactoryCid = toInterfaceContractId fx.lpReg
      baseQuoteSettleCid = fx.ttSettleCid; lpSettleCid = coerceContractId fx.lpReg
      baseAmount; quoteAmount; minLpTokens = 0.0; knownTotalLpSupply = supply
      requestedAt = now
      poolAdminExtraArgs = ExtraArgs with context = fx.ttContext; meta = emptyMetadata
      lpRegistrarExtraArgs = emptyExtraArgs
  res.baseAdded === Some 5.0
  res.quoteAdded === Some 100000.0
  Some state <- queryContractId fx.operator res.poolStateCid
  state.reserves.baseAmount === 15.0
  state.reserves.quoteAmount === 300000.0
  refundedY <- unlockedAmountsFor lp "Y"
  refundedX <- unlockedAmountsFor lp "X"
  refundedY === [50000.0]
  refundedX === []

-- After funding the pool, the holder redeems the full position. TestTokenV2
-- delivers base and quote from the pool slices, and the reference registry burns
-- the LP tokens.
-- | Proves cross-registry remove pays reserves and burns LP tokens atomically.
testRealRegistryDvpRemoveSettles : Script ()
testRealRegistryDvpRemoveSettles = do
  alice <- allocateParty "lp"
  fx <- setup alice
  now <- getTime
  addRes <- addSettle fx alice now
  let lpAmount = PM.sqrtDecimal 2000000.0
      aliceAcct = Utils.basicAccount alice
      opAcct = Utils.basicAccount fx.operator
      settlement = PM.poolSettlement fx.poolCid fx.operator
      baseOutLeg = V2.TransferLeg with
        transferLegId = "lp-base-out-0"; sender = opAcct; receiver = aliceAcct
        amount = 10.0; instrumentId = "X"; meta = emptyMetadata
      quoteOutLeg = V2.TransferLeg with
        transferLegId = "lp-quote-out-0"; sender = opAcct; receiver = aliceAcct
        amount = 200000.0; instrumentId = "Y"; meta = emptyMetadata
      burnLeg = Lp.lpBurnLeg aliceAcct lpId lpAmount
  -- alice's LP holding, to lock for the burn (on our registry).
  aliceHs <- query @RegV2.Holding alice
  let (lpHoldCid, _) = head (filter (\(_, h) -> h.instrumentId == lpId && not h.locked) aliceHs)
  reqCid <- submit fx.operator $ exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_RequestRemoveLiquidity with
    poolCid = fx.poolCid; holder = alice; baseOuts = [10.0]; quoteOuts = [200000.0]
    lpBurnAmount = lpAmount; requestedAt = now; settleAt = None
  -- Base/quote receipts use TestTokenV2; the burn sender uses our registry.
  baseReceipt <- ttAlloc fx.ttReg alice settlement (mkSpec fx.ttAdmin aliceAcct [baseOutLeg] False) [] now
  quoteReceipt <- ttAlloc fx.ttReg alice settlement (mkSpec fx.ttAdmin aliceAcct [quoteOutLeg] False) [] now
  brres <- submit alice $ exerciseCmd (toInterfaceContractId fx.lpReg : ContractId V2.AllocationFactory)
    V2.AllocationFactory_Allocate with
      settlement; allocation = mkSpec fx.lpRegistrar aliceAcct [burnLeg] True; requestedAt = now
      inputHoldingCids = [toInterfaceContractId lpHoldCid]; actors = [alice]; extraArgs = emptyExtraArgs
  let V2.AllocationInstructionResult_Completed burnSender = brres.output
  settleDisc <- ttSettleDisclosures fx
  let poolAdminCtx = ExtraArgs with context = fx.ttContext; meta = emptyMetadata
  remRes <- submit (foldMap actAs [fx.operator, fx.lpRegistrar] <> discloseMany' settleDisc) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_SettleRemoveLiquidity with
      expectedPoolId = fx.poolId; poolCid = fx.poolCid
      poolStateCid = addRes.poolStateCid; lpPolicyCid = addRes.lpPolicyCid
      requestCid = Some reqCid; acceptanceCid = None
      holder = alice; lpTokensToRedeem = lpAmount; knownTotalLpSupply = lpAmount
      minBaseOut = 0.0; minQuoteOut = 0.0
      baseSliceCids = [addRes.baseSliceCid]; quoteSliceCids = [addRes.quoteSliceCid]
      holderBaseReceiptCid = baseReceipt; holderQuoteReceiptCid = quoteReceipt
      holderBurnSenderCid = burnSender
      baseFactoryCid = fx.ttFactoryCid; quoteFactoryCid = fx.ttFactoryCid
      lpFactoryCid = toInterfaceContractId fx.lpReg
      baseQuoteSettleCid = fx.ttSettleCid; lpSettleCid = coerceContractId fx.lpReg
      requestedAt = now; poolAdminExtraArgs = poolAdminCtx; lpRegistrarExtraArgs = emptyExtraArgs
  Some state <- queryContractId fx.operator remRes.poolStateCid
  state.reserves.baseAmount === 0.0
  state.reserves.quoteAmount === 0.0
  state.status === PS_Unfunded
  remRes.baseReturned === 10.0
  remRes.quoteReturned === 200000.0
  -- LP burned; alice received base/quote back as TestTokenV2 holdings.
  after <- query @RegV2.Holding alice
  length (filter (\(_, h) -> h.instrumentId == lpId && h.owner == alice) after) === 0
  baseBack <- holdingCidsFor alice "X"
  quoteBack <- holdingCidsFor alice "Y"
  assertMsg "alice received base (X) back" (not (null baseBack))
  assertMsg "alice received quote (Y) back" (not (null quoteBack))

-- Swap through the TestTokenV2 registry using the dApp's DvP shape. After
-- funding the pool, Bob swaps quote (Y) for base (X):
--   1. operator builds bob's exact two-sided allocation spec via
--      PoolRules_RequestSwap (the dApp POST /v1/pools/swap/request path);
--   2. bob authors that exact spec through the TestTokenV2 registry,
--      locking his Y holdings (mirrors the wallet's AllocationFactory_Allocate);
--   3. operator settles via PoolRules_Swap against its SettlementFactory,
--      threading the per-admin context and disclosures.
-- The assertions cover reserve movement and the receiver's output holding.
-- | Proves a signed swap moves real holdings through the upstream registry.
testRealRegistryDvpSwapSettles : Script ()
testRealRegistryDvpSwapSettles = do
  bob <- allocateParty "lp"      -- LP/funder
  fx <- setup bob
  now <- getTime
  addRes <- addSettle fx bob now

  -- Mint enough quote for one deliberately underpaying allocation and the real
  -- swap allocation, so the negative check cannot consume the real input.
  let swapIn = 1000.0
  TT2.mint fx.ttReg (Utils.basicAccount bob) "Y" (2.0 * swapIn)

  let quoteBinding = Some (PRules.SwapQuoteBinding with
        expectedPoolId = fx.poolId
        poolStateCid = addRes.poolStateCid
        inputSliceCid = addRes.quoteSliceCid
        outputSliceCids = [addRes.baseSliceCid]
        minOutputAmount = 0.0)
  -- 1. Operator builds the exact two-sided allocation spec.
  reqRes <- submit fx.operator $ exerciseCmd fx.rulesCid PRules.PoolRules_RequestSwap with
    poolCid = fx.poolCid
    swapper = bob
    inputInstrumentId = "Y"
    inputAmount = swapIn
    quoteBinding
  reqRes.allocationSpec.nextIterationFunding === None
  reqRes.allocationSpec.committed === False
  let senderSides = filter (\side -> side.side == V2.SenderSide)
        reqRes.allocationSpec.transferLegSides
      receiverSides = filter (\side -> side.side == V2.ReceiverSide)
        reqRes.allocationSpec.transferLegSides
  map (.instrumentId) senderSides === ["Y"]
  map (.amount) senderSides === [swapIn]
  map (.instrumentId) receiverSides === ["X"]
  assertMsg "swap request must bind a positive output" (sum (map (.amount) receiverSides) > 0.0)

  -- Even a one-ulp reduction in the signed receiver side cannot settle. The
  -- pool choice recomputes the output from the bound state, and SettleBatch
  -- requires the allocation to authorize that exact leg.
  let underpaySpec = reqRes.allocationSpec with
        transferLegSides = map
          (\side -> if side.side == V2.ReceiverSide
            then side with amount = side.amount - 0.0000000001
            else side)
          reqRes.allocationSpec.transferLegSides
  underpayInputs <- holdingCidsFor bob "Y"
  underpayCid <- ttAlloc fx.ttReg bob reqRes.settlement underpaySpec underpayInputs now
  malformedSettleDisc <- ttSettleDisclosures fx
  let swapCtx = ExtraArgs with context = fx.ttContext; meta = emptyMetadata
  submitMustFail (actAs fx.operator <> discloseMany' malformedSettleDisc) $
    exerciseCmd fx.rulesCid PRules.PoolRules_Swap with
      expectedPoolId = fx.poolId; poolCid = fx.poolCid
      poolStateCid = addRes.poolStateCid
      swapperAccount = Utils.basicAccount bob
      inputInstrumentId = "Y"; inputAmount = swapIn; minOutputAmount = 0.0
      swapperAllocationCid = underpayCid
      inputSliceCid = addRes.quoteSliceCid
      outputSliceCids = [addRes.baseSliceCid]
      factoryCid = fx.ttSettleCid
      extraArgs = swapCtx
      quoteBinding = reqRes.quoteBinding

  -- 2. Bob authors that exact spec via the upstream TestTokenV2 registry,
  --    locking his Y input holdings.
  quoteIn <- holdingCidsFor bob "Y"
  swapAllocCid <- ttAlloc fx.ttReg bob reqRes.settlement reqRes.allocationSpec quoteIn now

  -- 3. Operator settles the swap via PoolRules_Swap against the upstream
  --    TestTokenV2 SettlementFactory, with the per-admin context.
  settleDisc <- ttSettleDisclosures fx
  swapRes <- submit (actAs fx.operator <> discloseMany' settleDisc) $
    exerciseCmd fx.rulesCid PRules.PoolRules_Swap with
      expectedPoolId = fx.poolId; poolCid = fx.poolCid
      poolStateCid = addRes.poolStateCid
      swapperAccount = Utils.basicAccount bob
      inputInstrumentId = "Y"; inputAmount = swapIn; minOutputAmount = 0.0
      swapperAllocationCid = swapAllocCid
      inputSliceCid = addRes.quoteSliceCid
      outputSliceCids = [addRes.baseSliceCid]
      factoryCid = fx.ttSettleCid
      extraArgs = swapCtx
      quoteBinding = reqRes.quoteBinding

  Some state <- queryContractId fx.operator swapRes.poolStateCid
  assertMsg "quote reserve increased after swap" (state.reserves.quoteAmount > 200000.0)
  assertMsg "base reserve decreased after swap" (state.reserves.baseAmount < 10.0)
  assertMsg "swap via RequestSwap produced output" (swapRes.amountOut > 0.0)
  -- Bob received base (X) as a TestTokenV2 holding.
  bobBase <- holdingCidsFor bob "X"
  assertMsg "bob received base (X) from the swap" (not (null bobBase))

-- A matched trade whose legs live under different registries: the X leg
-- under the upstream TestTokenV2 registry, the LP leg under ours. The Token
-- Standard requires a batch's allocations to cover exactly the legs the batch
-- is handed, so each admin's batch must carry only its own admin's legs.
data TwoAdminTrade = TwoAdminTrade with
    fx : Fixture
    tradeCid : ContractId MT.MatchedTrade
    xLeg : V2.TransferLeg
    lpLeg : V2.TransferLeg
    ttAllocations : [V2.FinalizedAllocation]
    lpAllocations : [V2.FinalizedAllocation]
    settleDisclosures : Disclosures'

-- alice sends 1 X (TestTokenV2) against bob's 5 LP (our registry), with all
-- four allocations authored against the trade's own settlement info. The
-- trade's single `admin` field only feeds MatchedTrade_RequestAllocations,
-- which a two-registry trade cannot use.
setupTwoAdminTrade : Party -> Party -> Script TwoAdminTrade
setupTwoAdminTrade alice bob = do
  fx <- setup alice
  now <- getTime
  let aliceAcct = Utils.basicAccount alice
      bobAcct = Utils.basicAccount bob
      xLeg = V2.TransferLeg with
        transferLegId = "trade-x"; sender = aliceAcct; receiver = bobAcct
        amount = 1.0; instrumentId = "X"; meta = emptyMetadata
      lpLeg = V2.TransferLeg with
        transferLegId = "trade-lp"; sender = bobAcct; receiver = aliceAcct
        amount = 5.0; instrumentId = lpId; meta = emptyMetadata
  bobLpHolding <- submit (actAs [fx.lpRegistrar, bob]) $ createCmd RegV2.Holding with
    admin = fx.lpRegistrar; owner = bob; instrumentId = lpId; amount = 5.0; locked = False
  tradeCid <- submit fx.operator $ createCmd MT.MatchedTrade with
    venue = fx.operator; admin = fx.ttAdmin
    transferLegs = [xLeg, lpLeg]
    settlementDeadline = None; policyReceipt = None
  trade <- fromSome <$> queryContractId fx.operator tradeCid
  let settlement = MT.mkTradeSettlementInfo tradeCid trade
  aliceX <- holdingCidsFor alice "X"
  xSender <- ttAlloc fx.ttReg alice settlement (mkSpec fx.ttAdmin aliceAcct [xLeg] False) aliceX now
  xReceiver <- ttAlloc fx.ttReg bob settlement (mkSpec fx.ttAdmin bobAcct [xLeg] False) [] now
  lpSender <- lpAlloc fx bob settlement (mkSpec fx.lpRegistrar bobAcct [lpLeg] False)
    [toInterfaceContractId bobLpHolding] now
  lpReceiver <- lpAlloc fx alice settlement (mkSpec fx.lpRegistrar aliceAcct [lpLeg] False) [] now
  disc <- ttSettleDisclosures fx
  pure TwoAdminTrade with
    fx; tradeCid; xLeg; lpLeg
    ttAllocations = map Utils.finalAllocation [xSender, xReceiver]
    lpAllocations = map Utils.finalAllocation [lpSender, lpReceiver]
    settleDisclosures = disc

-- The venue's settle, parameterized on what each batch is told to settle.
mkTwoAdminSettle
  : TwoAdminTrade -> Optional [V2.TransferLeg] -> Optional [V2.TransferLeg]
  -> Commands MT.MatchedTrade_SettleResult
mkTwoAdminSettle t ttLegs lpLegs =
  exerciseCmd t.tradeCid MT.MatchedTrade_Settle with
    batchesByAdmin = Map.fromList
      [ (t.fx.ttAdmin, MT.SettlementBatchV2 with
          transferLegs = ttLegs
          allocations = t.ttAllocations
          factoryCid = t.fx.ttSettleCid
          extraArgs = ExtraArgs with context = t.fx.ttContext; meta = emptyMetadata)
      , (t.fx.lpRegistrar, MT.SettlementBatchV2 with
          transferLegs = lpLegs
          allocations = t.lpAllocations
          factoryCid = coerceContractId t.fx.lpReg
          extraArgs = emptyExtraArgs)
      ]
    allocationRequests = []
    dexPairCid = None

-- readAs the LP registrar: our Holding is `signatory admin, owner`, so the
-- venue is not a stakeholder of the LP holding the settle archives.
twoAdminSubmitOptions : TwoAdminTrade -> SubmitOptions
twoAdminSubmitOptions t =
  actAs t.fx.operator <> readAs [t.fx.lpRegistrar] <> discloseMany' t.settleDisclosures

-- Handed the whole trade, a batch carries legs its own allocations do not
-- authorize and the registry rejects it; handed no legs at all, the settle
-- refuses rather than falling back to the trade's full list; handed its own
-- admin's legs, each batch covers them exactly and the trade settles across
-- both registries in one transaction. The rejected attempts commit nothing, so
-- the same allocations settle in the last phase.
-- | Proves a two-admin matched trade settles each admin's exact leg subset.
testMatchedTradeSettlesPerAdminLegSubsets : Script ()
testMatchedTradeSettlesPerAdminLegSubsets = do
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  t <- setupTwoAdminTrade alice bob
  let allLegs = Some [t.xLeg, t.lpLeg]
  rejected <- trySubmit (twoAdminSubmitOptions t) $ mkTwoAdminSettle t allLegs allLegs
  case rejected of
    Right _ -> abort "a batch given the full leg list must be rejected"
    Left e ->
      assertMsg ("expected missing authorizations, got: " <> show e)
        (T.isInfixOf "authorizations" (show e))

  omitted <- trySubmit (twoAdminSubmitOptions t) $ mkTwoAdminSettle t None None
  case omitted of
    Right _ -> abort "a batch with no transfer legs must be rejected"
    Left e ->
      assertMsg ("expected a required-legs abort, got: " <> show e)
        (T.isInfixOf "per-admin transfer legs are required" (show e))

  res <- submit (twoAdminSubmitOptions t) $
    mkTwoAdminSettle t (Some [t.xLeg]) (Some [t.lpLeg])
  Map.size res.resultsByAdmin === 2
  bobX <- holdingCidsFor bob "X"
  assertMsg "bob received the X leg" (not (null bobX))
  aliceHoldings <- query @RegV2.Holding alice
  length (filter (\(_, h) -> h.instrumentId == lpId && h.owner == alice && not h.locked) aliceHoldings) === 1
