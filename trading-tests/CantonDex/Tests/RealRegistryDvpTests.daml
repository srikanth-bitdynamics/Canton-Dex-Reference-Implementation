-- | Cross-registry settlement tests. Base and quote use the upstream
-- `TestTokenV2_RegistryV2`, whose choices require a disclosed `TokenRules`
-- contract. LP mint and burn use `Registry.V2`, which supports the owner=None
-- mint account and requires no choice context. The tests prove that each
-- admin's context reaches its own settlement batch.
-- Design context: `docs/concepts/design-tour.md#cross-registry-settlement`.
module CantonDex.Tests.RealRegistryDvpTests where

import DA.Assert
import DA.Foldable (foldMap, forA_)
import DA.List (head)
import DA.Map qualified as Map
import DA.Optional (fromSome, isNone)
import DA.Text qualified as T
import DA.TextMap qualified as TextMap
import DA.Time (addRelTime, hours)
import Daml.Script

import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.AllocationInstructionV2 qualified as V2
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.MetadataV1

import Splice.Testing.Utils (discloseMany', Disclosures', emptyExtraArgs)
import Splice.Testing.TokenStandard.RegistryApiV2
  (getAllocationFactory, getSettlementFactory)
import Splice.Testing.Registries.TestTokenV2_RegistryV2 qualified as TT2

import CantonDex.Dex.Pool
import CantonDex.Dex.PoolState qualified as PS
import CantonDex.Dex.PoolModel qualified as PM
import CantonDex.Dex.MatchedTrade qualified as MT
import CantonDex.Dex.PoolLiquidityRules qualified as Dvp
import CantonDex.Dex.PoolRules qualified as PRules
import CantonDex.Dex.LiquidityAllocationRequest qualified as LAR
import CantonDex.Dex.Order qualified as Order
import CantonDex.Dex.OrderFundingRequest qualified as OFR
import CantonDex.Dex.OrderMatchExecution qualified as OME
import CantonDex.Lp.Policy qualified as LP
import CantonDex.Lp.Instrument qualified as Lp
import CantonDex.Registry.V2 qualified as RegV2
import CantonDex.Trading.Utils qualified as Utils
import CantonDex.Trading.AdminBatch qualified as AB

lpId : Text
lpId = "BTC-USDC-LP"

-- Collect the LP's unlocked V2 holding contract ids for an instrument.
holdingCidsFor : Party -> Text -> Script [ContractId V2.Holding]
holdingCidsFor owner instrId = do
  hs <- queryInterface @V2.Holding owner
  pure [ cid | (cid, Some v) <- hs, v.instrumentId.id == instrId, v.account.owner == Some owner, isNone v.lock ]

-- Read the amounts from those holdings.
unlockedAmountsFor : Party -> Text -> Script [Decimal]
unlockedAmountsFor owner instrId = do
  hs <- queryInterface @V2.Holding owner
  pure [ v.amount | (_, Some v) <- hs, v.instrumentId.id == instrId, v.account.owner == Some owner, isNone v.lock ]

-- Author an LP allocation through the reference registry, which needs no choice
-- context. `readAs` models the factory disclosure supplied by an integration.
lpAlloc
  : Fixture -> Party -> V2.SettlementInfo -> V2.AllocationSpecification
  -> [ContractId V2.Holding] -> Time -> Script (ContractId V2.Allocation)
lpAlloc fx party settlement spec inputHoldingCids now = do
  res <- submit (actAs party <> readAs [fx.lpRegistrar]) $
    exerciseCmd (toInterfaceContractId fx.lpReg : ContractId V2.AllocationFactory)
      V2.AllocationFactory_Allocate with
        settlement; allocation = spec; requestedAt = now
        inputHoldingCids; actors = [party]; extraArgs = emptyExtraArgs
  case res.output of
    V2.AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "lpAlloc: allocation must complete"

-- Author an allocation through the TestTokenV2 registry: enrich the factory
-- choice with TokenRules context and disclosure, then submit it as `party`.
ttAlloc
  : TT2.TestTokenV2Registry -> Party -> V2.SettlementInfo -> V2.AllocationSpecification
  -> [ContractId V2.Holding] -> Time -> Script (ContractId V2.Allocation)
ttAlloc reg party settlement spec inputHoldingCids now = do
  enriched <- getAllocationFactory reg V2.AllocationFactory_Allocate with
    settlement; allocation = spec; requestedAt = now
    inputHoldingCids; actors = [party]; extraArgs = emptyExtraArgs
  res <- submit (actAs party <> discloseMany' enriched.disclosures) $
    exerciseCmd enriched.factoryCid enriched.arg
  case res.output of
    V2.AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "ttAlloc: allocation must complete"

mkSpec : Party -> V2.Account -> [V2.TransferLeg] -> Bool -> V2.AllocationSpecification
mkSpec admin authorizer legs committed = V2.AllocationSpecification with
  admin; authorizer
  transferLegSides = Utils.legsToSides authorizer legs
  settlementDeadline = None; nextIterationFunding = None; committed
  meta = emptyMetadata

-- The add flow's deposit specs are iterated-enabled, so the settle can attach
-- the off-ratio refund leg.
depositSpec : Party -> V2.Account -> V2.TransferLeg -> V2.AllocationSpecification
depositSpec admin authorizer leg =
  (mkSpec admin authorizer [leg] True) with nextIterationFunding = Some TextMap.empty

data Fixture = Fixture with
  operator : Party
  lpRegistrar : Party
  ttAdmin : Party
  ttReg : TT2.TestTokenV2Registry
  lpReg : ContractId RegV2.Registry      -- our V2 self-registry (LP side)
  poolId : PoolId
  poolCid : ContractId Pool
  stateCid : ContractId PS.PoolState
  policyCid : ContractId LP.LPTokenPolicy
  dvpCid : ContractId Dvp.PoolLiquidityRules
  rulesCid : ContractId PRules.PoolRules

-- base = "X", quote = "Y" (TestTokenV2 instruments administered by ttAdmin).
setup : Party -> Script Fixture
setup lp = do
  operator <- allocateParty "operator"
  lpRegistrar <- allocateParty "lp-registrar"
  ttReg <- TT2.initialize TT2.defaultTestTokenV2RegistryConfig
  let ttAdmin = ttReg.admin
  -- LP side: our context-free, mint-capable self-registry.
  lpRegCid <- submit lpRegistrar $ createCmd RegV2.Registry with
    admin = lpRegistrar; users = [operator, lp]
  -- Mint the LP's base and quote TestTokenV2 holdings.
  TT2.mint ttReg (Utils.basicAccount lp) "X" 10.0
  TT2.mint ttReg (Utils.basicAccount lp) "Y" 200000.0
  let poolId = "X-Y"
      lpInstrumentId = V2.InstrumentId with admin = lpRegistrar; id = lpId
  poolCid <- submit operator $ createCmd Pool with
    poolId; operator; lpRegistrar
    baseInstrumentId = V2.InstrumentId with admin = ttAdmin; id = "X"
    quoteInstrumentId = V2.InstrumentId with admin = ttAdmin; id = "Y"
    lpInstrumentId
    feeBps = 30
  stateCid <- submit operator $ createCmd PS.PoolState with
    poolId; operator; lpRegistrar
    status = PS_Unfunded
    reserves = PoolReserves with baseAmount = 0.0; quoteAmount = 0.0
    totalLpSupply = 0.0; publicReaders = []
  dvpCid <- submit (actAs [operator, lpRegistrar]) $
    createCmd Dvp.PoolLiquidityRules with operator; lpRegistrar
  rulesCid <- submit operator $ createCmd PRules.PoolRules with operator
  policyCid <- submit lpRegistrar $ createCmd LP.LPTokenPolicy with
    lpRegistrar; operator; lpInstrumentId
    totalSupply = 0.0; active = True
  pure Fixture with
    operator; lpRegistrar; ttAdmin; ttReg; lpReg = lpRegCid
    poolId; poolCid; stateCid; policyCid; dvpCid; rulesCid

-- Author the LP's three add allocations and return them with the request.
authorAdd
  : Fixture -> Party -> Decimal -> Decimal -> Time
  -> Script ( ContractId LAR.LiquidityAllocationRequest
            , ContractId V2.Allocation, ContractId V2.Allocation, ContractId V2.Allocation )
authorAdd fx lp baseAmount quoteAmount now = do
  let lpAcct = Utils.basicAccount lp
      opAcct = Utils.basicAccount fx.operator
      settlement = PM.poolSettlement fx.poolCid fx.operator
      lpAmount = PM.sqrtDecimal (baseAmount * quoteAmount)
      baseLeg = V2.TransferLeg with
        transferLegId = "lp-base-deposit"; sender = lpAcct; receiver = opAcct
        amount = baseAmount; instrumentId = "X"; meta = emptyMetadata
      quoteLeg = V2.TransferLeg with
        transferLegId = "lp-quote-deposit"; sender = lpAcct; receiver = opAcct
        amount = quoteAmount; instrumentId = "Y"; meta = emptyMetadata
      lpMintLeg = Lp.lpMintLeg lpAcct lpId lpAmount
  reqCid <- submit fx.operator $ exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_RequestAddLiquidity with
    poolCid = fx.poolCid; recipient = lp; baseAmount; quoteAmount; lpAmount
    requestedAt = now; settleAt = None
  baseCids <- holdingCidsFor lp "X"
  quoteCids <- holdingCidsFor lp "Y"
  -- Base and quote deposits use the TestTokenV2 registry.
  baseDep <- ttAlloc fx.ttReg lp settlement (depositSpec fx.ttAdmin lpAcct baseLeg) baseCids now
  quoteDep <- ttAlloc fx.ttReg lp settlement (depositSpec fx.ttAdmin lpAcct quoteLeg) quoteCids now
  -- LP mint receipt via our self-registry (mint account, no context).
  let receiptSpec = mkSpec fx.lpRegistrar lpAcct [lpMintLeg] False
  rres <- submit lp $ exerciseCmd (toInterfaceContractId fx.lpReg : ContractId V2.AllocationFactory)
    V2.AllocationFactory_Allocate with
      settlement; allocation = receiptSpec; requestedAt = now
      inputHoldingCids = []; actors = [lp]; extraArgs = emptyExtraArgs
  let V2.AllocationInstructionResult_Completed receiptCid = rres.output
  pure (reqCid, baseDep, quoteDep, receiptCid)

data StagedAddSettlement = StagedAddSettlement with
    requestedAt : Time
    baseFactoryCid : ContractId V2.AllocationFactory
    quoteFactoryCid : ContractId V2.AllocationFactory
    lpFactoryCid : ContractId V2.AllocationFactory
    operatorBaseReceiverCid : ContractId V2.Allocation
    operatorQuoteReceiverCid : ContractId V2.Allocation
    registrarMintCid : ContractId V2.Allocation
    baseQuoteSettleCid : ContractId V2.SettlementFactory
    poolAdminExtraArgs : ExtraArgs
    disclosures : Disclosures'

data StagedRemoveSettlement = StagedRemoveSettlement with
    requestedAt : Time
    lpFactoryCid : ContractId V2.AllocationFactory
    registrarBurnReceiverCid : ContractId V2.Allocation
    baseQuoteSettleCid : ContractId V2.SettlementFactory
    poolAdminExtraArgs : ExtraArgs
    disclosures : Disclosures'

completeTtAllocation
  : Fixture -> Party -> V2.AllocationFactory_Allocate
  -> Script (ContractId V2.AllocationFactory, ContractId V2.Allocation)
completeTtAllocation fx actor allocationArg = do
  enriched <- getAllocationFactory fx.ttReg allocationArg
  result <- submit (actAs actor <> discloseMany' enriched.disclosures) $
    exerciseCmd enriched.factoryCid enriched.arg
  case result.output of
    V2.AllocationInstructionResult_Completed cid -> pure (enriched.factoryCid, cid)
    _ -> abort "TestTokenV2 planned allocation must complete"

completeLpAllocation
  : Fixture -> Party -> V2.AllocationFactory_Allocate
  -> Script (ContractId V2.AllocationFactory, ContractId V2.Allocation)
completeLpAllocation fx actor allocationArg = do
  let factoryCid = toInterfaceContractId fx.lpReg : ContractId V2.AllocationFactory
  result <- submit (actAs actor <> readAs [fx.lpRegistrar]) $
    exerciseCmd factoryCid allocationArg
  case result.output of
    V2.AllocationInstructionResult_Completed cid -> pure (factoryCid, cid)
    _ -> abort "LP planned allocation must complete"

stageAddSettlement
  : Fixture -> Dvp.AddLiquidityPreparationArgs -> Time
  -> Script StagedAddSettlement
stageAddSettlement fx preparation requestedAt = do
  allocationPlan <- submit (actAs [fx.operator, fx.lpRegistrar]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_PreviewAddAllocations with
      preparation
      requestedAt
  (baseFactoryCid, operatorBaseReceiverCid) <-
    completeTtAllocation fx fx.operator allocationPlan.baseReceiver
  (quoteFactoryCid, operatorQuoteReceiverCid) <-
    completeTtAllocation fx fx.operator allocationPlan.quoteReceiver
  (lpFactoryCid, registrarMintCid) <-
    completeLpAllocation fx fx.lpRegistrar allocationPlan.lpMintSender
  settlementPlan <- submit (actAs [fx.operator, fx.lpRegistrar]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_PreviewAddSettlement with
      preparation
      operatorBaseReceiverCid
      operatorQuoteReceiverCid
      registrarMintCid
  -- Base and quote are both administered by ttAdmin, so their batches collapse
  -- to one; discover its factory context.
  enriched <- getSettlementFactory fx.ttReg (fromSome (Map.lookup fx.ttAdmin settlementPlan))
  pure StagedAddSettlement with
    requestedAt
    baseFactoryCid
    quoteFactoryCid
    lpFactoryCid
    operatorBaseReceiverCid
    operatorQuoteReceiverCid
    registrarMintCid
    baseQuoteSettleCid = enriched.factoryCid
    poolAdminExtraArgs = enriched.arg.extraArgs
    disclosures = enriched.disclosures

stageRemoveSettlement
  : Fixture -> Dvp.RemoveLiquidityPreparationArgs -> Time
  -> Script StagedRemoveSettlement
stageRemoveSettlement fx preparation requestedAt = do
  allocationPlan <- submit (actAs [fx.operator, fx.lpRegistrar]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_PreviewRemoveAllocations with
      preparation
      requestedAt
  (lpFactoryCid, registrarBurnReceiverCid) <-
    completeLpAllocation fx fx.lpRegistrar allocationPlan.lpBurnReceiver
  settlementPlan <- submit (actAs [fx.operator, fx.lpRegistrar]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_PreviewRemoveSettlement with
      preparation
      registrarBurnReceiverCid
  enriched <- getSettlementFactory fx.ttReg (fromSome (Map.lookup fx.ttAdmin settlementPlan))
  pure StagedRemoveSettlement with
    requestedAt
    lpFactoryCid
    registrarBurnReceiverCid
    baseQuoteSettleCid = enriched.factoryCid
    poolAdminExtraArgs = enriched.arg.extraArgs
    disclosures = enriched.disclosures

-- Build the DvP-add command after every exact factory choice has been
-- discovered. The context parameter is exposed only for the negative test
-- that proves TestTokenV2 rejects an omitted operation-specific context.
mkSettleAdd
  : Fixture
  -> Dvp.AddLiquidityPreparationArgs
  -> StagedAddSettlement
  -> ExtraArgs
  -> Commands Dvp.PoolLiquidityRules_SettleAddResult
mkSettleAdd fx preparation staged poolAdminExtraArgs =
  exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_SettleAddLiquidity with
    expectedPoolId = preparation.expectedPoolId
    poolCid = preparation.poolCid
    poolStateCid = preparation.poolStateCid
    lpPolicyCid = preparation.lpPolicyCid
    requestCid = preparation.requestCid
    acceptanceCid = preparation.acceptanceCid
    recipient = preparation.recipient
    lpBaseDepositCid = preparation.lpBaseDepositCid
    lpQuoteDepositCid = preparation.lpQuoteDepositCid
    lpReceiptCid = preparation.lpReceiptCid
    baseFactoryCid = staged.baseFactoryCid
    quoteFactoryCid = staged.quoteFactoryCid
    lpFactoryCid = staged.lpFactoryCid
    baseAmount = preparation.baseAmount
    quoteAmount = preparation.quoteAmount
    minLpTokens = preparation.minLpTokens
    knownTotalLpSupply = preparation.knownTotalLpSupply
    requestedAt = staged.requestedAt
    batchesByAdmin = Map.fromList
      [ (fx.ttAdmin, AB.RegistryBatchInput staged.baseQuoteSettleCid poolAdminExtraArgs)
      , (fx.lpRegistrar, AB.RegistryBatchInput (coerceContractId fx.lpReg) emptyExtraArgs)
      ]
    operatorBaseReceiverCid = Some staged.operatorBaseReceiverCid
    operatorQuoteReceiverCid = Some staged.operatorQuoteReceiverCid
    registrarMintCid = Some staged.registrarMintCid
    allocationContextByAdmin = Map.empty

-- Run a full DvP add and return its result for tests that need a funded pool.
addSettle : Fixture -> Party -> Time -> Script Dvp.PoolLiquidityRules_SettleAddResult
addSettle fx lp now = do
  (reqCid, baseDep, quoteDep, receiptCid) <- authorAdd fx lp 10.0 200000.0 now
  let preparation = Dvp.AddLiquidityPreparationArgs with
        expectedPoolId = fx.poolId; poolCid = fx.poolCid; poolStateCid = fx.stateCid
        lpPolicyCid = fx.policyCid; requestCid = Some reqCid; acceptanceCid = None
        recipient = lp
        lpBaseDepositCid = baseDep; lpQuoteDepositCid = quoteDep; lpReceiptCid = receiptCid
        baseAmount = 10.0; quoteAmount = 200000.0
        minLpTokens = 0.0; knownTotalLpSupply = 0.0
  staged <- stageAddSettlement fx preparation now
  submit (foldMap actAs [fx.operator, fx.lpRegistrar] <> discloseMany' staged.disclosures) $
    mkSettleAdd fx preparation staged staged.poolAdminExtraArgs

-- A DvP add settles across both registries when the base/quote batch receives
-- the TestTokenV2 context. The pool becomes active, its reserves are backed by
-- allocations, and the LP receives newly minted LP tokens.
-- | Proves cross-registry add-liquidity settles deposits and LP mint atomically.
testRealRegistryDvpAddSettles : Script ()
testRealRegistryDvpAddSettles = do
  lp <- allocateParty "lp"
  fx <- setup lp
  now <- getTime
  res <- addSettle fx lp now
  Some state <- queryContractId fx.operator res.poolStateCid
  state.status === PS_Active
  state.reserves.baseAmount === 10.0
  state.reserves.quoteAmount === 200000.0
  res.lpTokensMinted === PM.sqrtDecimal 2000000.0
  -- The LP received the minted LP holding from the reference registry.
  lpHoldings <- query @RegV2.Holding lp
  let mintedLp = filter (\(_, h) -> h.instrumentId == lpId && h.owner == lp && not h.locked) lpHoldings
  length mintedLp === 1

-- Without poolAdminExtraArgs, the context-requiring base/quote factory rejects
-- the missing `testTokenV2/tokenRules` value before settlement.
-- | Proves a context-requiring upstream registry rejects missing choice context.
testRealRegistryDvpRejectsMissingContext : Script ()
testRealRegistryDvpRejectsMissingContext = do
  lp <- allocateParty "lp"
  fx <- setup lp
  now <- getTime
  (reqCid, baseDep, quoteDep, receiptCid) <- authorAdd fx lp 10.0 200000.0 now
  let preparation = Dvp.AddLiquidityPreparationArgs with
        expectedPoolId = fx.poolId; poolCid = fx.poolCid; poolStateCid = fx.stateCid
        lpPolicyCid = fx.policyCid; requestCid = Some reqCid; acceptanceCid = None
        recipient = lp
        lpBaseDepositCid = baseDep; lpQuoteDepositCid = quoteDep; lpReceiptCid = receiptCid
        baseAmount = 10.0; quoteAmount = 200000.0
        minLpTokens = 0.0; knownTotalLpSupply = 0.0
  staged <- stageAddSettlement fx preparation now
  result <- trySubmit
    (foldMap actAs [fx.operator, fx.lpRegistrar] <> discloseMany' staged.disclosures) $
    mkSettleAdd fx preparation staged emptyExtraArgs
  case result of
    Right _ -> abort "expected a missing-context failure"
    Left e ->
      assertMsg ("expected missing tokenRules context, got: " <> show e)
        (T.isInfixOf "tokenRules" (show e))

-- An off-ratio add takes only the ratio-matched part of the deposit. The
-- upstream registry returns the unmatched remainder as an unlocked holding.
-- | Proves cross-registry add refunds off-ratio excess as unlocked holdings.
testRealRegistryDvpAddRefundsOffRatioExcess : Script ()
testRealRegistryDvpAddRefundsOffRatioExcess = do
  lp <- allocateParty "lp"
  fx <- setup lp
  now <- getTime
  addRes <- addSettle fx lp now
  let supply = PM.sqrtDecimal 2000000.0
      lpAcct = Utils.basicAccount lp
      opAcct = Utils.basicAccount fx.operator
      settlement = PM.poolSettlement fx.poolCid fx.operator
      -- 5 X + 150000 Y into a 10 : 200000 pool: base limits, so 50000 Y is
      -- unmatched and must come back.
      baseAmount = 5.0
      quoteAmount = 150000.0
      lpAmount = (baseAmount * supply) / 10.0
      baseLeg = V2.TransferLeg with
        transferLegId = "lp-base-deposit"; sender = lpAcct; receiver = opAcct
        amount = baseAmount; instrumentId = "X"; meta = emptyMetadata
      quoteLeg = V2.TransferLeg with
        transferLegId = "lp-quote-deposit"; sender = lpAcct; receiver = opAcct
        amount = quoteAmount; instrumentId = "Y"; meta = emptyMetadata
      lpMintLeg = Lp.lpMintLeg lpAcct lpId lpAmount
  TT2.mint fx.ttReg lpAcct "X" baseAmount
  TT2.mint fx.ttReg lpAcct "Y" quoteAmount
  reqCid <- submit fx.operator $ exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_RequestAddLiquidity with
    poolCid = fx.poolCid; recipient = lp; baseAmount; quoteAmount; lpAmount
    requestedAt = now; settleAt = None
  baseCids <- holdingCidsFor lp "X"
  quoteCids <- holdingCidsFor lp "Y"
  baseDep <- ttAlloc fx.ttReg lp settlement (depositSpec fx.ttAdmin lpAcct baseLeg) baseCids now
  quoteDep <- ttAlloc fx.ttReg lp settlement (depositSpec fx.ttAdmin lpAcct quoteLeg) quoteCids now
  rres <- submit lp $ exerciseCmd (toInterfaceContractId fx.lpReg : ContractId V2.AllocationFactory)
    V2.AllocationFactory_Allocate with
      settlement; allocation = mkSpec fx.lpRegistrar lpAcct [lpMintLeg] False; requestedAt = now
      inputHoldingCids = []; actors = [lp]; extraArgs = emptyExtraArgs
  let V2.AllocationInstructionResult_Completed receiptCid = rres.output
  let preparation = Dvp.AddLiquidityPreparationArgs with
        expectedPoolId = fx.poolId; poolCid = fx.poolCid; poolStateCid = addRes.poolStateCid
        lpPolicyCid = addRes.lpPolicyCid; requestCid = Some reqCid; acceptanceCid = None
        recipient = lp
        lpBaseDepositCid = baseDep; lpQuoteDepositCid = quoteDep; lpReceiptCid = receiptCid
        baseAmount; quoteAmount; minLpTokens = 0.0; knownTotalLpSupply = supply
  staged <- stageAddSettlement fx preparation now
  res <- submit
    (foldMap actAs [fx.operator, fx.lpRegistrar] <> discloseMany' staged.disclosures) $
    mkSettleAdd fx preparation staged staged.poolAdminExtraArgs
  res.baseAdded === Some 5.0
  res.quoteAdded === Some 100000.0
  Some state <- queryContractId fx.operator res.poolStateCid
  state.reserves.baseAmount === 15.0
  state.reserves.quoteAmount === 300000.0
  refundedY <- unlockedAmountsFor lp "Y"
  refundedX <- unlockedAmountsFor lp "X"
  refundedY === [50000.0]
  refundedX === []

-- After funding the pool, the holder redeems the full position. TestTokenV2
-- delivers base and quote from the pool slices, and the reference registry burns
-- the LP tokens.
-- | Proves cross-registry remove pays reserves and burns LP tokens atomically.
testRealRegistryDvpRemoveSettles : Script ()
testRealRegistryDvpRemoveSettles = do
  alice <- allocateParty "lp"
  fx <- setup alice
  now <- getTime
  addRes <- addSettle fx alice now
  let lpAmount = PM.sqrtDecimal 2000000.0
      aliceAcct = Utils.basicAccount alice
      opAcct = Utils.basicAccount fx.operator
      settlement = PM.poolSettlement fx.poolCid fx.operator
      baseOutLeg = V2.TransferLeg with
        transferLegId = "lp-base-out-0"; sender = opAcct; receiver = aliceAcct
        amount = 10.0; instrumentId = "X"; meta = emptyMetadata
      quoteOutLeg = V2.TransferLeg with
        transferLegId = "lp-quote-out-0"; sender = opAcct; receiver = aliceAcct
        amount = 200000.0; instrumentId = "Y"; meta = emptyMetadata
      burnLeg = Lp.lpBurnLeg aliceAcct lpId lpAmount
  -- alice's LP holding, to lock for the burn (on our registry).
  aliceHs <- query @RegV2.Holding alice
  let (lpHoldCid, _) = head (filter (\(_, h) -> h.instrumentId == lpId && not h.locked) aliceHs)
  reqCid <- submit fx.operator $ exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_RequestRemoveLiquidity with
    poolCid = fx.poolCid; holder = alice; baseOuts = [10.0]; quoteOuts = [200000.0]
    lpBurnAmount = lpAmount; requestedAt = now; settleAt = None
  -- Base/quote receipts use TestTokenV2; the burn sender uses our registry.
  baseReceipt <- ttAlloc fx.ttReg alice settlement (mkSpec fx.ttAdmin aliceAcct [baseOutLeg] False) [] now
  quoteReceipt <- ttAlloc fx.ttReg alice settlement (mkSpec fx.ttAdmin aliceAcct [quoteOutLeg] False) [] now
  brres <- submit alice $ exerciseCmd (toInterfaceContractId fx.lpReg : ContractId V2.AllocationFactory)
    V2.AllocationFactory_Allocate with
      settlement; allocation = mkSpec fx.lpRegistrar aliceAcct [burnLeg] True; requestedAt = now
      inputHoldingCids = [toInterfaceContractId lpHoldCid]; actors = [alice]; extraArgs = emptyExtraArgs
  let V2.AllocationInstructionResult_Completed burnSender = brres.output
  let preparation = Dvp.RemoveLiquidityPreparationArgs with
        expectedPoolId = fx.poolId; poolCid = fx.poolCid
        poolStateCid = addRes.poolStateCid; lpPolicyCid = addRes.lpPolicyCid
        requestCid = Some reqCid; acceptanceCid = None
        holder = alice; lpTokensToRedeem = lpAmount; knownTotalLpSupply = lpAmount
        minBaseOut = 0.0; minQuoteOut = 0.0
        baseSliceCids = [addRes.baseSliceCid]; quoteSliceCids = [addRes.quoteSliceCid]
        holderBaseReceiptCid = baseReceipt; holderQuoteReceiptCid = quoteReceipt
        holderBurnSenderCid = burnSender
  staged <- stageRemoveSettlement fx preparation now
  remRes <- submit
    (foldMap actAs [fx.operator, fx.lpRegistrar] <> discloseMany' staged.disclosures) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_SettleRemoveLiquidity with
      expectedPoolId = preparation.expectedPoolId
      poolCid = preparation.poolCid
      poolStateCid = preparation.poolStateCid
      lpPolicyCid = preparation.lpPolicyCid
      requestCid = preparation.requestCid
      acceptanceCid = preparation.acceptanceCid
      holder = preparation.holder
      lpTokensToRedeem = preparation.lpTokensToRedeem
      knownTotalLpSupply = preparation.knownTotalLpSupply
      minBaseOut = preparation.minBaseOut
      minQuoteOut = preparation.minQuoteOut
      baseSliceCids = preparation.baseSliceCids
      quoteSliceCids = preparation.quoteSliceCids
      holderBaseReceiptCid = preparation.holderBaseReceiptCid
      holderQuoteReceiptCid = preparation.holderQuoteReceiptCid
      holderBurnSenderCid = preparation.holderBurnSenderCid
      lpFactoryCid = staged.lpFactoryCid
      requestedAt = staged.requestedAt
      batchesByAdmin = Map.fromList
        [ (fx.ttAdmin, AB.RegistryBatchInput staged.baseQuoteSettleCid staged.poolAdminExtraArgs)
        , (fx.lpRegistrar, AB.RegistryBatchInput (coerceContractId fx.lpReg) emptyExtraArgs)
        ]
      registrarBurnReceiverCid = Some staged.registrarBurnReceiverCid
      allocationContextByAdmin = Map.empty
  Some state <- queryContractId fx.operator remRes.poolStateCid
  state.reserves.baseAmount === 0.0
  state.reserves.quoteAmount === 0.0
  state.status === PS_Unfunded
  remRes.baseReturned === 10.0
  remRes.quoteReturned === 200000.0
  -- LP burned; alice received base/quote back as TestTokenV2 holdings.
  after <- query @RegV2.Holding alice
  length (filter (\(_, h) -> h.instrumentId == lpId && h.owner == alice) after) === 0
  baseBack <- holdingCidsFor alice "X"
  quoteBack <- holdingCidsFor alice "Y"
  assertMsg "alice received base (X) back" (not (null baseBack))
  assertMsg "alice received quote (Y) back" (not (null quoteBack))

-- Swap through the TestTokenV2 registry using the dApp's DvP shape. After
-- funding the pool, Bob swaps quote (Y) for base (X):
--   1. operator builds bob's exact two-sided allocation spec via
--      PoolRules_RequestSwap (the dApp POST /v1/pools/swap/request path);
--   2. bob authors that exact spec through the TestTokenV2 registry,
--      locking his Y holdings (mirrors the wallet's AllocationFactory_Allocate);
--   3. operator settles via PoolRules_Swap against its SettlementFactory,
--      threading the per-admin context and disclosures.
-- The assertions cover reserve movement and the receiver's output holding.
-- | Proves a signed swap moves real holdings through the upstream registry.
testRealRegistryDvpSwapSettles : Script ()
testRealRegistryDvpSwapSettles = do
  bob <- allocateParty "lp"      -- LP/funder
  fx <- setup bob
  now <- getTime
  addRes <- addSettle fx bob now

  -- Mint enough quote for one deliberately underpaying allocation and the real
  -- swap allocation, so the negative check cannot consume the real input.
  let swapIn = 1000.0
  TT2.mint fx.ttReg (Utils.basicAccount bob) "Y" (2.0 * swapIn)

  let quoteBinding = Some (PRules.SwapQuoteBinding with
        expectedPoolId = fx.poolId
        poolStateCid = addRes.poolStateCid
        inputSliceCid = addRes.quoteSliceCid
        outputSliceCids = [addRes.baseSliceCid]
        minOutputAmount = 0.0)
  -- 1. Operator builds the exact two-sided allocation spec. X and Y share
  --    ttAdmin, so the swapper authorizes one combined allocation.
  reqRes <- submit fx.operator $ exerciseCmd fx.rulesCid PRules.PoolRules_RequestSwap with
    poolCid = fx.poolCid
    swapper = bob
    inputInstrumentId = V2.InstrumentId with admin = fx.ttAdmin; id = "Y"
    inputAmount = swapIn
    requestedAt = now
    settleAt = None
    quoteBinding
  let swapSpec = head reqRes.allocationSpecs
  swapSpec.nextIterationFunding === None
  swapSpec.committed === False
  let senderSides = filter (\side -> side.side == V2.SenderSide)
        swapSpec.transferLegSides
      receiverSides = filter (\side -> side.side == V2.ReceiverSide)
        swapSpec.transferLegSides
  map (.instrumentId) senderSides === ["Y"]
  map (.amount) senderSides === [swapIn]
  map (.instrumentId) receiverSides === ["X"]
  assertMsg "swap request must bind a positive output" (sum (map (.amount) receiverSides) > 0.0)

  -- Even a one-ulp reduction in the signed receiver side cannot settle. The
  -- pool choice recomputes the output from the bound state, and SettleBatch
  -- requires the allocation to authorize that exact leg.
  let underpaySpec = swapSpec with
        transferLegSides = map
          (\side -> if side.side == V2.ReceiverSide
            then side with amount = side.amount - 0.0000000001
            else side)
          swapSpec.transferLegSides
  underpayInputs <- holdingCidsFor bob "Y"
  underpayCid <- ttAlloc fx.ttReg bob reqRes.settlement underpaySpec underpayInputs now
  malformedPlan <- submit fx.operator $
    exerciseCmd fx.rulesCid PRules.PoolRules_PreviewSwapSettlement with
      expectedPoolId = fx.poolId; poolCid = fx.poolCid
      poolStateCid = addRes.poolStateCid
      swapperAccount = Utils.basicAccount bob
      inputInstrumentId = (V2.InstrumentId with admin = fx.ttAdmin; id = "Y"); inputAmount = swapIn; minOutputAmount = 0.0
      swapperAllocationCidsByAdmin = Map.fromList [(fx.ttAdmin, underpayCid)]
      inputSliceCid = addRes.quoteSliceCid
      outputSliceCids = [addRes.baseSliceCid]
      quoteBinding = reqRes.quoteBinding
  malformedSettlement <- getSettlementFactory fx.ttReg (fromSome (Map.lookup fx.ttAdmin malformedPlan))
  submitMustFail
    (actAs fx.operator <> discloseMany' malformedSettlement.disclosures) $
    exerciseCmd fx.rulesCid PRules.PoolRules_Swap with
      expectedPoolId = fx.poolId; poolCid = fx.poolCid
      poolStateCid = addRes.poolStateCid
      swapperAccount = Utils.basicAccount bob
      inputInstrumentId = (V2.InstrumentId with admin = fx.ttAdmin; id = "Y"); inputAmount = swapIn; minOutputAmount = 0.0
      swapperAllocationCidsByAdmin = Map.fromList [(fx.ttAdmin, underpayCid)]
      inputSliceCid = addRes.quoteSliceCid
      outputSliceCids = [addRes.baseSliceCid]
      batchesByAdmin = Map.fromList
        [(fx.ttAdmin, AB.RegistryBatchInput malformedSettlement.factoryCid malformedSettlement.arg.extraArgs)]
      swapAllocationRequestCids = []
      quoteBinding = reqRes.quoteBinding

  -- 2. Bob authors that exact spec via the upstream TestTokenV2 registry,
  --    locking his Y input holdings.
  quoteIn <- holdingCidsFor bob "Y"
  swapAllocCid <- ttAlloc fx.ttReg bob reqRes.settlement swapSpec quoteIn now

  -- 3. Operator settles the swap via PoolRules_Swap against the upstream
  --    TestTokenV2 SettlementFactory, with the per-admin context.
  settlementPlan <- submit fx.operator $
    exerciseCmd fx.rulesCid PRules.PoolRules_PreviewSwapSettlement with
      expectedPoolId = fx.poolId; poolCid = fx.poolCid
      poolStateCid = addRes.poolStateCid
      swapperAccount = Utils.basicAccount bob
      inputInstrumentId = (V2.InstrumentId with admin = fx.ttAdmin; id = "Y"); inputAmount = swapIn; minOutputAmount = 0.0
      swapperAllocationCidsByAdmin = Map.fromList [(fx.ttAdmin, swapAllocCid)]
      inputSliceCid = addRes.quoteSliceCid
      outputSliceCids = [addRes.baseSliceCid]
      quoteBinding = reqRes.quoteBinding
  settlement <- getSettlementFactory fx.ttReg (fromSome (Map.lookup fx.ttAdmin settlementPlan))
  swapRes <- submit (actAs fx.operator <> discloseMany' settlement.disclosures) $
    exerciseCmd fx.rulesCid PRules.PoolRules_Swap with
      expectedPoolId = fx.poolId; poolCid = fx.poolCid
      poolStateCid = addRes.poolStateCid
      swapperAccount = Utils.basicAccount bob
      inputInstrumentId = (V2.InstrumentId with admin = fx.ttAdmin; id = "Y"); inputAmount = swapIn; minOutputAmount = 0.0
      swapperAllocationCidsByAdmin = Map.fromList [(fx.ttAdmin, swapAllocCid)]
      inputSliceCid = addRes.quoteSliceCid
      outputSliceCids = [addRes.baseSliceCid]
      batchesByAdmin = Map.fromList
        [(fx.ttAdmin, AB.RegistryBatchInput settlement.factoryCid settlement.arg.extraArgs)]
      swapAllocationRequestCids = [reqRes.swapRequestCid]
      quoteBinding = reqRes.quoteBinding

  Some state <- queryContractId fx.operator swapRes.poolStateCid
  assertMsg "quote reserve increased after swap" (state.reserves.quoteAmount > 200000.0)
  assertMsg "base reserve decreased after swap" (state.reserves.baseAmount < 10.0)
  assertMsg "swap via RequestSwap produced output" (swapRes.amountOut > 0.0)
  -- Bob received base (X) as a TestTokenV2 holding.
  bobBase <- holdingCidsFor bob "X"
  assertMsg "bob received base (X) from the swap" (not (null bobBase))

-- A matched trade whose legs live under different registries: the X leg
-- under the upstream TestTokenV2 registry, the LP leg under ours. The Token
-- Standard requires a batch's allocations to cover exactly the legs the batch
-- is handed, so each admin's batch must carry only its own admin's legs.
data TwoAdminTrade = TwoAdminTrade with
    fx : Fixture
    tradeCid : ContractId MT.MatchedTrade
    xLeg : V2.TransferLeg
    lpLeg : V2.TransferLeg
    ttAllocations : [V2.FinalizedAllocation]
    lpAllocations : [V2.FinalizedAllocation]

-- alice sends 1 X (TestTokenV2) against bob's 5 LP (our registry), with all
-- four allocations authored against the trade's own settlement info. The
-- trade's single `admin` field only feeds MatchedTrade_RequestAllocations,
-- which a two-registry trade cannot use.
setupTwoAdminTrade : Party -> Party -> Script TwoAdminTrade
setupTwoAdminTrade alice bob = do
  fx <- setup alice
  now <- getTime
  let aliceAcct = Utils.basicAccount alice
      bobAcct = Utils.basicAccount bob
      xLeg = V2.TransferLeg with
        transferLegId = "trade-x"; sender = aliceAcct; receiver = bobAcct
        amount = 1.0; instrumentId = "X"; meta = emptyMetadata
      lpLeg = V2.TransferLeg with
        transferLegId = "trade-lp"; sender = bobAcct; receiver = aliceAcct
        amount = 5.0; instrumentId = lpId; meta = emptyMetadata
  bobLpHolding <- submit (actAs [fx.lpRegistrar, bob]) $ createCmd RegV2.Holding with
    admin = fx.lpRegistrar; owner = bob; instrumentId = lpId; amount = 5.0; locked = False
  tradeCid <- submit fx.operator $ createCmd MT.MatchedTrade with
    venue = fx.operator
    tradeLegs =
      [ MT.TradeLeg with admin = fx.ttAdmin; leg = xLeg
      , MT.TradeLeg with admin = fx.lpRegistrar; leg = lpLeg
      ]
    settlementDeadline = None; policyReceipt = None
  trade <- fromSome <$> queryContractId fx.operator tradeCid
  let settlement = MT.mkTradeSettlementInfo tradeCid trade
  aliceX <- holdingCidsFor alice "X"
  xSender <- ttAlloc fx.ttReg alice settlement (mkSpec fx.ttAdmin aliceAcct [xLeg] False) aliceX now
  xReceiver <- ttAlloc fx.ttReg bob settlement (mkSpec fx.ttAdmin bobAcct [xLeg] False) [] now
  lpSender <- lpAlloc fx bob settlement (mkSpec fx.lpRegistrar bobAcct [lpLeg] False)
    [toInterfaceContractId bobLpHolding] now
  lpReceiver <- lpAlloc fx alice settlement (mkSpec fx.lpRegistrar aliceAcct [lpLeg] False) [] now
  pure TwoAdminTrade with
    fx; tradeCid; xLeg; lpLeg
    ttAllocations = map Utils.finalAllocation [xSender, xReceiver]
    lpAllocations = map Utils.finalAllocation [lpSender, lpReceiver]

data DiscoveredTtSettlement = DiscoveredTtSettlement with
    factoryCid : ContractId V2.SettlementFactory
    extraArgs : ExtraArgs
    disclosures : Disclosures'

-- The preview derives each admin's transfer legs from the trade; the caller
-- supplies only the finalized allocations per admin.
discoverTtTradeSettlement
  : TwoAdminTrade -> Script DiscoveredTtSettlement
discoverTtTradeSettlement t = do
  batches <- submit t.fx.operator $
    exerciseCmd t.tradeCid MT.MatchedTrade_PreviewSettlement with
      allocationsByAdmin = Map.fromList
        [ (t.fx.ttAdmin, t.ttAllocations)
        , (t.fx.lpRegistrar, t.lpAllocations)
        ]
  let ttBatch = fromSome (Map.lookup t.fx.ttAdmin batches)
  enriched <- getSettlementFactory t.fx.ttReg ttBatch
  pure DiscoveredTtSettlement with
    factoryCid = enriched.factoryCid
    extraArgs = enriched.arg.extraArgs
    disclosures = enriched.disclosures

-- The venue's settle over an explicit set of per-admin batches.
settleTwoAdmin
  : TwoAdminTrade
  -> [(Party, MT.SettlementBatchV2)]
  -> Commands MT.MatchedTrade_SettleResult
settleTwoAdmin t entries =
  exerciseCmd t.tradeCid MT.MatchedTrade_Settle with
    batchesByAdmin = Map.fromList entries
    allocationRequests = []
    dexPairCid = None

-- readAs the LP registrar: our Holding is `signatory admin, owner`, so the
-- venue is not a stakeholder of the LP holding the settle archives.
twoAdminSubmitOptions : TwoAdminTrade -> Disclosures' -> SubmitOptions
twoAdminSubmitOptions t disclosures =
  actAs t.fx.operator <> readAs [t.fx.lpRegistrar] <> discloseMany' disclosures

-- | Proves a two-admin matched trade: settlement derives the expected admins from the trade, rejects a missing or unexpected admin, and otherwise settles each admin's legs across both registries in one transaction; rejected attempts commit nothing, so the same allocations settle in the last phase.
testMatchedTradeSettlesPerAdminLegSubsets : Script ()
testMatchedTradeSettlesPerAdminLegSubsets = do
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  t <- setupTwoAdminTrade alice bob
  discovered <- discoverTtTradeSettlement t
  let ttBatch = MT.SettlementBatchV2 with
        allocations = t.ttAllocations
        factoryCid = discovered.factoryCid
        extraArgs = discovered.extraArgs
      lpBatch = MT.SettlementBatchV2 with
        allocations = t.lpAllocations
        factoryCid = coerceContractId t.fx.lpReg
        extraArgs = emptyExtraArgs

  missing <- trySubmit (twoAdminSubmitOptions t discovered.disclosures) $
    settleTwoAdmin t [(t.fx.ttAdmin, ttBatch)]
  case missing of
    Right _ -> abort "settle missing an expected admin must be rejected"
    Left e ->
      assertMsg ("expected missing settlement batch, got: " <> show e)
        (T.isInfixOf "missing settlement batch" (show e))

  extra <- trySubmit (twoAdminSubmitOptions t discovered.disclosures) $
    settleTwoAdmin t
      [(t.fx.ttAdmin, ttBatch), (t.fx.lpRegistrar, lpBatch), (bob, ttBatch)]
  case extra of
    Right _ -> abort "settle with an unexpected admin must be rejected"
    Left e ->
      assertMsg ("expected unexpected settlement batch, got: " <> show e)
        (T.isInfixOf "unexpected settlement batch" (show e))

  res <- submit (twoAdminSubmitOptions t discovered.disclosures) $
    settleTwoAdmin t [(t.fx.ttAdmin, ttBatch), (t.fx.lpRegistrar, lpBatch)]
  Map.size res.resultsByAdmin === 2
  bobX <- holdingCidsFor bob "X"
  assertMsg "bob received the X leg" (not (null bobX))
  aliceHoldings <- query @RegV2.Holding alice
  length (filter (\(_, h) -> h.instrumentId == lpId && h.owner == alice && not h.locked) aliceHoldings) === 1

-- Genuinely cross-admin AMM pool: base "B" is administered by one TestTokenV2
-- registry, quote "Q" by a SECOND, distinct TestTokenV2 registry, and the LP
-- token by the reference Registry.V2. Base, quote, and LP resolve to three
-- distinct admins, so add, swap, and remove each settle one batch per admin in
-- one transaction, with each admin's choice context reaching only its own batch.
data CrossFixture = CrossFixture with
    operator : Party
    lpRegistrar : Party
    ttRegA : TT2.TestTokenV2Registry      -- base "B"
    ttRegB : TT2.TestTokenV2Registry      -- quote "Q"
    baseAdmin : Party
    quoteAdmin : Party
    lpReg : ContractId RegV2.Registry
    poolId : PoolId
    poolCid : ContractId Pool
    stateCid : ContractId PS.PoolState
    policyCid : ContractId LP.LPTokenPolicy
    dvpCid : ContractId Dvp.PoolLiquidityRules
    rulesCid : ContractId PRules.PoolRules

setupCross : Party -> Script CrossFixture
setupCross lp = do
  operator <- allocateParty "operator"
  lpRegistrar <- allocateParty "lp-registrar"
  ttRegA <- TT2.initialize (TT2.TestTokenV2RegistryConfig with adminPartyName = "admin-base")
  ttRegB <- TT2.initialize (TT2.TestTokenV2RegistryConfig with adminPartyName = "admin-quote")
  let baseAdmin = ttRegA.admin
      quoteAdmin = ttRegB.admin
  lpRegCid <- submit lpRegistrar $ createCmd RegV2.Registry with
    admin = lpRegistrar; users = [operator, lp]
  TT2.mint ttRegA (Utils.basicAccount lp) "B" 10.0
  TT2.mint ttRegB (Utils.basicAccount lp) "Q" 200000.0
  let poolId = "B-Q"
      lpInstrumentId = V2.InstrumentId with admin = lpRegistrar; id = lpId
  poolCid <- submit operator $ createCmd Pool with
    poolId; operator; lpRegistrar
    baseInstrumentId = V2.InstrumentId with admin = baseAdmin; id = "B"
    quoteInstrumentId = V2.InstrumentId with admin = quoteAdmin; id = "Q"
    lpInstrumentId
    feeBps = 30
  stateCid <- submit operator $ createCmd PS.PoolState with
    poolId; operator; lpRegistrar
    status = PS_Unfunded
    reserves = PoolReserves with baseAmount = 0.0; quoteAmount = 0.0
    totalLpSupply = 0.0; publicReaders = []
  dvpCid <- submit (actAs [operator, lpRegistrar]) $
    createCmd Dvp.PoolLiquidityRules with operator; lpRegistrar
  rulesCid <- submit operator $ createCmd PRules.PoolRules with operator
  policyCid <- submit lpRegistrar $ createCmd LP.LPTokenPolicy with
    lpRegistrar; operator; lpInstrumentId
    totalSupply = 0.0; active = True
  pure CrossFixture with
    operator; lpRegistrar; ttRegA; ttRegB; baseAdmin; quoteAdmin
    lpReg = lpRegCid; poolId; poolCid; stateCid; policyCid; dvpCid; rulesCid

-- Complete an operator/registrar allocation staged from a preview plan through
-- one TestTokenV2 registry.
crossTt
  : TT2.TestTokenV2Registry -> Party -> V2.AllocationFactory_Allocate
  -> Script (ContractId V2.AllocationFactory, ContractId V2.Allocation)
crossTt reg actor arg = do
  enriched <- getAllocationFactory reg arg
  res <- submit (actAs actor <> discloseMany' enriched.disclosures) $
    exerciseCmd enriched.factoryCid enriched.arg
  case res.output of
    V2.AllocationInstructionResult_Completed cid -> pure (enriched.factoryCid, cid)
    _ -> abort "cross TestTokenV2 allocation must complete"

-- The Registry.V2 factory needs no context; the actor reads as the registrar.
crossLp
  : CrossFixture -> Party -> V2.AllocationFactory_Allocate
  -> Script (ContractId V2.AllocationFactory, ContractId V2.Allocation)
crossLp fx actor arg = do
  let factoryCid = toInterfaceContractId fx.lpReg : ContractId V2.AllocationFactory
  res <- submit (actAs actor <> readAs [fx.lpRegistrar]) $ exerciseCmd factoryCid arg
  case res.output of
    V2.AllocationInstructionResult_Completed cid -> pure (factoryCid, cid)
    _ -> abort "cross LP allocation must complete"

-- A full cross-admin add: base under ttRegA, quote under ttRegB, LP mint under
-- Registry.V2, settled as three per-admin batches in one transaction.
crossAddSettle : CrossFixture -> Party -> Time -> Script Dvp.PoolLiquidityRules_SettleAddResult
crossAddSettle fx lp now = do
  let lpAcct = Utils.basicAccount lp
      opAcct = Utils.basicAccount fx.operator
      settlement = PM.poolSettlement fx.poolCid fx.operator
      baseAmount = 10.0
      quoteAmount = 200000.0
      lpAmount = PM.sqrtDecimal (baseAmount * quoteAmount)
      baseLeg = V2.TransferLeg with
        transferLegId = "lp-base-deposit"; sender = lpAcct; receiver = opAcct
        amount = baseAmount; instrumentId = "B"; meta = emptyMetadata
      quoteLeg = V2.TransferLeg with
        transferLegId = "lp-quote-deposit"; sender = lpAcct; receiver = opAcct
        amount = quoteAmount; instrumentId = "Q"; meta = emptyMetadata
      lpMintLeg = Lp.lpMintLeg lpAcct lpId lpAmount
  reqCid <- submit fx.operator $ exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_RequestAddLiquidity with
    poolCid = fx.poolCid; recipient = lp; baseAmount; quoteAmount; lpAmount
    requestedAt = now; settleAt = None
  baseCids <- holdingCidsFor lp "B"
  quoteCids <- holdingCidsFor lp "Q"
  baseDep <- ttAlloc fx.ttRegA lp settlement (depositSpec fx.baseAdmin lpAcct baseLeg) baseCids now
  quoteDep <- ttAlloc fx.ttRegB lp settlement (depositSpec fx.quoteAdmin lpAcct quoteLeg) quoteCids now
  rres <- submit lp $ exerciseCmd (toInterfaceContractId fx.lpReg : ContractId V2.AllocationFactory)
    V2.AllocationFactory_Allocate with
      settlement; allocation = mkSpec fx.lpRegistrar lpAcct [lpMintLeg] False; requestedAt = now
      inputHoldingCids = []; actors = [lp]; extraArgs = emptyExtraArgs
  let V2.AllocationInstructionResult_Completed receiptCid = rres.output
      preparation = Dvp.AddLiquidityPreparationArgs with
        expectedPoolId = fx.poolId; poolCid = fx.poolCid; poolStateCid = fx.stateCid
        lpPolicyCid = fx.policyCid; requestCid = Some reqCid; acceptanceCid = None
        recipient = lp
        lpBaseDepositCid = baseDep; lpQuoteDepositCid = quoteDep; lpReceiptCid = receiptCid
        baseAmount; quoteAmount; minLpTokens = 0.0; knownTotalLpSupply = 0.0
  allocationPlan <- submit (actAs [fx.operator, fx.lpRegistrar]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_PreviewAddAllocations with
      preparation; requestedAt = now
  (baseFactoryCid, opBaseRecv) <- crossTt fx.ttRegA fx.operator allocationPlan.baseReceiver
  (quoteFactoryCid, opQuoteRecv) <- crossTt fx.ttRegB fx.operator allocationPlan.quoteReceiver
  (lpFactoryCid, regMint) <- crossLp fx fx.lpRegistrar allocationPlan.lpMintSender
  settlementPlan <- submit (actAs [fx.operator, fx.lpRegistrar]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_PreviewAddSettlement with
      preparation; operatorBaseReceiverCid = opBaseRecv
      operatorQuoteReceiverCid = opQuoteRecv; registrarMintCid = regMint
  Map.size settlementPlan === 3
  encBase <- getSettlementFactory fx.ttRegA (fromSome (Map.lookup fx.baseAdmin settlementPlan))
  encQuote <- getSettlementFactory fx.ttRegB (fromSome (Map.lookup fx.quoteAdmin settlementPlan))
  let batchesByAdmin = Map.fromList
        [ (fx.baseAdmin, AB.RegistryBatchInput encBase.factoryCid encBase.arg.extraArgs)
        , (fx.quoteAdmin, AB.RegistryBatchInput encQuote.factoryCid encQuote.arg.extraArgs)
        , (fx.lpRegistrar, AB.RegistryBatchInput (coerceContractId fx.lpReg) emptyExtraArgs)
        ]
  submit (foldMap actAs [fx.operator, fx.lpRegistrar]
          <> discloseMany' encBase.disclosures <> discloseMany' encQuote.disclosures) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_SettleAddLiquidity with
      expectedPoolId = fx.poolId; poolCid = fx.poolCid; poolStateCid = fx.stateCid
      lpPolicyCid = fx.policyCid; requestCid = Some reqCid; acceptanceCid = None
      recipient = lp
      lpBaseDepositCid = baseDep; lpQuoteDepositCid = quoteDep; lpReceiptCid = receiptCid
      baseFactoryCid; quoteFactoryCid; lpFactoryCid
      baseAmount; quoteAmount; minLpTokens = 0.0; knownTotalLpSupply = 0.0
      requestedAt = now; batchesByAdmin
      operatorBaseReceiverCid = Some opBaseRecv
      operatorQuoteReceiverCid = Some opQuoteRecv
      registrarMintCid = Some regMint
      allocationContextByAdmin = Map.empty

-- | Proves a base@registryA / quote@registryB pool settles add, swap, and remove across two distinct TestTokenV2 registries plus the reference LP registry, each admin's batch carrying its own context, reserves moved and the swapper and LP paid.
testCrossAdminPoolSettlesAcrossTwoRegistries : Script ()
testCrossAdminPoolSettlesAcrossTwoRegistries = do
  lp <- allocateParty "lp"
  bob <- allocateParty "bob"
  fx <- setupCross lp
  now <- getTime

  addRes <- crossAddSettle fx lp now
  Some state0 <- queryContractId fx.operator addRes.poolStateCid
  state0.status === PS_Active
  state0.reserves.baseAmount === 10.0
  state0.reserves.quoteAmount === 200000.0
  -- The base slice is backed by a ttRegA allocation, the quote slice by ttRegB.
  Some baseSlice <- queryContractId fx.operator addRes.baseSliceCid
  Some quoteSlice <- queryContractId fx.operator addRes.quoteSliceCid
  baseSlice.instrumentId.admin === fx.baseAdmin
  quoteSlice.instrumentId.admin === fx.quoteAdmin
  lpHoldings <- query @RegV2.Holding lp
  length (filter (\(_, h) -> h.instrumentId == lpId && h.owner == lp && not h.locked) lpHoldings) === 1

  -- Swap: bob puts quote "Q" (ttRegB) in for base "B" (ttRegA). The swapper
  -- authorizes one allocation per admin; the input and output batches settle
  -- under their own registries in one transaction.
  let swapIn = 1000.0
  TT2.mint fx.ttRegB (Utils.basicAccount bob) "Q" swapIn
  let quoteBinding = Some (PRules.SwapQuoteBinding with
        expectedPoolId = fx.poolId
        poolStateCid = addRes.poolStateCid
        inputSliceCid = addRes.quoteSliceCid
        outputSliceCids = [addRes.baseSliceCid]
        minOutputAmount = 0.0)
  reqRes <- submit fx.operator $ exerciseCmd fx.rulesCid PRules.PoolRules_RequestSwap with
    poolCid = fx.poolCid; swapper = bob
    inputInstrumentId = (V2.InstrumentId with admin = fx.quoteAdmin; id = "Q"); inputAmount = swapIn
    requestedAt = now; settleAt = None
    quoteBinding
  length reqRes.allocationSpecs === 2
  let inSpec = fromSome (find (\s -> s.admin == fx.quoteAdmin) reqRes.allocationSpecs)
      outSpec = fromSome (find (\s -> s.admin == fx.baseAdmin) reqRes.allocationSpecs)
  qIn <- holdingCidsFor bob "Q"
  swapInAlloc <- ttAlloc fx.ttRegB bob reqRes.settlement inSpec qIn now
  swapOutAlloc <- ttAlloc fx.ttRegA bob reqRes.settlement outSpec [] now
  let swapperByAdmin = Map.fromList
        [(fx.quoteAdmin, swapInAlloc), (fx.baseAdmin, swapOutAlloc)]
  swapPlan <- submit fx.operator $ exerciseCmd fx.rulesCid PRules.PoolRules_PreviewSwapSettlement with
    expectedPoolId = fx.poolId; poolCid = fx.poolCid; poolStateCid = addRes.poolStateCid
    swapperAccount = Utils.basicAccount bob
    inputInstrumentId = (V2.InstrumentId with admin = fx.quoteAdmin; id = "Q"); inputAmount = swapIn; minOutputAmount = 0.0
    swapperAllocationCidsByAdmin = swapperByAdmin
    inputSliceCid = addRes.quoteSliceCid; outputSliceCids = [addRes.baseSliceCid]
    quoteBinding = reqRes.quoteBinding
  Map.size swapPlan === 2
  encSwapIn <- getSettlementFactory fx.ttRegB (fromSome (Map.lookup fx.quoteAdmin swapPlan))
  encSwapOut <- getSettlementFactory fx.ttRegA (fromSome (Map.lookup fx.baseAdmin swapPlan))
  swapRes <- submit (actAs fx.operator
      <> discloseMany' encSwapIn.disclosures <> discloseMany' encSwapOut.disclosures) $
    exerciseCmd fx.rulesCid PRules.PoolRules_Swap with
      expectedPoolId = fx.poolId; poolCid = fx.poolCid; poolStateCid = addRes.poolStateCid
      swapperAccount = Utils.basicAccount bob
      inputInstrumentId = (V2.InstrumentId with admin = fx.quoteAdmin; id = "Q"); inputAmount = swapIn; minOutputAmount = 0.0
      swapperAllocationCidsByAdmin = swapperByAdmin
      inputSliceCid = addRes.quoteSliceCid; outputSliceCids = [addRes.baseSliceCid]
      batchesByAdmin = Map.fromList
        [ (fx.quoteAdmin, AB.RegistryBatchInput encSwapIn.factoryCid encSwapIn.arg.extraArgs)
        , (fx.baseAdmin, AB.RegistryBatchInput encSwapOut.factoryCid encSwapOut.arg.extraArgs)
        ]
      swapAllocationRequestCids = [reqRes.swapRequestCid]
      quoteBinding = reqRes.quoteBinding
  Some state1 <- queryContractId fx.operator swapRes.poolStateCid
  assertMsg "quote reserve grew after cross-admin swap" (state1.reserves.quoteAmount > 200000.0)
  assertMsg "base reserve shrank after cross-admin swap" (state1.reserves.baseAmount < 10.0)
  assertMsg "cross-admin swap produced output" (swapRes.amountOut > 0.0)
  bobBase <- holdingCidsFor bob "B"
  assertMsg "bob received base (B) from ttRegA" (not (null bobBase))

  -- Remove: lp redeems the whole position. Base pays from ttRegA, quote from
  -- ttRegB, LP burns on Registry.V2 — three per-admin batches, one transaction.
  let lpAmount = PM.sqrtDecimal 2000000.0
      lpAcct = Utils.basicAccount lp
      opAcct = Utils.basicAccount fx.operator
      settlement = PM.poolSettlement fx.poolCid fx.operator
      baseOut = state1.reserves.baseAmount
      quoteOut = state1.reserves.quoteAmount
      baseOutLeg = V2.TransferLeg with
        transferLegId = "lp-base-out-0"; sender = opAcct; receiver = lpAcct
        amount = baseOut; instrumentId = "B"; meta = emptyMetadata
      quoteOutLeg = V2.TransferLeg with
        transferLegId = "lp-quote-out-0"; sender = opAcct; receiver = lpAcct
        amount = quoteOut; instrumentId = "Q"; meta = emptyMetadata
      burnLeg = Lp.lpBurnLeg lpAcct lpId lpAmount
  lpHs <- query @RegV2.Holding lp
  let (lpHoldCid, _) = head (filter (\(_, h) -> h.instrumentId == lpId && not h.locked) lpHs)
  remReqCid <- submit fx.operator $ exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_RequestRemoveLiquidity with
    poolCid = fx.poolCid; holder = lp; baseOuts = [baseOut]; quoteOuts = [quoteOut]
    lpBurnAmount = lpAmount; requestedAt = now; settleAt = None
  baseReceipt <- ttAlloc fx.ttRegA lp settlement (mkSpec fx.baseAdmin lpAcct [baseOutLeg] False) [] now
  quoteReceipt <- ttAlloc fx.ttRegB lp settlement (mkSpec fx.quoteAdmin lpAcct [quoteOutLeg] False) [] now
  brres <- submit lp $ exerciseCmd (toInterfaceContractId fx.lpReg : ContractId V2.AllocationFactory)
    V2.AllocationFactory_Allocate with
      settlement; allocation = mkSpec fx.lpRegistrar lpAcct [burnLeg] True; requestedAt = now
      inputHoldingCids = [toInterfaceContractId lpHoldCid]; actors = [lp]; extraArgs = emptyExtraArgs
  let V2.AllocationInstructionResult_Completed burnSender = brres.output
      remPrep = Dvp.RemoveLiquidityPreparationArgs with
        expectedPoolId = fx.poolId; poolCid = fx.poolCid
        poolStateCid = swapRes.poolStateCid; lpPolicyCid = addRes.lpPolicyCid
        requestCid = Some remReqCid; acceptanceCid = None
        holder = lp; lpTokensToRedeem = lpAmount; knownTotalLpSupply = lpAmount
        minBaseOut = 0.0; minQuoteOut = 0.0
        baseSliceCids = [fromSome swapRes.boundaryOutputSliceCid]
        quoteSliceCids = [swapRes.inputSliceCid]
        holderBaseReceiptCid = baseReceipt; holderQuoteReceiptCid = quoteReceipt
        holderBurnSenderCid = burnSender
  remAllocPlan <- submit (actAs [fx.operator, fx.lpRegistrar]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_PreviewRemoveAllocations with
      preparation = remPrep; requestedAt = now
  (_, burnReceiver) <- crossLp fx fx.lpRegistrar remAllocPlan.lpBurnReceiver
  remSettlePlan <- submit (actAs [fx.operator, fx.lpRegistrar]) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_PreviewRemoveSettlement with
      preparation = remPrep; registrarBurnReceiverCid = burnReceiver
  Map.size remSettlePlan === 3
  encRemBase <- getSettlementFactory fx.ttRegA (fromSome (Map.lookup fx.baseAdmin remSettlePlan))
  encRemQuote <- getSettlementFactory fx.ttRegB (fromSome (Map.lookup fx.quoteAdmin remSettlePlan))
  remRes <- submit (foldMap actAs [fx.operator, fx.lpRegistrar]
      <> discloseMany' encRemBase.disclosures <> discloseMany' encRemQuote.disclosures) $
    exerciseCmd fx.dvpCid Dvp.PoolLiquidityRules_SettleRemoveLiquidity with
      expectedPoolId = fx.poolId; poolCid = fx.poolCid
      poolStateCid = swapRes.poolStateCid; lpPolicyCid = addRes.lpPolicyCid
      requestCid = Some remReqCid; acceptanceCid = None
      holder = lp; lpTokensToRedeem = lpAmount; knownTotalLpSupply = lpAmount
      minBaseOut = 0.0; minQuoteOut = 0.0
      baseSliceCids = [fromSome swapRes.boundaryOutputSliceCid]
      quoteSliceCids = [swapRes.inputSliceCid]
      holderBaseReceiptCid = baseReceipt; holderQuoteReceiptCid = quoteReceipt
      holderBurnSenderCid = burnSender
      lpFactoryCid = toInterfaceContractId fx.lpReg
      requestedAt = now
      batchesByAdmin = Map.fromList
        [ (fx.baseAdmin, AB.RegistryBatchInput encRemBase.factoryCid encRemBase.arg.extraArgs)
        , (fx.quoteAdmin, AB.RegistryBatchInput encRemQuote.factoryCid encRemQuote.arg.extraArgs)
        , (fx.lpRegistrar, AB.RegistryBatchInput (coerceContractId fx.lpReg) emptyExtraArgs)
        ]
      registrarBurnReceiverCid = Some burnReceiver
      allocationContextByAdmin = Map.empty
  Some state2 <- queryContractId fx.operator remRes.poolStateCid
  state2.reserves.baseAmount === 0.0
  state2.reserves.quoteAmount === 0.0
  state2.status === PS_Unfunded
  remRes.baseReturned === baseOut
  remRes.quoteReturned === quoteOut
  afterLp <- query @RegV2.Holding lp
  length (filter (\(_, h) -> h.instrumentId == lpId && h.owner == lp) afterLp) === 0
  baseBack <- holdingCidsFor lp "B"
  quoteBack <- holdingCidsFor lp "Q"
  assertMsg "lp received base (B) back from ttRegA" (not (null baseBack))
  assertMsg "lp received quote (Q) back from ttRegB" (not (null quoteBack))

-- Genuinely cross-admin order book: base "BTC" is administered by one
-- Registry.V2 instance, quote "USDC" by a SECOND, distinct Registry.V2
-- instance. A resting order therefore funds the side it must deliver under one
-- registry and holds a zero-funding receipt authorization under the other, so a
-- match settles one batch per registry in one transaction. Both registries are
-- context-free and value-conserving, so these tests prove the order-specific
-- logic — two per-admin batches, per-admin roll-forward of the funding AND the
-- receipt allocation, non-viable-remainder closure, and atomic multi-admin
-- cancel — against real locked backing. (Per-admin choice-context threading for
-- the settlement spine is covered by the TestTokenV2 pool test above.)
data CrossOrderFixture = CrossOrderFixture with
    operator : Party
    baseAdmin : Party
    quoteAdmin : Party
    regA : ContractId RegV2.Registry      -- base "BTC"
    regB : ContractId RegV2.Registry      -- quote "USDC"
    buyer : Party
    seller : Party

setupCrossOrder : Text -> Script CrossOrderFixture
setupCrossOrder seed = do
  operator <- allocateParty (seed <> "-op")
  baseAdmin <- allocateParty (seed <> "-base-admin")
  quoteAdmin <- allocateParty (seed <> "-quote-admin")
  buyer <- allocateParty (seed <> "-buyer")
  seller <- allocateParty (seed <> "-seller")
  regA <- submit baseAdmin $ createCmd RegV2.Registry with
    admin = baseAdmin; users = [operator, buyer, seller]
  regB <- submit quoteAdmin $ createCmd RegV2.Registry with
    admin = quoteAdmin; users = [operator, buyer, seller]
  pure CrossOrderFixture with operator; baseAdmin; quoteAdmin; regA; regB; buyer; seller

-- Amounts of a party's Registry.V2 holdings for an instrument, filtered by lock.
crossHoldings : Party -> Party -> Text -> Bool -> Script [Decimal]
crossHoldings viewer owner instr wantLocked = do
  hs <- query @RegV2.Holding viewer
  pure [ h.amount | (_, h) <- hs, h.owner == owner, h.instrumentId == instr, h.locked == wantLocked ]

crossOrderAlloc
  : ContractId RegV2.Registry -> Party -> V2.SettlementInfo
  -> V2.AllocationSpecification -> [ContractId V2.Holding] -> Time
  -> Script (ContractId V2.Allocation)
crossOrderAlloc regCid party settlement spec inputs now = do
  res <- submit party $
    exerciseCmd (toInterfaceContractId regCid : ContractId V2.AllocationFactory)
      V2.AllocationFactory_Allocate with
        settlement; allocation = spec; requestedAt = now
        inputHoldingCids = inputs; actors = [party]; extraArgs = emptyExtraArgs
  case res.output of
    V2.AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "cross-order allocation must complete"

-- Place a resting order through the real path and fund each of its per-admin
-- allocations under that admin's own registry: the lock side against real
-- minted backing, the counter-admin receipt against nothing.
placeCrossOrder
  : CrossOrderFixture -> Party -> Order.Side -> Decimal -> Decimal
  -> Optional Time -> Text
  -> Script (ContractId Order.Order, Map.Map Party (ContractId V2.Allocation))
placeCrossOrder fx trader side limitPrice quantity expiry ref = do
  now <- getTime
  let baseIid = V2.InstrumentId with admin = fx.baseAdmin; id = "BTC"
      quoteIid = V2.InstrumentId with admin = fx.quoteAdmin; id = "USDC"
      regFor admin = if admin == fx.baseAdmin then fx.regA else fx.regB
  reqCid <- submit trader $ createCmd OFR.OrderFundingRequest with
    operator = fx.operator; trader
    baseInstrumentId = baseIid; quoteInstrumentId = quoteIid
    side; limitPrice; quantity; expiry
  bound <- submit fx.operator $ exerciseCmd reqCid OFR.OrderFundingRequest_Bind with
    settlementRef = ref
  Some allocReq <- queryContractId fx.operator bound.allocationRequestCid
  let settlement = fromSome allocReq.allocationSettlement
      lockAdmin = allocReq.lockInstrumentId.admin
      fundingSpec = Order.orderFundingSpecification
        allocReq.lockInstrumentId trader allocReq.lockAmount allocReq.expiry
  lockHolding <- submit (actAs [lockAdmin, trader]) $ createCmd RegV2.Holding with
    admin = lockAdmin; owner = trader
    instrumentId = allocReq.lockInstrumentId.id
    amount = allocReq.lockAmount; locked = False
  fundingCid <- crossOrderAlloc (regFor lockAdmin) trader settlement fundingSpec
    [toInterfaceContractId lockHolding] now
  receiptCids <- case allocReq.receiptAdmin of
    None -> pure []
    Some ra -> do
      rc <- crossOrderAlloc (regFor ra) trader settlement
        (Order.orderReceiptSpecification ra trader allocReq.expiry) [] now
      pure [rc]
  funded <- submit fx.operator $ exerciseCmd bound.orderCid Order.Order_Fund with
    allocationCids = fundingCid :: receiptCids
    allocationRequestCid = Some bound.allocationRequestCid
  pure (funded.orderCid, funded.allocationCidsByAdmin)

-- | Proves a bid on base@registryA / quote@registryB settles both admins' batches in one transaction, rolls every open-order allocation forward (quote funding and base receipt), closes the fully-filled counter order without rolling, and moves the real holdings.
testCrossAdminOrderSettlesAndRollsForward : Script ()
testCrossAdminOrderSettlesAndRollsForward = do
  fx <- setupCrossOrder "co"
  -- Bid for 10 BTC @ 100: locks 1000 USDC under quoteAdmin, receipt for BTC
  -- under baseAdmin. Ask for 4 BTC @ 90: locks 4 BTC under baseAdmin, receipt
  -- for USDC under quoteAdmin.
  (bidCid, bidAllocs) <- placeCrossOrder fx fx.buyer Order.Bid 100.0 10.0 None "x-bid"
  (askCid, askAllocs) <- placeCrossOrder fx fx.seller Order.Ask 90.0 4.0 None "x-ask"
  Map.size bidAllocs === 2
  Map.size askAllocs === 2

  let buyerAcct = Utils.basicAccount fx.buyer
      sellerAcct = Utils.basicAccount fx.seller
      settleA = coerceContractId fx.regA : ContractId V2.SettlementFactory
      settleB = coerceContractId fx.regB : ContractId V2.SettlementFactory
  execCid <- submit fx.operator $ createCmd OME.OrderMatchExecution with
    operator = fx.operator; matchId = "xm1"
    match = OME.MatchedOrderPair with
      buyerAccount = buyerAcct; sellerAccount = sellerAcct
      baseInstrumentId = "BTC"; quoteInstrumentId = "USDC"
      fillQty = 4.0; fillPrice = 95.0
    buyOrderCid = bidCid; sellOrderCid = askCid
    buyerAllocationCidsByAdmin = bidAllocs
    sellerAllocationCidsByAdmin = askAllocs
  res <- submit (actAs fx.operator <> readAs [fx.baseAdmin, fx.quoteAdmin]) $
    exerciseCmd execCid OME.OrderMatchExecution_Execute with
      batchesByAdmin = Map.fromList
        [ (fx.baseAdmin, AB.RegistryBatchInput settleA emptyExtraArgs)
        , (fx.quoteAdmin, AB.RegistryBatchInput settleB emptyExtraArgs)
        ]

  -- Two admins, two batches, one transaction.
  Map.size res.settleResultsByAdmin === 2
  Map.keys res.settleResultsByAdmin === Map.keys bidAllocs

  -- The bid stays open and rolls EVERY allocation forward: the quote funding
  -- under quoteAdmin and the base receipt under baseAdmin.
  Map.keys res.buyerNextAllocationCidsByAdmin === Map.keys bidAllocs
  Some buyRemainder <- queryContractId fx.operator (fromSome res.buyRemainderCid)
  buyRemainder.remainingQty === 6.0
  buyRemainder.status === Order.OS_PartiallyFilled
  buyRemainder.allocationCidsByAdmin === res.buyerNextAllocationCidsByAdmin

  -- The ask is fully filled and closes without rolling any allocation.
  res.sellRemainderCid === None
  res.sellerNextAllocationCidsByAdmin === Map.empty

  -- Real holdings moved: the buyer received base from registryA and holds the
  -- residual quote budget locked in registryB; the seller received quote.
  buyerBase <- crossHoldings fx.buyer fx.buyer "BTC" False
  buyerBase === [4.0]
  buyerLockedQuote <- crossHoldings fx.buyer fx.buyer "USDC" True
  buyerLockedQuote === [620.0]
  sellerQuote <- crossHoldings fx.seller fx.seller "USDC" False
  sellerQuote === [380.0]
  sellerLockedBase <- crossHoldings fx.seller fx.seller "BTC" True
  sellerLockedBase === []

  -- The settled trade tags each leg with its own instrument's admin.
  settled <- query @MT.SettledTrade fx.operator
  map (Some . fst) settled === [res.settledTradeCid]
  [ [(tl.admin, tl.leg.instrumentId) | tl <- t.tradeLegs] | (_, t) <- settled ]
    === [[(fx.baseAdmin, "BTC"), (fx.quoteAdmin, "USDC")]]

-- | Proves a partial base quantity whose quote budget is exhausted by price and rounding closes a cross-admin order without rolling any allocation forward.
testCrossAdminOrderNonViableRemainderCloses : Script ()
testCrossAdminOrderNonViableRemainderCloses = do
  fx <- setupCrossOrder "co"
  let price = 0.000001
      restingQty = 1000.0
      fillQty = 999.99996
  -- A strictly partial fill whose quote spend rounds to the whole locked budget.
  (fillQty < restingQty) === True
  fillQty * price === restingQty * price

  (bidCid, bidAllocs) <- placeCrossOrder fx fx.buyer Order.Bid price restingQty None "dust-bid"
  (askCid, askAllocs) <- placeCrossOrder fx fx.seller Order.Ask price fillQty None "dust-ask"

  let buyerAcct = Utils.basicAccount fx.buyer
      sellerAcct = Utils.basicAccount fx.seller
  execCid <- submit fx.operator $ createCmd OME.OrderMatchExecution with
    operator = fx.operator; matchId = "dust"
    match = OME.MatchedOrderPair with
      buyerAccount = buyerAcct; sellerAccount = sellerAcct
      baseInstrumentId = "BTC"; quoteInstrumentId = "USDC"
      fillQty; fillPrice = price
    buyOrderCid = bidCid; sellOrderCid = askCid
    buyerAllocationCidsByAdmin = bidAllocs
    sellerAllocationCidsByAdmin = askAllocs
  res <- submit (actAs fx.operator <> readAs [fx.baseAdmin, fx.quoteAdmin]) $
    exerciseCmd execCid OME.OrderMatchExecution_Execute with
      batchesByAdmin = Map.fromList
        [ (fx.baseAdmin, AB.RegistryBatchInput (coerceContractId fx.regA) emptyExtraArgs)
        , (fx.quoteAdmin, AB.RegistryBatchInput (coerceContractId fx.regB) emptyExtraArgs)
        ]

  -- 0.00004 base is unfilled but the quote behind it is gone, so the bid closes
  -- with no rolled allocation on either admin. The ask closes on a full fill.
  restingQty - fillQty === 0.00004
  res.buyRemainderCid === None
  res.buyerNextAllocationCidsByAdmin === Map.empty
  res.sellRemainderCid === None
  res.sellerNextAllocationCidsByAdmin === Map.empty
  liveOrders <- query @Order.Order fx.operator
  liveOrders === []

-- | Proves Order_Cancel releases every allocation of a cross-admin order atomically, each under its own per-admin context, and a missing context rolls the whole cancel back.
testCrossAdminOrderCancelReleasesEveryAllocation : Script ()
testCrossAdminOrderCancelReleasesEveryAllocation = do
  fx <- setupCrossOrder "co"
  (bidCid, bidAllocs) <- placeCrossOrder fx fx.buyer Order.Bid 100.0 10.0 None "cancel-bid"
  Map.size bidAllocs === 2
  lockedBefore <- crossHoldings fx.buyer fx.buyer "USDC" True
  lockedBefore === [1000.0]

  -- A missing per-admin context aborts and rolls the whole cancel back: the
  -- order stays live and its funding stays locked.
  submitMustFail (actAs fx.operator <> readAs [fx.baseAdmin, fx.quoteAdmin]) $
    exerciseCmd bidCid Order.Order_Cancel with
      extraArgsByAdmin = Map.fromList [(fx.quoteAdmin, emptyExtraArgs)]
  Some _ <- queryContractId fx.operator bidCid
  stillLocked <- crossHoldings fx.buyer fx.buyer "USDC" True
  stillLocked === [1000.0]

  -- With both contexts, every allocation is cancelled and the quote unlocks.
  res <- submit (actAs fx.operator <> readAs [fx.baseAdmin, fx.quoteAdmin]) $
    exerciseCmd bidCid Order.Order_Cancel with
      extraArgsByAdmin = Map.fromList
        [(fx.baseAdmin, emptyExtraArgs), (fx.quoteAdmin, emptyExtraArgs)]
  Map.size res.cancelResultsByAdmin === 2
  None <- queryContractId fx.operator bidCid
  forA_ (Map.values bidAllocs) $ \cid -> do
    gone <- queryInterfaceContractId @V2.Allocation fx.operator cid
    assertMsg "cancel consumes each order allocation" (isNone gone)
  unlocked <- crossHoldings fx.buyer fx.buyer "USDC" False
  unlocked === [1000.0]
  lockedAfter <- crossHoldings fx.buyer fx.buyer "USDC" True
  lockedAfter === []

-- | Proves commitment parity across a cross-admin order's two allocations: an expiring order commits both under the same deadline; a GTC order leaves both uncommitted.
testCrossAdminOrderCommitmentParity : Script ()
testCrossAdminOrderCommitmentParity = do
  fx <- setupCrossOrder "co"
  now <- getTime
  let deadline = addRelTime now (hours 1)
  (_, expiringAllocs) <- placeCrossOrder fx fx.buyer Order.Bid 100.0 10.0 (Some deadline) "parity-exp"
  Map.size expiringAllocs === 2
  forA_ (Map.values expiringAllocs) $ \cid -> do
    Some v <- queryInterfaceContractId @V2.Allocation fx.buyer cid
    v.allocation.committed === True
    v.allocation.settlementDeadline === Some deadline

  (_, gtcAllocs) <- placeCrossOrder fx fx.buyer Order.Bid 100.0 10.0 None "parity-gtc"
  Map.size gtcAllocs === 2
  forA_ (Map.values gtcAllocs) $ \cid -> do
    Some v <- queryInterfaceContractId @V2.Allocation fx.buyer cid
    v.allocation.committed === False
    v.allocation.settlementDeadline === None
