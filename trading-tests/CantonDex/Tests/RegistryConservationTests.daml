-- | Settle-time conservation in Registry.V2.
--
-- Proves, against the production reference registry:
--   * executor-supplied extraTransferLegSides cannot draw more than the
--     allocation's locked backing (+ this iteration's receiver credits);
--   * sent + nextIterationFunding is bounded by that backing;
--   * roll-forward carries REAL locked backing: the next-iteration
--     allocation is backed by freshly locked holdings worth its funding,
--     so a second settle within the funding succeeds and one exceeding
--     it fails;
--   * surplus backing returns to the authorizer as an unlocked holding;
--   * the SettlementFactory batch rejects per-instrument sender/receiver
--     imbalance (an unbacked receiver leg with no matching sender);
--   * the SettlementFactory batch rejects allocations that do not cover its
--     legs exactly, whether an authorization is missing or superfluous;
--   * an order-book fill stays inside that backing across iterations, where
--     the face notional of the unfilled quantity does not.
-- Design context: `docs/concepts/design-tour.md#the-token-standard-settlement-spine`.
module CantonDex.Tests.RegistryConservationTests where

import DA.Assert
import DA.Map qualified as Map
import DA.Optional (fromSome, isNone)
import DA.Time (addRelTime, hours)
import DA.TextMap qualified as TextMap
import Daml.Script

import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.AllocationInstructionV2 qualified as V2
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.MetadataV1
import Splice.Api.Token.TransferInstructionV2 qualified as V2
import Splice.Testing.Utils (emptyExtraArgs)

import CantonDex.Dex.Order qualified as Order
import CantonDex.Dex.OrderFundingRequest qualified as OFR
import CantonDex.Dex.OrderMatchExecution qualified as OME
import CantonDex.Registry.V2 qualified as RegV2
import CantonDex.Trading.Utils qualified as Utils
import CantonDex.Trading.AdminBatch qualified as AB

data Fixture = Fixture with
    admin : Party
    alice : Party
    bob : Party
    factoryCid : ContractId V2.AllocationFactory
    settleCid : ContractId V2.SettlementFactory
    transferCid : ContractId V2.TransferFactory
    settlement : V2.SettlementInfo

setup : () -> Script Fixture
setup () = do
  admin <- allocateParty "registry-admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  reg <- submit admin $ createCmd RegV2.Registry with admin; users = [alice, bob]
  let settlement = V2.SettlementInfo with
        executors = [admin]
        id = "conservation-test"
        cid = None
        meta = emptyMetadata
  pure Fixture with
    admin; alice; bob
    factoryCid = toInterfaceContractId reg
    settleCid = toInterfaceContractId reg
    transferCid = toInterfaceContractId reg
    settlement

mintHolding : Fixture -> Party -> Text -> Decimal -> Script (ContractId RegV2.Holding)
mintHolding fx owner instrumentId amount =
  submit (actAs [fx.admin, owner]) $ createCmd RegV2.Holding with
    admin = fx.admin; owner; instrumentId; amount; locked = False

mkAlloc
  : Fixture -> Party -> V2.AllocationSpecification -> [ContractId RegV2.Holding]
  -> Script (ContractId V2.Allocation)
mkAlloc fx party spec holds = do
  now <- getTime
  res <- submit party $ exerciseCmd fx.factoryCid V2.AllocationFactory_Allocate with
    settlement = fx.settlement; allocation = spec; requestedAt = now
    inputHoldingCids = map toInterfaceContractId holds
    actors = [party]; extraArgs = emptyExtraArgs
  case res.output of
    V2.AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "allocation must complete"

-- Prefunded (iterated-enabled) allocation locking `amount` of `iid`.
prefunded : Fixture -> Party -> Text -> Decimal -> Script (ContractId V2.Allocation)
prefunded fx party iid amount = do
  hold <- mintHolding fx party iid amount
  let spec = Utils.mkPrefundedAllocationSpecification
        fx.admin (Utils.basicAccount party) None (TextMap.fromList [(iid, amount)])
  mkAlloc fx party spec [hold]

expiredPrefunded : Fixture -> Party -> Text -> Decimal -> Script (ContractId V2.Allocation)
expiredPrefunded fx party iid amount = do
  now <- getTime
  hold <- mintHolding fx party iid amount
  let spec = Utils.mkPrefundedAllocationSpecification
        fx.admin
        (Utils.basicAccount party)
        (Some (addRelTime now (hours (-1))))
        (TextMap.fromList [(iid, amount)])
  mkAlloc fx party spec [hold]

-- Plain (non-iterated) allocation authorizing `legs` for `party`; receiver
-- sides need no backing.
sidedAlloc : Fixture -> Party -> [V2.TransferLeg] -> Script (ContractId V2.Allocation)
sidedAlloc fx party legs = do
  let acct = Utils.basicAccount party
      spec = V2.AllocationSpecification with
        admin = fx.admin
        authorizer = acct
        transferLegSides = Utils.legsToSides acct legs
        settlementDeadline = None
        nextIterationFunding = None
        committed = False
        meta = emptyMetadata
  mkAlloc fx party spec []

mkLeg : Text -> Party -> Party -> Decimal -> Text -> V2.TransferLeg
mkLeg legId sender receiver amount instrumentId = V2.TransferLeg with
  transferLegId = legId
  sender = Utils.basicAccount sender
  receiver = Utils.basicAccount receiver
  amount; instrumentId
  meta = emptyMetadata

settleBatchCmd
  : Fixture -> [V2.TransferLeg] -> [V2.FinalizedAllocation]
  -> Commands V2.SettlementFactory_SettleBatchResult
settleBatchCmd fx legs allocations =
  exerciseCmd fx.settleCid V2.SettlementFactory_SettleBatch with
    settlement = fx.settlement
    transferLegs = legs
    allocations
    actors = [fx.admin]
    extraArgs = emptyExtraArgs

unlockedOf : Party -> Text -> Script [Decimal]
unlockedOf owner iid = do
  hs <- query @RegV2.Holding owner
  pure [ h.amount | (_, h) <- hs, h.instrumentId == iid, h.owner == owner, not h.locked ]

lockedOf : Party -> Text -> Script [Decimal]
lockedOf owner iid = do
  hs <- query @RegV2.Holding owner
  pure [ h.amount | (_, h) <- hs, h.instrumentId == iid, h.owner == owner, h.locked ]

-- 1. Executor-supplied extra sender leg exceeding the locked backing -------

-- | Proves executor-added sender legs cannot exceed locked backing.
testExtraLegBeyondBackingRejected : Script ()
testExtraLegBeyondBackingRejected = do
  fx <- setup ()
  aliceAlloc <- prefunded fx fx.alice "X" 100.0
  -- The batch itself is balanced (sender 150 == receiver 150), so the
  -- failure isolates the PER-ALLOCATION draw-down check.
  let leg = mkLeg "over-1" fx.alice fx.bob 150.0 "X"
  bobAlloc <- sidedAlloc fx fx.bob [leg]
  submitMustFail fx.admin $ settleBatchCmd fx [leg]
    [ Utils.mkFinalizedAllocation aliceAlloc
        (Utils.legsToSides (Utils.basicAccount fx.alice) [leg]) None
    , Utils.finalAllocation bobAlloc
    ]

-- 2. sent + nextIterationFunding exceeding the locked backing --------------

-- | Proves current outflow plus next-iteration funding cannot exceed backing.
testNextFundingBeyondBackingRejected : Script ()
testNextFundingBeyondBackingRejected = do
  fx <- setup ()
  aliceAlloc <- prefunded fx fx.alice "X" 100.0
  let leg = mkLeg "spend-1" fx.alice fx.bob 60.0 "X"
  bobAlloc <- sidedAlloc fx fx.bob [leg]
  -- 60 spent + 50 reserved > 100 locked.
  submitMustFail fx.admin $ settleBatchCmd fx [leg]
    [ Utils.mkFinalizedAllocation aliceAlloc
        (Utils.legsToSides (Utils.basicAccount fx.alice) [leg])
        (Some (TextMap.fromList [("X", 50.0)]))
    , Utils.finalAllocation bobAlloc
    ]

-- | Proves a finalized allocation rejects zero-valued continuation funding.
testFinalizedAllocationRejectsZeroNextFunding : Script ()
testFinalizedAllocationRejectsZeroNextFunding = do
  fx <- setup ()
  aliceAlloc <- prefunded fx fx.alice "X" 100.0
  let leg = mkLeg "zero-next" fx.alice fx.bob 40.0 "X"
  bobAlloc <- sidedAlloc fx fx.bob [leg]
  submitMustFail fx.admin $ settleBatchCmd fx [leg]
    [ Utils.mkFinalizedAllocation aliceAlloc
        (Utils.legsToSides (Utils.basicAccount fx.alice) [leg])
        (Some (TextMap.fromList [("X", 0.0)]))
    , Utils.finalAllocation bobAlloc
    ]

-- The allocation interface enforces the same positive-side rule when an
-- executor settles directly rather than through the settlement factory.
-- | Proves direct allocation settlement rejects zero-valued extra legs.
testDirectSettleRejectsZeroExtraLeg : Script ()
testDirectSettleRejectsZeroExtraLeg = do
  fx <- setup ()
  aliceAlloc <- prefunded fx fx.alice "X" 10.0
  let zeroLeg = mkLeg "zero-extra" fx.alice fx.bob 0.0 "X"
  submitMustFail fx.admin $ exerciseCmd aliceAlloc V2.Allocation_Settle with
    actors = [fx.admin]
    extraTransferLegSides =
      Utils.legsToSides (Utils.basicAccount fx.alice) [zeroLeg]
    nextIterationFunding = None
    extraArgs = emptyExtraArgs

-- 3. Roll-forward carries locked backing; the next iteration settles
--    within its funding ----------------------------------------------------

-- | Proves iterated settlement creates a next allocation with real locked funds.
testRollForwardCarriesLockedBacking : Script ()
testRollForwardCarriesLockedBacking = do
  fx <- setup ()
  aliceAlloc <- prefunded fx fx.alice "X" 100.0
  let leg1 = mkLeg "iter-1" fx.alice fx.bob 40.0 "X"
  bob1 <- sidedAlloc fx fx.bob [leg1]
  res1 <- submit fx.admin $ settleBatchCmd fx [leg1]
    [ Utils.mkFinalizedAllocation aliceAlloc
        (Utils.legsToSides (Utils.basicAccount fx.alice) [leg1])
        (Some (TextMap.fromList [("X", 60.0)]))
    , Utils.finalAllocation bob1
    ]
  nextCid <- case Utils.nextIterationAllocationCids res1 of
    [Some cid, None] -> pure cid
    _ -> abort "expected exactly the alice allocation to roll forward"

  -- The rolled-forward allocation's view exposes its locked backing, and
  -- the backing exists as a LOCKED holding worth exactly the funding.
  Some v <- queryInterfaceContractId @V2.Allocation fx.admin nextCid
  length v.holdingCids === 1
  aliceLocked <- lockedOf fx.alice "X"
  aliceLocked === [60.0]

  -- Second settle within the funding succeeds; bob ends with 40 + 60.
  let leg2 = mkLeg "iter-2" fx.alice fx.bob 60.0 "X"
  bob2 <- sidedAlloc fx fx.bob [leg2]
  _ <- submit fx.admin $ settleBatchCmd fx [leg2]
    [ Utils.mkFinalizedAllocation nextCid
        (Utils.legsToSides (Utils.basicAccount fx.alice) [leg2]) None
    , Utils.finalAllocation bob2
    ]
  bobAmounts <- unlockedOf fx.bob "X"
  sum bobAmounts === 100.0
  -- Alice's backing is fully consumed: nothing locked, nothing returned.
  aliceLockedAfter <- lockedOf fx.alice "X"
  aliceLockedAfter === []
  aliceUnlockedAfter <- unlockedOf fx.alice "X"
  aliceUnlockedAfter === []

-- 4. A second settle EXCEEDING the rolled-forward funding fails ------------

-- | Proves a second iteration cannot spend more than rolled funding.
testSecondIterationCannotExceedFunding : Script ()
testSecondIterationCannotExceedFunding = do
  fx <- setup ()
  aliceAlloc <- prefunded fx fx.alice "X" 100.0
  let leg1 = mkLeg "iter-1" fx.alice fx.bob 40.0 "X"
  bob1 <- sidedAlloc fx fx.bob [leg1]
  res1 <- submit fx.admin $ settleBatchCmd fx [leg1]
    [ Utils.mkFinalizedAllocation aliceAlloc
        (Utils.legsToSides (Utils.basicAccount fx.alice) [leg1])
        (Some (TextMap.fromList [("X", 60.0)]))
    , Utils.finalAllocation bob1
    ]
  nextCid <- case Utils.nextIterationAllocationCids res1 of
    [Some cid, None] -> pure cid
    _ -> abort "expected exactly the alice allocation to roll forward"
  -- 70 > the 60 rolled forward: must be rejected, not minted from thin air.
  let leg2 = mkLeg "iter-2" fx.alice fx.bob 70.0 "X"
  bob2 <- sidedAlloc fx fx.bob [leg2]
  submitMustFail fx.admin $ settleBatchCmd fx [leg2]
    [ Utils.mkFinalizedAllocation nextCid
        (Utils.legsToSides (Utils.basicAccount fx.alice) [leg2]) None
    , Utils.finalAllocation bob2
    ]

-- 5. Surplus backing returns unlocked to the authorizer --------------------

-- | Proves settlement returns unused locked backing as an unlocked holding.
testSurplusReturnedUnlocked : Script ()
testSurplusReturnedUnlocked = do
  fx <- setup ()
  aliceAlloc <- prefunded fx fx.alice "X" 100.0
  let leg = mkLeg "partial-1" fx.alice fx.bob 40.0 "X"
  bobAlloc <- sidedAlloc fx fx.bob [leg]
  result <- submit fx.admin $ settleBatchCmd fx [leg]
    [ Utils.mkFinalizedAllocation aliceAlloc
        (Utils.legsToSides (Utils.basicAccount fx.alice) [leg]) None
    , Utils.finalAllocation bobAlloc
    ]
  case result.allocationSettleResults of
    [aliceResult, bobResult] ->
      case ( TextMap.lookup "X" aliceResult.authorizerHoldingCids
           , TextMap.lookup "X" bobResult.authorizerHoldingCids
           ) of
        (Some [_], Some [_]) -> pure ()
        _ -> abort "settlement result must report sender change and receiver credit"
    _ -> abort "settlement must return one result per finalized allocation"
  -- locked 100 - sent 40 - next 0 = 60 change, unlocked, back to alice.
  aliceUnlocked <- unlockedOf fx.alice "X"
  aliceUnlocked === [60.0]
  aliceLocked <- lockedOf fx.alice "X"
  aliceLocked === []
  bobAmounts <- unlockedOf fx.bob "X"
  bobAmounts === [40.0]

-- 6. Batch-level balance: a receiver leg with no matching sender (and no
--    mint allocation) is an unbacked credit and aborts the batch ----------

-- | Proves batch settlement rejects an unbalanced receiver-side transfer leg.
testBatchRejectsUnbalancedReceiverLeg : Script ()
testBatchRejectsUnbalancedReceiverLeg = do
  fx <- setup ()
  let leg = mkLeg "unbacked-1" fx.alice fx.bob 50.0 "X"
  -- Only the receiver authorizes; sender side appears in no allocation.
  bobAlloc <- sidedAlloc fx fx.bob [leg]
  submitMustFail fx.admin $ settleBatchCmd fx [leg]
    [ Utils.finalAllocation bobAlloc ]

-- 6b. Allocation-to-leg coverage: the batch's allocations must authorize
--     exactly the legs the batch settles ------------------------------------
--
-- Both batches below conserve per instrument, so the conservation check passes
-- and the failure isolates the coverage check.

-- | Proves a batch rejects allocation authorization not used by its legs.
testBatchRejectsSuperfluousAuthorization : Script ()
testBatchRejectsSuperfluousAuthorization = do
  fx <- setup ()
  aliceAlloc <- prefunded fx fx.alice "X" 100.0
  let settled = mkLeg "covered-1" fx.alice fx.bob 40.0 "X"
      unlisted = mkLeg "unlisted-1" fx.alice fx.bob 10.0 "X"
  bobAlloc <- sidedAlloc fx fx.bob [settled, unlisted]
  -- The allocations authorize both legs; the batch only settles one of them.
  submitMustFail fx.admin $ settleBatchCmd fx [settled]
    [ Utils.mkFinalizedAllocation aliceAlloc
        (Utils.legsToSides (Utils.basicAccount fx.alice) [settled, unlisted]) None
    , Utils.finalAllocation bobAlloc
    ]

-- | Proves a batch rejects a transfer leg lacking allocation authorization.
testBatchRejectsMissingAuthorization : Script ()
testBatchRejectsMissingAuthorization = do
  fx <- setup ()
  aliceAlloc <- prefunded fx fx.alice "X" 100.0
  let authorized = mkLeg "covered-1" fx.alice fx.bob 40.0 "X"
      unauthorized = mkLeg "unauthorized-1" fx.alice fx.bob 10.0 "X"
  bobAlloc <- sidedAlloc fx fx.bob [authorized]
  -- The batch settles a leg no allocation in it authorizes.
  submitMustFail fx.admin $ settleBatchCmd fx [authorized, unauthorized]
    [ Utils.mkFinalizedAllocation aliceAlloc
        (Utils.legsToSides (Utils.basicAccount fx.alice) [authorized]) None
    , Utils.finalAllocation bobAlloc
    ]

-- | Proves a batch cannot consume an allocation from another settlement domain.
testBatchRejectsAllocationFromDifferentSettlement : Script ()
testBatchRejectsAllocationFromDifferentSettlement = do
  fx <- setup ()
  aliceAlloc <- prefunded fx fx.alice "X" 100.0
  let leg = mkLeg "wrong-settlement" fx.alice fx.bob 40.0 "X"
      otherSettlement = fx.settlement with id = "another-settlement"
  bobAlloc <- sidedAlloc fx fx.bob [leg]
  submitMustFail fx.admin $
    exerciseCmd fx.settleCid V2.SettlementFactory_SettleBatch with
      settlement = otherSettlement
      transferLegs = [leg]
      allocations =
        [ Utils.mkFinalizedAllocation aliceAlloc
            (Utils.legsToSides (Utils.basicAccount fx.alice) [leg]) None
        , Utils.finalAllocation bobAlloc
        ]
      actors = [fx.admin]
      extraArgs = emptyExtraArgs

-- 7. Allocation_Settle rejects expired allocation deadlines -----------------

-- | Proves an allocation cannot settle after its settlement deadline.
testExpiredAllocationSettleRejected : Script ()
testExpiredAllocationSettleRejected = do
  fx <- setup ()
  aliceAlloc <- expiredPrefunded fx fx.alice "X" 100.0
  let leg = mkLeg "expired-allocation" fx.alice fx.bob 10.0 "X"
  bobAlloc <- sidedAlloc fx fx.bob [leg]
  submitMustFail fx.admin $ settleBatchCmd fx [leg]
    [ Utils.mkFinalizedAllocation aliceAlloc
        (Utils.legsToSides (Utils.basicAccount fx.alice) [leg]) None
    , Utils.finalAllocation bobAlloc
    ]

-- 8. Allocation withdrawal and cancellation follow the V2 actor/deadline
--    rules and return holdings under their real instrument ids --------------

-- | Proves only the authorizer can withdraw an uncommitted allocation.
testUncommittedAllocationWithdrawsOnlyAsAuthorizer : Script ()
testUncommittedAllocationWithdrawsOnlyAsAuthorizer = do
  fx <- setup ()
  x <- mintHolding fx fx.alice "X" 40.0
  y <- mintHolding fx fx.alice "Y" 15.0
  let spec = Utils.mkPrefundedAllocationSpecification
        fx.admin (Utils.basicAccount fx.alice) None
        (TextMap.fromList [("X", 40.0), ("Y", 15.0)])
  allocCid <- mkAlloc fx fx.alice spec [x, y]
  Some allocView <- queryInterfaceContractId @V2.Allocation fx.alice allocCid
  Map.lookup V2.AA_Withdraw allocView.availableActions === Some [[fx.alice]]
  Map.lookup V2.AA_Cancel allocView.availableActions === Some [[fx.admin]]
  Map.lookup V2.AA_Settle allocView.availableActions === Some [[fx.admin]]

  submitMustFail (actAs [fx.bob] <> readAs [fx.alice]) $
    exerciseCmd allocCid V2.Allocation_Withdraw with
      actors = [fx.bob]
      extraArgs = emptyExtraArgs

  result <- submit fx.alice $ exerciseCmd allocCid V2.Allocation_Withdraw with
    actors = [fx.alice]
    extraArgs = emptyExtraArgs
  result.output === V2.AllocationResult_Withdrawn
  case (TextMap.lookup "X" result.authorizerHoldingCids,
        TextMap.lookup "Y" result.authorizerHoldingCids) of
    (Some [_], Some [_]) -> pure ()
    _ -> abort "withdraw result must group released holdings by instrument id"
  unlockedX <- unlockedOf fx.alice "X"
  unlockedY <- unlockedOf fx.alice "Y"
  unlockedX === [40.0]
  unlockedY === [15.0]

-- | Proves authorizer withdrawal from committed funding is deadline-gated.
testCommittedAllocationWithdrawsOnlyAfterDeadline : Script ()
testCommittedAllocationWithdrawsOnlyAfterDeadline = do
  fx <- setup ()
  now <- getTime
  hold <- mintHolding fx fx.alice "X" 10.0
  let deadline = addRelTime now (hours 1)
      spec = V2.AllocationSpecification with
        admin = fx.admin
        authorizer = Utils.basicAccount fx.alice
        transferLegSides = []
        settlementDeadline = Some deadline
        nextIterationFunding = Some (TextMap.fromList [("X", 10.0)])
        committed = True
        meta = emptyMetadata
  allocCid <- mkAlloc fx fx.alice spec [hold]

  submitMustFail fx.alice $ exerciseCmd allocCid V2.Allocation_Withdraw with
    actors = [fx.alice]
    extraArgs = emptyExtraArgs
  passTime (hours 2)
  result <- submit fx.alice $ exerciseCmd allocCid V2.Allocation_Withdraw with
    actors = [fx.alice]
    extraArgs = emptyExtraArgs
  result.output === V2.AllocationResult_Withdrawn
  unlocked <- unlockedOf fx.alice "X"
  unlocked === [10.0]

-- | Proves indefinite commitment blocks withdrawal but preserves executor cancel.
testCommittedAllocationWithoutDeadlineCannotBeWithdrawn : Script ()
testCommittedAllocationWithoutDeadlineCannotBeWithdrawn = do
  fx <- setup ()
  hold <- mintHolding fx fx.alice "X" 10.0
  let spec = V2.AllocationSpecification with
        admin = fx.admin
        authorizer = Utils.basicAccount fx.alice
        transferLegSides = []
        settlementDeadline = None
        nextIterationFunding = Some (TextMap.fromList [("X", 10.0)])
        committed = True
        meta = emptyMetadata
  allocCid <- mkAlloc fx fx.alice spec [hold]

  submitMustFail fx.alice $ exerciseCmd allocCid V2.Allocation_Withdraw with
    actors = [fx.alice]
    extraArgs = emptyExtraArgs
  submitMustFail (actAs [fx.alice] <> readAs [fx.admin]) $
    exerciseCmd allocCid V2.Allocation_Cancel with
      actors = [fx.alice]
      extraArgs = emptyExtraArgs
  result <- submit fx.admin $ exerciseCmd allocCid V2.Allocation_Cancel with
    actors = [fx.admin]
    extraArgs = emptyExtraArgs
  result.output === V2.AllocationResult_Cancelled

-- | Proves the registry admin can clean up committed funding after expiry only.
testExpiredAllocationCanBeCancelledByAdmin : Script ()
testExpiredAllocationCanBeCancelledByAdmin = do
  fx <- setup ()
  now <- getTime
  hold <- mintHolding fx fx.alice "X" 10.0
  let deadline = addRelTime now (hours 1)
      spec = V2.AllocationSpecification with
        admin = fx.admin
        authorizer = Utils.basicAccount fx.alice
        transferLegSides = []
        settlementDeadline = Some deadline
        nextIterationFunding = Some (TextMap.fromList [("X", 10.0)])
        committed = True
        meta = emptyMetadata
      settlement = fx.settlement with executors = [fx.bob]
  allocateResult <- submit fx.alice $
    exerciseCmd fx.factoryCid V2.AllocationFactory_Allocate with
      settlement
      allocation = spec
      requestedAt = now
      inputHoldingCids = [toInterfaceContractId hold]
      actors = [fx.alice]
      extraArgs = emptyExtraArgs
  allocCid <- case allocateResult.output of
    V2.AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "allocation must complete"

  -- The registry admin has only the standard expiry-cleanup authority: it
  -- cannot cancel early, but can release the backing after the deadline.
  submitMustFail fx.admin $ exerciseCmd allocCid V2.Allocation_Cancel with
    actors = [fx.admin]
    extraArgs = emptyExtraArgs
  passTime (hours 2)
  result <- submit fx.admin $ exerciseCmd allocCid V2.Allocation_Cancel with
    actors = [fx.admin]
    extraArgs = emptyExtraArgs
  result.output === V2.AllocationResult_Cancelled
  unlocked <- unlockedOf fx.alice "X"
  unlocked === [10.0]

-- 9. TransferFactory_Transfer rejects expired executeBefore -----------------

-- | Proves the transfer factory rejects a request past `executeBefore`.
testExpiredTransferFactoryRejected : Script ()
testExpiredTransferFactoryRejected = do
  fx <- setup ()
  now <- getTime
  holdingCid <- mintHolding fx fx.alice "X" 10.0
  let transfer = V2.Transfer with
        sender = Utils.basicAccount fx.alice
        receiver = Utils.basicAccount fx.bob
        amount = 10.0
        instrumentId = V2.InstrumentId with admin = fx.admin; id = "X"
        requestedAt = now
        executeBefore = addRelTime now (hours (-1))
        inputHoldingCids = [toInterfaceContractId holdingCid]
        meta = emptyMetadata
  submitMustFail (actAs [fx.admin, fx.alice]) $
    exerciseCmd fx.transferCid V2.TransferFactory_Transfer with
      transfer
      actors = [fx.admin, fx.alice]
      extraArgs = emptyExtraArgs

-- 10. Allocate locks the notional, not the whole holding -------------------
--
-- AllocationInstructionV2 requires implementations to return change and
-- unused inputs via `authorizerChangeCids`. Locking a whole holding
-- regardless of size leaves a party with one large holding unable to fund a
-- second allocation at all -- so a market maker gets one live order per
-- holding contract and has to pre-split its capital by hand.

-- | Proves allocation locks only required notional and returns input change.
testAllocateLocksOnlyTheNotional : Script ()
testAllocateLocksOnlyTheNotional = do
  fx <- setup ()
  -- An over-collateralized input locks only the required amount.
  hold <- mintHolding fx fx.alice "USD" 10000.0
  let spec = Utils.mkPrefundedAllocationSpecification
        fx.admin (Utils.basicAccount fx.alice) None
        (TextMap.fromList [("USD", 9.0)])
  _ <- mkAlloc fx fx.alice spec [hold]

  locked <- lockedOf fx.alice "USD"
  locked === [9.0]
  -- The remainder comes straight back, spendable.
  unlocked <- unlockedOf fx.alice "USD"
  unlocked === [9991.0]

-- | Proves allocation covers notional across holdings and splits one boundary.
testAllocateDrawsAcrossHoldingsAndSplitsOnlyTheLast : Script ()
testAllocateDrawsAcrossHoldingsAndSplitsOnlyTheLast = do
  fx <- setup ()
  a <- mintHolding fx fx.alice "USD" 5.0
  b <- mintHolding fx fx.alice "USD" 5.0
  let spec = Utils.mkPrefundedAllocationSpecification
        fx.admin (Utils.basicAccount fx.alice) None
        (TextMap.fromList [("USD", 7.0)])
  _ <- mkAlloc fx fx.alice spec [a, b]

  -- First consumed whole, second split: 5 + 2 locked, 3 handed back.
  locked <- lockedOf fx.alice "USD"
  sum locked === 7.0
  unlocked <- unlockedOf fx.alice "USD"
  unlocked === [3.0]

-- | Proves exact-fit allocation creates no zero-valued change holding.
testAllocateLeavesAnExactFitUnsplit : Script ()
testAllocateLeavesAnExactFitUnsplit = do
  fx <- setup ()
  hold <- mintHolding fx fx.alice "USD" 9.0
  let spec = Utils.mkPrefundedAllocationSpecification
        fx.admin (Utils.basicAccount fx.alice) None
        (TextMap.fromList [("USD", 9.0)])
  _ <- mkAlloc fx fx.alice spec [hold]

  locked <- lockedOf fx.alice "USD"
  locked === [9.0]
  -- No zero-amount change contract on an exact fit.
  unlocked <- unlockedOf fx.alice "USD"
  unlocked === []

-- | Proves allocation rejects inputs whose combined balance is insufficient.
testAllocateStillRejectsInsufficientHoldings : Script ()
testAllocateStillRejectsInsufficientHoldings = do
  fx <- setup ()
  now <- getTime
  hold <- mintHolding fx fx.alice "USD" 5.0
  let spec = Utils.mkPrefundedAllocationSpecification
        fx.admin (Utils.basicAccount fx.alice) None
        (TextMap.fromList [("USD", 9.0)])
  submitMustFail fx.alice $ exerciseCmd fx.factoryCid V2.AllocationFactory_Allocate with
    settlement = fx.settlement; allocation = spec; requestedAt = now
    inputHoldingCids = [toInterfaceContractId hold]
    actors = [fx.alice]; extraArgs = emptyExtraArgs

-- | Proves allocation rejects malformed negative funding specifications.
testAllocateRejectsMalformedSpecification : Script ()
testAllocateRejectsMalformedSpecification = do
  fx <- setup ()
  now <- getTime
  let malformed = V2.AllocationSpecification with
        admin = fx.admin
        authorizer = Utils.basicAccount fx.alice
        transferLegSides = []
        settlementDeadline = None
        nextIterationFunding = Some (TextMap.fromList [("X", -1.0)])
        committed = False
        meta = emptyMetadata
  submitMustFail fx.alice $ exerciseCmd fx.factoryCid V2.AllocationFactory_Allocate with
    settlement = fx.settlement
    allocation = malformed
    requestedAt = now
    inputHoldingCids = []
    actors = [fx.alice]
    extraArgs = emptyExtraArgs

-- | Proves allocation actors must exactly match the authorizer account parties.
testAllocationFactoryRequiresExactAuthorizerActors : Script ()
testAllocationFactoryRequiresExactAuthorizerActors = do
  fx <- setup ()
  now <- getTime
  hold <- mintHolding fx fx.alice "X" 10.0
  let spec = Utils.mkPrefundedAllocationSpecification
        fx.admin (Utils.basicAccount fx.alice) None
        (TextMap.fromList [("X", 10.0)])
  submitMustFail (actAs [fx.alice, fx.bob]) $
    exerciseCmd fx.factoryCid V2.AllocationFactory_Allocate with
      settlement = fx.settlement
      allocation = spec
      requestedAt = now
      inputHoldingCids = [toInterfaceContractId hold]
      actors = [fx.alice, fx.bob]
      extraArgs = emptyExtraArgs
  _ <- mkAlloc fx fx.alice spec [hold]
  pure ()

-- 9. Partial fills use the allocation's rolled funding ----------------------
--
-- Decimal rounding can make `original budget - first spend` one ulp smaller
-- than `remaining quantity * limit price`. OrderMatchExecution must use the
-- allocation's actual rolled funding, so a second fill remains covered.

-- Place a funded resting order through the real placement path, so the locked
-- backing is exactly the amount OrderFundingRequest_Bind asks the trader for.
restOrder
  : Party -> Party -> Party -> ContractId V2.AllocationFactory
  -> Order.Side -> Decimal -> Decimal -> Text
  -> Script (ContractId Order.Order, ContractId V2.Allocation)
restOrder operator admin trader factoryCid side limitPrice quantity ref = do
  now <- getTime
  reqCid <- submit trader $ createCmd OFR.OrderFundingRequest with
    operator; trader
    baseInstrumentId = V2.InstrumentId with admin; id = "BTC"
    quoteInstrumentId = V2.InstrumentId with admin; id = "USDC"
    side; limitPrice; quantity; expiry = None
  bound <- submit operator $ exerciseCmd reqCid OFR.OrderFundingRequest_Bind with
    settlementRef = ref
  Some allocReq <- queryContractId operator bound.allocationRequestCid
  hold <- submit (actAs [admin, trader]) $ createCmd RegV2.Holding with
    admin; owner = trader
    instrumentId = allocReq.lockInstrumentId.id
    amount = allocReq.lockAmount
    locked = False
  let spec = Order.orderFundingSpecification
        allocReq.lockInstrumentId trader allocReq.lockAmount allocReq.expiry
      settlement = fromSome allocReq.allocationSettlement
  res <- submit trader $ exerciseCmd factoryCid V2.AllocationFactory_Allocate with
    settlement; allocation = spec; requestedAt = now
    inputHoldingCids = [toInterfaceContractId hold]
    actors = [trader]; extraArgs = emptyExtraArgs
  allocCid <- case res.output of
    V2.AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "allocation must complete"
  funded <- submit operator $ exerciseCmd bound.orderCid Order.Order_Fund with
    allocationCids = [allocCid]
    allocationRequestCid = Some bound.allocationRequestCid
  pure (funded.orderCid, allocCid)

-- | Proves GTC order funding stays uncommitted and trader-withdrawable.
testGtcOrderFundingPreservesTraderExit : Script ()
testGtcOrderFundingPreservesTraderExit = do
  operator <- allocateParty "gtc-operator"
  admin <- allocateParty "gtc-admin"
  trader <- allocateParty "gtc-trader"
  reg <- submit admin $ createCmd RegV2.Registry with
    admin; users = [operator, trader]
  let factoryCid : ContractId V2.AllocationFactory = toInterfaceContractId reg
  (orderCid, allocCid) <- restOrder operator admin trader factoryCid
    Order.Bid 10.0 2.0 "gtc-order"

  Some allocView <- queryInterfaceContractId @V2.Allocation trader allocCid
  allocView.allocation.committed === False
  allocView.allocation.settlementDeadline === None
  result <- submit trader $ exerciseCmd allocCid V2.Allocation_Withdraw with
    actors = [trader]
    extraArgs = emptyExtraArgs
  result.output === V2.AllocationResult_Withdrawn

  allocationGone <- queryInterfaceContractId @V2.Allocation trader allocCid
  assertMsg "withdraw must consume the order allocation" (isNone allocationGone)
  Some order <- queryContractId trader orderCid
  order.status === Order.OS_Funded
  returned <- unlockedOf trader "USDC"
  returned === [20.0]

-- The settle archives holdings the operator cannot see; production supplies
-- them as disclosures from the registry's choice context, a script as readAs.
-- Each side's budget is read from its own allocation, never declared here.
execMatch
  : Party -> Party -> ContractId V2.SettlementFactory -> Text -> Party -> Party
  -> ContractId Order.Order -> ContractId Order.Order
  -> ContractId V2.Allocation -> ContractId V2.Allocation
  -> Decimal -> Decimal -> Script OME.OrderMatch_ExecuteResult
execMatch operator admin settleCid matchId buyer seller
          buyOrderCid sellOrderCid buyerAllocationCid sellerAllocationCid
          fillQty fillPrice = do
  execCid <- submit operator $ createCmd OME.OrderMatchExecution with
    operator; matchId
    match = OME.MatchedOrderPair with
      buyerAccount = Utils.basicAccount buyer
      sellerAccount = Utils.basicAccount seller
      baseInstrumentId = "BTC"; quoteInstrumentId = "USDC"
      fillQty; fillPrice
    buyOrderCid; sellOrderCid
    buyerAllocationCidsByAdmin = Map.fromList [(admin, buyerAllocationCid)]
    sellerAllocationCidsByAdmin = Map.fromList [(admin, sellerAllocationCid)]
  submit (actAs [operator] <> readAs [admin]) $
    exerciseCmd execCid OME.OrderMatchExecution_Execute with
      batchesByAdmin = Map.fromList [(admin, AB.RegistryBatchInput settleCid emptyExtraArgs)]

-- | Proves partial fills derive remaining budget from the rolled allocation.
testPartialFillUsesRolledFundingBudget : Script ()
testPartialFillUsesRolledFundingBudget = do
  operator <- allocateParty "match-operator"
  admin <- allocateParty "match-admin"
  buyer <- allocateParty "match-buyer"
  seller <- allocateParty "match-seller"
  reg <- submit admin $ createCmd RegV2.Registry with
    admin; users = [operator, buyer, seller]
  let factoryCid : ContractId V2.AllocationFactory = toInterfaceContractId reg
      settleCid : ContractId V2.SettlementFactory = toInterfaceContractId reg
      limitPrice = 8.4875456707
      bidQty = 10.5993913768
      firstFill = 4.2004910968

  (bidCid, bidAllocCid) <- restOrder operator admin buyer factoryCid
    Order.Bid limitPrice bidQty "bid-1"
  (ask1Cid, ask1AllocCid) <- restOrder operator admin seller factoryCid
    Order.Ask limitPrice firstFill "ask-1"

  bidQty * limitPrice === 89.9628183922
  firstFill * limitPrice === 35.6518600235

  res1 <- execMatch operator admin settleCid "m1" buyer seller
    bidCid ask1Cid bidAllocCid ask1AllocCid firstFill limitPrice
  let bid2Cid = fromSome res1.buyRemainderCid
      bid2AllocCid = fromSome (Map.lookup admin res1.buyerNextAllocationCidsByAdmin)
  Some bid2 <- queryContractId operator bid2Cid
  bid2.remainingQty === 6.3989002800

  -- The rolled backing is one ulp below the independently recomputed face
  -- notional, and remains the authoritative budget for the next fill.
  lockedQuote <- lockedOf buyer "USDC"
  lockedQuote === [54.3109583687]
  bid2.remainingQty * limitPrice === 54.3109583688

  (ask2Cid, ask2AllocCid) <- restOrder operator admin seller factoryCid
    Order.Ask limitPrice 1.0 "ask-2"
  res2 <- execMatch operator admin settleCid "m2" buyer seller
    bid2Cid ask2Cid bid2AllocCid ask2AllocCid 1.0 limitPrice
  Some bid3 <- queryContractId operator (fromSome res2.buyRemainderCid)
  bid3.remainingQty === 5.3989002800
  stillLocked <- lockedOf buyer "USDC"
  stillLocked === [45.8234126980]
