-- | Matched-trade settlement on the V2 token standard (adapted from the
-- upstream TradingAppV2, V2-only). Genuinely cross-admin: every leg carries its
-- instrument admin, and settlement derives the required per-admin batches from
-- the trade itself rather than trusting the caller.
--
-- Design guide: `docs/concepts/design-tour.md#rfq-and-otc-settlement`.
module CantonDex.Dex.MatchedTrade where

import DA.Foldable (forA_)
import DA.Map qualified as Map
import DA.Optional (catOptionals)

import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.AllocationRequestV2 qualified as V2
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.MetadataV1
import Splice.TokenStandard.Utils qualified as TSUtils

import CantonDex.Dex.DexPair qualified as DexPair
import CantonDex.Dex.PolicyReceipt qualified as PR
import CantonDex.Trading.Utils qualified as Utils

-- | Leg of a trade: an admin-tagged transfer leg. `V2.TransferLeg.instrumentId`
-- is only the instrument's text id, so the instrument admin travels alongside
-- it here. This is the upstream `TradeLeg` shape; a flat list preserves
-- economic leg ordering and avoids a nested `GenMap` as the canonical payload.
data TradeLeg = TradeLeg with
    admin : Party
      -- ^ Admin party of the instrument being transferred.
    leg : V2.TransferLeg
  deriving (Eq, Show)

-- | Flat transfer legs of a trade, in economic order.
tradeTransferLegs : [TradeLeg] -> [V2.TransferLeg]
tradeTransferLegs tradeLegs = [tl.leg | tl <- tradeLegs]

-- | Group any legs by a derived key, preserving order (upstream shape).
splitLegsBy : Ord k => (a -> k) -> [a] -> Map.Map k [a]
splitLegsBy f legs = Map.fromListWithR (<>) [(f leg, [leg]) | leg <- legs]

-- | Group the authorized sides by the account that must authorize them, keeping
-- each side tagged with its instrument admin.
splitTradeLegsByAuthorizer
  : [TradeLeg] -> Map.Map V2.Account [(Party, V2.TransferLegSide)]
splitTradeLegsByAuthorizer legs = Map.fromListWithR (++) $ do
  tradeLeg <- legs
  (authorizer, side) <- TSUtils.transferLegSidesWithAuthorizer tradeLeg.leg
  pure (authorizer, [(tradeLeg.admin, side)])

-- A settlement plan must identify each positive transfer leg exactly once.
-- Registry settlement performs its own coverage checks; keeping the same basic
-- shape invariant on the DEX contract makes malformed trades impossible to
-- publish in the first place.
validTransferLegs : [V2.TransferLeg] -> Bool
validTransferLegs legs =
  legs /= []
    && all
      (\leg ->
        leg.transferLegId /= ""
          && leg.instrumentId /= ""
          && leg.amount > 0.0
          && leg.sender /= leg.receiver)
      legs
    && uniqueTexts [leg.transferLegId | leg <- legs]
  where
    uniqueTexts xs =
      length xs
        == length (foldl (\seen x -> if x `elem` seen then seen else x :: seen) [] xs)

-- | Every account party appearing across a request's specifications.
affectedAccountParties : TradeAllocationRequest -> [Party]
affectedAccountParties req =
  concatMap (Utils.accountParties . (.authorizer)) req.allocations

template TradeAllocationRequest with
    settlement : V2.SettlementInfo
    settleAt : Optional Time
    requestedAt : Time
    allocations : [V2.AllocationSpecification]
      -- ^ One specification per (authorizer, admin). The wallet composes the
      --   matching `AllocationFactory_Allocate` for each in the same
      --   transaction, so an authorizer whose legs span two registries funds
      --   both in one accept.
  where
    signatory settlement.executors
    observer affectedAccountParties this

    ensure allocations /= []

    interface instance V2.AllocationRequest for TradeAllocationRequest where
      view = V2.AllocationRequestView with
        originalRequestCid = None
        settlement
        allocations
        requestedAt
        settleAt
        availableActions = Map.fromList
          [ (action, [[p] | p <- affectedAccountParties this])
          | action <- [V2.ARA_Accept, V2.ARA_Reject]
          ]
        meta = emptyMetadata

      allocationRequest_acceptExtraObservers = \_ -> []
      allocationRequest_rejectExtraObservers = \_ -> []
      allocationRequest_withdrawExtraObservers = \_ -> []

      -- Accept consumes the request; the wallet composes it with the matching
      -- AllocationFactory_Allocate choices in the same transaction.
      allocationRequest_acceptImpl = \self arg -> do
        TSUtils.archiveAndCheckActors self arg.actors
          [[p] | p <- affectedAccountParties this]
        pure V2.AllocationRequest_AcceptResult with meta = emptyMetadata
      allocationRequest_rejectImpl = \self arg -> do
        TSUtils.archiveAndCheckActors self arg.actors
          [[p] | p <- affectedAccountParties this]
        pure V2.AllocationRequest_RejectResult with meta = emptyMetadata
      allocationRequest_withdrawImpl = \self arg -> do
        TSUtils.archiveAndCheckActors self arg.actors [settlement.executors]
        pure V2.AllocationRequest_WithdrawResult with meta = emptyMetadata

-- | A batch of allocations for one admin, plus the factory and context needed
-- to settle them. The trade is the source of truth for which legs each admin
-- owns, so a batch never carries its own legs.
data SettlementBatchV2 = SettlementBatchV2 with
    allocations : [V2.FinalizedAllocation]
    factoryCid : ContractId V2.SettlementFactory
    extraArgs : ExtraArgs
  deriving (Eq, Show)

data MatchedTrade_SettleResult = MatchedTrade_SettleResult with
    resultsByAdmin : Map.Map Party V2.SettlementFactory_SettleBatchResult
  deriving (Eq, Show)

data MatchedTrade_CancelResult = MatchedTrade_CancelResult with
    cancelResults : [(V2.Account, V2.AllocationResult)]
  deriving (Eq, Show)

mkTradeSettlementInfo : ContractId MatchedTrade -> MatchedTrade -> V2.SettlementInfo
mkTradeSettlementInfo tradeCid trade = V2.SettlementInfo with
  executors = [trade.venue]
  id = "MatchedTrade"
  cid = Some (coerceContractId tradeCid)
  meta = PR.foldPolicyReceiptIntoMetadata trade.policyReceipt emptyMetadata

mkTradeSettlementArguments
  : Party
  -> V2.SettlementInfo
  -> [V2.TransferLeg]
  -> [V2.FinalizedAllocation]
  -> ExtraArgs
  -> V2.SettlementFactory_SettleBatch
mkTradeSettlementArguments venue settlement transferLegs allocations extraArgs =
  V2.SettlementFactory_SettleBatch with
    settlement
    transferLegs
    allocations
    actors = [venue]
    extraArgs

-- | Every account party appearing on the trade's legs, so a counterparty can
-- see the trade directly rather than waiting for an AllocationRequest.
legParties : [V2.TransferLeg] -> [Party]
legParties legs = dedupParties $ do
  leg <- legs
  Utils.accountParties leg.sender ++ Utils.accountParties leg.receiver
  where
    dedupParties xs = foldl (\acc p -> if p `elem` acc then acc else acc ++ [p]) [] xs

template MatchedTrade with
    venue : Party
    tradeLegs : [TradeLeg]
    settlementDeadline : Optional Time
    policyReceipt : Optional PR.PolicyReceipt
      -- ^ Optional operator-signed RFQ-policy attestation, folded into
      --   SettlementInfo.meta so it travels on-ledger with the trade.
  where
    signatory venue
    observer legParties (tradeTransferLegs tradeLegs)

    -- The receipt's claimed signer must equal the trade's signatory.
    ensure
      validTransferLegs (tradeTransferLegs tradeLegs)
        && case policyReceipt of
             None -> True
             Some r -> r.signedBy == venue && PR.isWellFormed r

    nonconsuming choice MatchedTrade_RequestAllocations : [ContractId TradeAllocationRequest]
      with
      controller venue
      do
        let settlement = mkTradeSettlementInfo self this
        now <- getTime
        results <- forA (Map.toList $ splitTradeLegsByAuthorizer tradeLegs) $
          \(authorizer, authorizerSides) ->
            if authorizer == Utils.basicAccount venue
              then pure None
              else fmap Some $ create TradeAllocationRequest with
                settlement
                settleAt = settlementDeadline
                requestedAt = now
                allocations = do
                  -- One specification per admin this authorizer touches.
                  (admin, sides) <- Map.toList $ splitLegsBy (._1) authorizerSides
                  pure V2.AllocationSpecification with
                    admin
                    authorizer
                    transferLegSides = map (._2) sides
                    settlementDeadline
                    nextIterationFunding = None
                    committed = False
                    meta = emptyMetadata
        pure $ catOptionals results

    -- Read-only discovery of each registry's settlement endpoint. The transfer
    -- legs are DERIVED from the trade (the same admin grouping `MatchedTrade_Settle`
    -- uses), never taken from the caller, so each registry returns context for the
    -- exact arguments final settlement will exercise. The caller supplies only the
    -- finalized allocations, which reference wallet-created cids the trade cannot know.
    nonconsuming choice MatchedTrade_PreviewSettlement
      : Map.Map Party V2.SettlementFactory_SettleBatch
      with
        allocationsByAdmin : Map.Map Party [V2.FinalizedAllocation]
      controller venue
      do
        let settlement = mkTradeSettlementInfo self this
            transferLegsByAdmin = splitLegsBy (.admin) tradeLegs
            expectedAdmins = Map.keys transferLegsByAdmin
        forA_ (Map.keys allocationsByAdmin) $ \a ->
          assertMsg
            ("MatchedTrade_PreviewSettlement: unexpected admin " <> show a)
            (a `elem` expectedAdmins)
        batches <- forA (Map.toList transferLegsByAdmin) $ \(admin, adminLegs) -> do
          allocations <- case Map.lookup admin allocationsByAdmin of
            Some a -> pure a
            None -> abort
              ("MatchedTrade_PreviewSettlement: missing allocations for admin " <> show admin)
          let batchLegs = map (.leg) adminLegs
          pure (admin, mkTradeSettlementArguments
            venue settlement batchLegs allocations Utils.emptyExtraArgs)
        pure (Map.fromList batches)

    choice MatchedTrade_Settle : MatchedTrade_SettleResult
      with
        batchesByAdmin : Map.Map Party SettlementBatchV2
        allocationRequests : [ContractId TradeAllocationRequest]
        dexPairCid : Optional (ContractId DexPair.DexPair)
          -- ^ When provided, fees accrue against the pair; None = no accrual.
      controller venue
      do
        let settlement = mkTradeSettlementInfo self this
            -- The trade is the source of truth for which admins and legs must
            -- settle, so both are derived here, never taken from the caller.
            transferLegsByAdmin = splitLegsBy (.admin) tradeLegs
            expectedAdmins = Map.keys transferLegsByAdmin

        -- Reject a batch for an admin the trade does not include. Every
        -- expected admin is settled below, so an extra batch is malformed.
        forA_ (Map.keys batchesByAdmin) $ \a ->
          assertMsg
            ("MatchedTrade_Settle: unexpected settlement batch for admin " <> show a)
            (a `elem` expectedAdmins)

        forA_ allocationRequests $ \reqCid -> do
          fetch reqCid
          archive reqCid

        -- Iterate the trade's own admins. Each must have exactly one batch, and
        -- each registry settles the legs derived from the trade, so a caller
        -- cannot settle only one side by omitting a registry.
        results <- forA (Map.toList transferLegsByAdmin) $ \(admin, adminLegs) -> do
          batch <- case Map.lookup admin batchesByAdmin of
            Some b -> pure b
            None -> abort
              ("MatchedTrade_Settle: missing settlement batch for admin " <> show admin)
          let batchLegs = map (.leg) adminLegs
              settlementArguments = mkTradeSettlementArguments
                venue settlement batchLegs batch.allocations batch.extraArgs
          result <- exercise batch.factoryCid settlementArguments
          pure (admin, result)

        forA_ dexPairCid $ \pairCid -> do
          -- Fees accrue per instrument across every admin the trade touches.
          -- `legNotionals` is keyed by full `InstrumentId`, so a cross-admin
          -- trade records each admin's leg notionals under its own instrument.
          let legNotionals : Map.Map V2.InstrumentId Decimal =
                foldl
                  (\m tradeLeg ->
                    let iid = V2.InstrumentId with
                          admin = tradeLeg.admin; id = tradeLeg.leg.instrumentId
                        cur = optional 0.0 identity (Map.lookup iid m)
                    in Map.insert iid (cur + tradeLeg.leg.amount) m)
                  Map.empty
                  tradeLegs
          _ <- exercise pairCid DexPair.DexPair_RecordMatchedTrade with legNotionals
          pure ()

        pure MatchedTrade_SettleResult with
          resultsByAdmin = Map.fromList results

    choice MatchedTrade_Cancel : MatchedTrade_CancelResult
      with
        allocationsToCancel : [(ContractId V2.Allocation, ExtraArgs)]
        allocationRequestCids : [ContractId TradeAllocationRequest]
      controller venue
      do
        forA_ allocationRequestCids $ \reqCid -> do
          fetch reqCid
          archive reqCid

        cancelResults <- forA allocationsToCancel $ \(allocCid, extraArgs) -> do
          alloc <- fetch allocCid
          let allocView = view alloc
          result <- exercise allocCid V2.Allocation_Cancel with
            actors = [venue]
            extraArgs
          pure (allocView.allocation.authorizer, result)

        pure MatchedTrade_CancelResult with cancelResults

-- | Immutable record of a fill that has already settled, written by the choice
-- that settled it. `MatchedTrade` is a pre-settlement proposal its own settle
-- choice archives, so it cannot serve as trade history for a flow that settles
-- inside a single choice; this contract stays in the ACS for the indexer.
template SettledTrade with
    operator : Party
    tradeLegs : [TradeLeg]
    matchId : Text
    settledAt : Time
  where
    signatory operator
    observer legParties (tradeTransferLegs tradeLegs)
