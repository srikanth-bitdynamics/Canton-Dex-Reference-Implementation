-- | Trader-initiated order placement. The trader signs intent; the operator's
-- `OrderFundingRequest_Bind` creates the pending `Order` and an
-- `OrderAllocationRequest` the trader uses to author the funding allocations.
-- Order_Fund validates and binds those allocations, then the order is Funded
-- and live.
--
-- Design guide: `docs/concepts/design-tour.md#prefunded-orders`.
module CantonDex.Dex.OrderFundingRequest where

import DA.Map qualified as Map

import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.HoldingV2 qualified as HoldingV2

import CantonDex.Dex.Order qualified as Order

template OrderFundingRequest with
    operator : Party
    trader : Party
    baseInstrumentId : HoldingV2.InstrumentId
    quoteInstrumentId : HoldingV2.InstrumentId
    side : Order.Side
    limitPrice : Decimal
    quantity : Decimal
    expiry : Optional Time
  where
    signatory trader
    observer operator

    ensure
      baseInstrumentId.id /= ""
        && quoteInstrumentId.id /= ""
        && baseInstrumentId /= quoteInstrumentId
        && quantity > 0.0
        && limitPrice > 0.0

    choice OrderFundingRequest_Cancel : ()
      controller trader
      do pure ()

    choice OrderFundingRequest_Reject : ()
      with
        reason : Text
      controller operator
      do
        debug $ "OrderFundingRequest rejected: " <> reason
        pure ()

    -- Create the pending Order and its funding specifications.
    choice OrderFundingRequest_Bind : OrderFundingRequest_BindResult
      with
        settlementRef : Text
          -- ^ Operator-chosen unique correlation reference for this order.
      controller operator
      do
        now <- getTime
        let orderRef = Order.makeOrderRefFromText settlementRef
            allocationSettlement = Order.orderBookSettlement
              operator baseInstrumentId quoteInstrumentId
            -- The order locks the instrument it must deliver and holds a receipt
            -- authorization for the instrument it receives; a single-admin pair
            -- collapses to one allocation. Order_Fund reproduces these same terms
            -- from the order, so funding never depends on this request.
            (lockInstrumentId, lockAmount, receiptAdmin) =
              Order.orderLockTerms baseInstrumentId quoteInstrumentId side quantity limitPrice
        orderCid <- create Order.Order with
          operator
          trader
          baseInstrumentId
          quoteInstrumentId
          side
          limitPrice
          remainingQty = quantity
          expiry
          status = Order.OS_Pending
          allocationCidsByAdmin = Map.empty
          settlementRef = orderRef
        allocReqCid <- create Order.OrderAllocationRequest with
          operator
          trader
          orderRef
          lockInstrumentId
          lockAmount
          receiptAdmin
          expiry
          requestedAt = now
          allocationSettlement = Some allocationSettlement
        pure OrderFundingRequest_BindResult with
          orderCid
          allocationRequestCid = allocReqCid
          settlement = Some allocationSettlement
          allocationSpecs = Order.orderAllocationSpecs
            lockInstrumentId lockAmount receiptAdmin trader expiry

data OrderFundingRequest_BindResult = OrderFundingRequest_BindResult with
    orderCid : ContractId Order.Order
    allocationRequestCid : ContractId Order.OrderAllocationRequest
    settlement : Optional V2.SettlementInfo
    allocationSpecs : [V2.AllocationSpecification]
  deriving (Eq, Show)
