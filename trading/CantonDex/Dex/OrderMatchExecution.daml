-- | Order matching settlement: both orders are already prefunded (no legs, just
-- nextIterationFunding); the matcher builds FinalizedAllocations carrying the
-- concrete leg sides + residual funding, grouped by instrument admin, and one
-- settle batch per admin consumes them. The same transaction rolls both orders
-- forward onto the allocations the settle minted and writes the settled-trade
-- record. A cross-admin pair settles one batch per registry; a single-admin
-- pair collapses to one.
--
-- Design guide: `docs/concepts/design-tour.md#prefunded-orders`.
module CantonDex.Dex.OrderMatchExecution where

import DA.Foldable (forA_)
import DA.Map qualified as Map
import DA.Optional (isNone, isSome)
import DA.TextMap qualified as TextMap

import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.MetadataV1

import CantonDex.Dex.MatchedTrade qualified as MT
import CantonDex.Dex.Order (Order, OrderStatus (..), Side (..))
import CantonDex.Trading.Utils qualified as Utils
import CantonDex.Trading.AdminBatch qualified as AB

data MatchedOrderPair = MatchedOrderPair with
    buyerAccount : V2.Account
    sellerAccount : V2.Account
    baseInstrumentId : Text
    quoteInstrumentId : Text
    fillQty : Decimal
    fillPrice : Decimal
  deriving (Eq, Show)

data OrderMatch_ExecuteResult = OrderMatch_ExecuteResult with
    settleResultsByAdmin : Map.Map Party V2.SettlementFactory_SettleBatchResult
    buyerNextAllocationCidsByAdmin : Map.Map Party (ContractId V2.Allocation)
      -- ^ The allocations the bid's settle rolled forward, keyed by admin;
      --   empty when the fill closed the bid out.
    sellerNextAllocationCidsByAdmin : Map.Map Party (ContractId V2.Allocation)
    buyRemainderCid : Optional (ContractId Order)
      -- ^ Order the bid's unfilled quantity rolled forward to; None when the
      --   fill closed it out.
    sellRemainderCid : Optional (ContractId Order)
    settledTradeCid : Optional (ContractId MT.SettledTrade)
  deriving (Eq, Show)

mkMatchTransferLegs : MatchedOrderPair -> [V2.TransferLeg]
mkMatchTransferLegs match =
  let quoteAmount = match.fillQty * match.fillPrice
  in  [ V2.TransferLeg with
          transferLegId = "base-delivery"
          sender = match.sellerAccount
          receiver = match.buyerAccount
          amount = match.fillQty
          instrumentId = match.baseInstrumentId
          meta = emptyMetadata
      , V2.TransferLeg with
          transferLegId = "quote-payment"
          sender = match.buyerAccount
          receiver = match.sellerAccount
          amount = quoteAmount
          instrumentId = match.quoteInstrumentId
          meta = emptyMetadata
      ]

-- | The budget an allocation reserved for its next iteration, as the
-- allocation itself records it. This is the amount the registry actually
-- locked, so a remainder derived from it can never exceed the backing.
allocationFunding : V2.Allocation -> Utils.Funding
allocationFunding allocation =
  optional TextMap.empty identity (view allocation).allocation.nextIterationFunding

-- | Remainder funding for one side: the reserved budget the side's
-- allocation locked, minus what this fill spends out of it (the side's
-- sender-side outflows). Non-positive entries are dropped. `None` means the
-- allocation fully settles with no roll-forward.
remainderFunding : V2.Account -> Utils.Funding -> [V2.TransferLeg] -> Optional Utils.Funding
remainderFunding authorizer fundingBudget transferLegs =
  let spent = TextMap.fromListWithR (+)
        [ (leg.instrumentId, leg.amount)
        | leg <- transferLegs
        , leg.sender == authorizer
        ]
      remaining = Utils.textMapUnionWith (-) fundingBudget spent
  in case Utils.normalizeFunding remaining of
       -- An empty residual (fill consumed the whole budget) must roll nothing
       -- forward: the allocation fully settles, so signal None rather than a
       -- zero-funded next iteration.
       Some f | null (TextMap.toList f) -> None
       other -> other

-- | The finalized allocations one order contributes, one per admin it funds.
-- Each carries the account's side of that admin's legs (the sender side under
-- the lock admin, the receiver side under the counter admin; both sides under a
-- single admin), and its next-iteration funding: the residual budget for the
-- lock allocation, an empty roll-forward for a receipt allocation, or None when
-- the order closes.
orderFragmentEntries
  : V2.Account
  -> Map.Map Party (ContractId V2.Allocation)
  -> [(Party, V2.TransferLeg)]
  -> Party
  -> Optional Utils.Funding
  -> Bool
  -> [(Party, AB.AdminFragment)]
orderFragmentEntries account allocByAdmin adminLegs lockAdmin residual open =
  [ (admin, AB.AdminFragment [] [finalized])
  | (admin, cid) <- Map.toList allocByAdmin
  , let adminLegList = [leg | (a, leg) <- adminLegs, a == admin]
        nextFunding =
          if not open then None
          else if admin == lockAdmin then residual
          else Some TextMap.empty
        finalized =
          Utils.mkFinalizedAllocation cid (Utils.legsToSides account adminLegList) nextFunding
  ]

-- | Roll one side of the match forward in the settling transaction: archive the
-- filled order and, where it stays open, recreate it bound to every allocation
-- the settle rolled forward. A closed order (budget spent or fully filled)
-- recreates nothing; its allocations all finalized without a next iteration.
rollOrderForward
  : ContractId Order
  -> Order
  -> Decimal
  -> Bool
  -> Map.Map Party (ContractId V2.Allocation)
  -> Update (Optional (ContractId Order))
rollOrderForward orderCid order filledQty open nextAllocationCidsByAdmin = do
  archive orderCid
  let newRemaining = order.remainingQty - filledQty
  if open
    then do
      assertMsg "open order must retain a positive remaining quantity" (newRemaining > 0.0)
      cid <- create order with
        remainingQty = newRemaining
        status = OS_PartiallyFilled
        allocationCidsByAdmin = nextAllocationCidsByAdmin
      pure (Some cid)
    else pure None

-- | The allocations an order rolls forward: for an order that stays open, every
-- allocation MUST advance (each read back by its own cid); for a closed order,
-- none may. Results are bound to their allocation by cid, never by position.
nextAllocationsForOrder
  : Map.Map Party AB.AdminFragment
  -> Map.Map Party V2.SettlementFactory_SettleBatchResult
  -> Map.Map Party (ContractId V2.Allocation)
  -> Bool
  -> Update (Map.Map Party (ContractId V2.Allocation))
nextAllocationsForOrder grouped results allocByAdmin open =
  if open
    then do
      entries <- forA (Map.toList allocByAdmin) $ \(admin, cid) -> do
        next <- AB.requiredNextIteration grouped results admin cid
        pure (admin, next)
      pure (Map.fromList entries)
    else do
      forA_ (Map.toList allocByAdmin) $ \(admin, cid) -> do
        next <- AB.nextIterationFor grouped results admin cid
        assertMsg "closed order allocation must not roll forward" (isNone next)
      pure Map.empty

data PreparedOrderMatch = PreparedOrderMatch with
    preparedBuyOrder : Order
    preparedSellOrder : Order
    preparedBuyOpen : Bool
    preparedSellOpen : Bool
    preparedSettlement : V2.SettlementInfo
    preparedGrouped : Map.Map Party AB.AdminFragment
    preparedTradeLegs : [MT.TradeLeg]

prepareOrderMatch
  : Party
  -> MatchedOrderPair
  -> ContractId Order
  -> ContractId Order
  -> Map.Map Party (ContractId V2.Allocation)
  -> Map.Map Party (ContractId V2.Allocation)
  -> Update PreparedOrderMatch
prepareOrderMatch
    operator match buyOrderCid sellOrderCid
    buyerAllocationCidsByAdmin sellerAllocationCidsByAdmin = do
  buyOrder <- fetch buyOrderCid
  sellOrder <- fetch sellOrderCid

  assertMsg "buy order operator mismatch" (buyOrder.operator == operator)
  assertMsg "sell order operator mismatch" (sellOrder.operator == operator)
  assertMsg "buy order must be a Bid" (buyOrder.side == Bid)
  assertMsg "sell order must be an Ask" (sellOrder.side == Ask)
  assertMsg "buy order is not funded"
    (buyOrder.status == OS_Funded || buyOrder.status == OS_PartiallyFilled)
  assertMsg "sell order is not funded"
    (sellOrder.status == OS_Funded || sellOrder.status == OS_PartiallyFilled)
  -- The allocations must be exactly the orders' own: the operator names them
  -- but cannot substitute another order's funding.
  assertMsg "buyer allocations are not the bid order's allocations"
    (buyerAllocationCidsByAdmin == buyOrder.allocationCidsByAdmin)
  assertMsg "seller allocations are not the ask order's allocations"
    (sellerAllocationCidsByAdmin == sellOrder.allocationCidsByAdmin)
  assertMsg "buyer account is not the bid trader"
    (match.buyerAccount.owner == Some buyOrder.trader)
  assertMsg "seller account is not the ask trader"
    (match.sellerAccount.owner == Some sellOrder.trader)
  -- The two orders must name the same pair. InstrumentId equality includes each
  -- registry admin, so this also agrees the base and quote admins of the match.
  assertMsg "base instrument mismatch"
    (buyOrder.baseInstrumentId == sellOrder.baseInstrumentId
      && match.baseInstrumentId == buyOrder.baseInstrumentId.id)
  assertMsg "quote instrument mismatch"
    (buyOrder.quoteInstrumentId == sellOrder.quoteInstrumentId
      && match.quoteInstrumentId == buyOrder.quoteInstrumentId.id)
  assertMsg "fill quantity must be positive" (match.fillQty > 0.0)
  assertMsg "fill exceeds bid remaining quantity"
    (match.fillQty <= buyOrder.remainingQty)
  assertMsg "fill exceeds ask remaining quantity"
    (match.fillQty <= sellOrder.remainingQty)
  assertMsg "fill price must be positive" (match.fillPrice > 0.0)
  assertMsg "fill price above bid limit" (match.fillPrice <= buyOrder.limitPrice)
  assertMsg "fill price below ask limit" (match.fillPrice >= sellOrder.limitPrice)

  let baseAdmin = buyOrder.baseInstrumentId.admin
      quoteAdmin = buyOrder.quoteInstrumentId.admin
      -- The bid locks the quote side; the ask locks the base side.
      buyLockAdmin = quoteAdmin
      sellLockAdmin = baseAdmin
      expectedAdmins = Map.keys (Map.fromList [(baseAdmin, ()), (quoteAdmin, ())])
  -- Each order funds every distinct admin of the pair: the lock admin, plus the
  -- counter admin as a receipt when the pair spans two registries.
  assertMsg "bid order allocations do not cover the pair admins"
    (Map.keys buyOrder.allocationCidsByAdmin == expectedAdmins)
  assertMsg "ask order allocations do not cover the pair admins"
    (Map.keys sellOrder.allocationCidsByAdmin == expectedAdmins)

  buyAllocViews <- forA (Map.toList buyOrder.allocationCidsByAdmin) $ \(admin, cid) -> do
    allocation <- fetch cid
    pure (admin, view allocation)
  sellAllocViews <- forA (Map.toList sellOrder.allocationCidsByAdmin) $ \(admin, cid) -> do
    allocation <- fetch cid
    pure (admin, view allocation)

  -- All of an order's allocations share one settlement whose executor is the
  -- operator; a batch under one admin and a batch under another settle it.
  settlement <- case map snd buyAllocViews of
    (v :: _) -> pure v.settlement
    [] -> abort "bid order has no allocations"
  forA_ (map snd buyAllocViews ++ map snd sellAllocViews) $ \v -> do
    assertMsg "order allocation belongs to a different settlement"
      (v.settlement == settlement)
    assertMsg "order settlement executor mismatch" (v.settlement.executors == [operator])
  forA_ buyAllocViews $ \(admin, v) -> do
    assertMsg "buyer allocation authorizer mismatch"
      (v.allocation.authorizer == match.buyerAccount)
    assertMsg "buyer allocation registry admin mismatch" (v.allocation.admin == admin)
  forA_ sellAllocViews $ \(admin, v) -> do
    assertMsg "seller allocation authorizer mismatch"
      (v.allocation.authorizer == match.sellerAccount)
    assertMsg "seller allocation registry admin mismatch" (v.allocation.admin == admin)

  let transferLegs = mkMatchTransferLegs match
  (baseDeliveryLeg, quotePaymentLeg) <- case transferLegs of
    [b, q] -> pure (b, q)
    _ -> abort "match must produce a base-delivery and a quote-payment leg"
  let adminLegs = [(baseAdmin, baseDeliveryLeg), (quoteAdmin, quotePaymentLeg)]
      -- The reserved budget each order's lock allocation still holds.
      fundingAt views admin = case lookup admin views of
        Some v -> optional TextMap.empty identity v.allocation.nextIterationFunding
        None -> TextMap.empty
      -- A fill that meets the remaining quantity closes the order; otherwise the
      -- lock allocation's residual budget decides viability — a partial base
      -- quantity is still non-viable once price and rounding exhaust it.
      sideResidual order account lockAdmin views
        | match.fillQty >= order.remainingQty = None
        | otherwise = remainderFunding account (fundingAt views lockAdmin) transferLegs
      buyResidual = sideResidual buyOrder match.buyerAccount buyLockAdmin buyAllocViews
      sellResidual = sideResidual sellOrder match.sellerAccount sellLockAdmin sellAllocViews
      buyOpen = isSome buyResidual
      sellOpen = isSome sellResidual
      -- Each leg settles under its own instrument's admin; each order's send
      -- side rides its funding allocation and its receive side its receipt
      -- allocation (both on one allocation for a single-admin pair).
      legEntries =
        [ (baseAdmin, AB.AdminFragment [baseDeliveryLeg] [])
        , (quoteAdmin, AB.AdminFragment [quotePaymentLeg] [])
        ]
      buyEntries = orderFragmentEntries match.buyerAccount buyOrder.allocationCidsByAdmin
        adminLegs buyLockAdmin buyResidual buyOpen
      sellEntries = orderFragmentEntries match.sellerAccount sellOrder.allocationCidsByAdmin
        adminLegs sellLockAdmin sellResidual sellOpen
      grouped = AB.groupByAdmin (legEntries ++ buyEntries ++ sellEntries)
      tradeLegs =
        [ MT.TradeLeg with admin = baseAdmin; leg = baseDeliveryLeg
        , MT.TradeLeg with admin = quoteAdmin; leg = quotePaymentLeg
        ]

  pure PreparedOrderMatch with
    preparedBuyOrder = buyOrder
    preparedSellOrder = sellOrder
    preparedBuyOpen = buyOpen
    preparedSellOpen = sellOpen
    preparedSettlement = settlement
    preparedGrouped = grouped
    preparedTradeLegs = tradeLegs

template OrderMatchExecution with
    operator : Party
    matchId : Text
    match : MatchedOrderPair
    buyOrderCid : ContractId Order
      -- ^ The resting bid being filled. Fetched at execute time so the fill
      --   price/qty/instruments are checked against the order's own terms
      --   rather than trusted from the off-ledger matcher.
    sellOrderCid : ContractId Order
      -- ^ The resting ask being filled.
    buyerAllocationCidsByAdmin : Map.Map Party (ContractId V2.Allocation)
      -- ^ The bid's allocations, per admin; verified to equal the order's own.
    sellerAllocationCidsByAdmin : Map.Map Party (ContractId V2.Allocation)
  where
    signatory operator

    -- Read-only discovery surface for each registry's canonical settlement
    -- endpoint. Execution repeats the same preparation against live state, so
    -- any intervening order or allocation change aborts rather than settling
    -- a stale preview.
    choice OrderMatchExecution_PreviewSettlement
      : Map.Map Party V2.SettlementFactory_SettleBatch
      controller operator
      do
        prepared <- prepareOrderMatch
          operator match buyOrderCid sellOrderCid
          buyerAllocationCidsByAdmin sellerAllocationCidsByAdmin
        pure $ AB.previewByAdmin prepared.preparedSettlement [operator] prepared.preparedGrouped

    choice OrderMatchExecution_Execute : OrderMatch_ExecuteResult
      with
        batchesByAdmin : Map.Map Party AB.RegistryBatchInput
          -- ^ One settlement factory + operation-specific context per instrument
          --   admin; a single-admin pair supplies one entry.
      controller operator
      do
        prepared <- prepareOrderMatch
          operator match buyOrderCid sellOrderCid
          buyerAllocationCidsByAdmin sellerAllocationCidsByAdmin
        settleResultsByAdmin <- AB.settleByAdmin
          prepared.preparedSettlement [operator] prepared.preparedGrouped batchesByAdmin

        -- Tagged roll-forward: read each order's next-iteration allocations by
        -- cid, then create every remainder in the same transaction as the
        -- allocations it references.
        buyerNext <- nextAllocationsForOrder
          prepared.preparedGrouped settleResultsByAdmin
          prepared.preparedBuyOrder.allocationCidsByAdmin prepared.preparedBuyOpen
        sellerNext <- nextAllocationsForOrder
          prepared.preparedGrouped settleResultsByAdmin
          prepared.preparedSellOrder.allocationCidsByAdmin prepared.preparedSellOpen

        buyRemainderCid <- rollOrderForward
          buyOrderCid prepared.preparedBuyOrder match.fillQty
          prepared.preparedBuyOpen buyerNext
        sellRemainderCid <- rollOrderForward
          sellOrderCid prepared.preparedSellOrder match.fillQty
          prepared.preparedSellOpen sellerNext

        now <- getTime
        settledTradeCid <- create MT.SettledTrade with
          operator
          tradeLegs = prepared.preparedTradeLegs
          matchId
          settledAt = now

        pure OrderMatch_ExecuteResult with
          settleResultsByAdmin
          buyerNextAllocationCidsByAdmin = buyerNext
          sellerNextAllocationCidsByAdmin = sellerNext
          buyRemainderCid
          sellRemainderCid
          settledTradeCid = Some settledTradeCid

    -- Explicitly consumes an execution proposal that can no longer settle.
    choice OrderMatchExecution_Abort : ()
      controller operator
      do pure ()
