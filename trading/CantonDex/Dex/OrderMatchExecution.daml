-- | Order matching settlement: both orders are already prefunded (no legs, just
-- nextIterationFunding); the matcher builds FinalizedAllocations carrying the
-- concrete leg sides + residual funding, and one settle batch consumes them.
-- The same transaction rolls both orders forward onto the allocations the
-- settle minted and writes the settled-trade record.
module CantonDex.Dex.OrderMatchExecution where

import DA.TextMap qualified as TextMap

import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.MetadataV1

import CantonDex.Dex.MatchedTrade qualified as MT
import CantonDex.Dex.Order (Order, OrderStatus (..), Side (..))
import CantonDex.Trading.Utils qualified as Utils

data MatchedOrderPair = MatchedOrderPair with
    buyerAccount : V2.Account
    sellerAccount : V2.Account
    baseInstrumentId : Text
    quoteInstrumentId : Text
    fillQty : Decimal
    fillPrice : Decimal
  deriving (Eq, Show)

data OrderMatch_ExecuteResult = OrderMatch_ExecuteResult with
    settleResult : V2.SettlementFactory_SettleBatchResult
    buyerNextAllocationCid : Optional (ContractId V2.Allocation)
    sellerNextAllocationCid : Optional (ContractId V2.Allocation)
    buyRemainderCid : Optional (ContractId Order)
      -- ^ Order the bid's unfilled quantity rolled forward to; None when the
      --   fill closed it out.
    sellRemainderCid : Optional (ContractId Order)
    settledTradeCid : ContractId MT.SettledTrade
  deriving (Eq, Show)

mkOrderMatchRefId : Text -> Text
mkOrderMatchRefId matchId = "OrderMatch-" <> matchId

mkMatchTransferLegs : MatchedOrderPair -> [V2.TransferLeg]
mkMatchTransferLegs match =
  let quoteAmount = match.fillQty * match.fillPrice
  in  [ V2.TransferLeg with
          transferLegId = "base-delivery"
          sender = match.sellerAccount
          receiver = match.buyerAccount
          amount = match.fillQty
          instrumentId = match.baseInstrumentId
          meta = emptyMetadata
      , V2.TransferLeg with
          transferLegId = "quote-payment"
          sender = match.buyerAccount
          receiver = match.sellerAccount
          amount = quoteAmount
          instrumentId = match.quoteInstrumentId
          meta = emptyMetadata
      ]

-- | The budget an allocation reserved for its next iteration, as the
-- allocation itself records it. This is the amount the registry actually
-- locked, so a remainder derived from it can never exceed the backing.
allocationFunding : V2.Allocation -> Utils.Funding
allocationFunding allocation =
  optional TextMap.empty identity (view allocation).allocation.nextIterationFunding

-- | Remainder funding for one side: the committed budget the side's
-- allocation locked, minus what this fill spends out of it (the side's
-- sender-side outflows). Non-positive entries are dropped. `None` (no
-- committed budget) means the allocation fully settles with no roll-forward.
remainderFunding : V2.Account -> Utils.Funding -> [V2.TransferLeg] -> Optional Utils.Funding
remainderFunding authorizer committedBudget transferLegs =
  let spent = TextMap.fromListWithR (+)
        [ (leg.instrumentId, leg.amount)
        | leg <- transferLegs
        , leg.sender == authorizer
        ]
      remaining = Utils.textMapUnionWith (-) committedBudget spent
  in case Utils.normalizeFunding remaining of
       -- An empty residual (fill consumed the whole budget) must roll nothing
       -- forward: the allocation fully settles, so signal None rather than a
       -- zero-funded next iteration.
       Some f | null (TextMap.toList f) -> None
       other -> other

-- | Roll one side of the match forward in the settling transaction: archive the
-- filled order and, where quantity remains, recreate it bound to the allocation
-- the settle rolled its residual budget into.
--
-- `residualFunding` is what this fill left of the side's committed budget. None
-- means the budget is spent: the residual quantity has nothing behind it and no
-- later fill could back it, so the order is closed out rather than created
-- unbacked (an unbacked order is matchable, and every match against it aborts).
-- The funds are not stranded — the budget genuinely went into this fill. The
-- mirror case, budget left behind an order this fill closes, has no release
-- path at all and is rejected.
rollOrderForward
  : ContractId Order
  -> Order
  -> Decimal
  -> Optional Utils.Funding
  -> Optional (ContractId V2.Allocation)
  -> Update (Optional (ContractId Order))
rollOrderForward orderCid order filledQty residualFunding nextAllocationCid = do
  archive orderCid
  let newRemaining = order.remainingQty - filledQty
  case (residualFunding, nextAllocationCid) of
    (None, None) -> pure None
    (Some _, Some allocCid)
      | newRemaining > 0.0 -> do
          cid <- create order with
            remainingQty = newRemaining
            status = OS_PartiallyFilled
            allocationCid = Some allocCid
          pure (Some cid)
      | otherwise -> abort "fully filled order must not roll funding forward"
    _ -> abort "residual funding and rolled-forward allocation disagree"

template OrderMatchExecution with
    operator : Party
    matchId : Text
    match : MatchedOrderPair
    buyOrderCid : ContractId Order
      -- ^ The resting bid being filled. Fetched at execute time so the fill
      --   price/qty/instruments are checked against the order's own terms
      --   rather than trusted from the off-ledger matcher.
    sellOrderCid : ContractId Order
      -- ^ The resting ask being filled.
    buyerAllocationCid : ContractId V2.Allocation
    sellerAllocationCid : ContractId V2.Allocation
  where
    signatory operator

    choice OrderMatchExecution_Execute : OrderMatch_ExecuteResult
      with
        factoryCid : ContractId V2.SettlementFactory
        extraArgs : ExtraArgs
          -- ^ Registry choice context for the SettleBatch. The caller
          --   fetches this off-ledger (`getChoiceContext admin`); empty for
          --   the self-registry, real for a context-requiring registry.
      controller operator
      do
        -- Price/quantity/instrument enforcement at match time (finding D-1).
        -- The off-ledger matcher proposes `match`; this choice fetches both
        -- orders and refuses any fill the orders' own terms do not permit, so
        -- a buggy or malicious matcher cannot fill a resting order outside its
        -- limit price or for instruments/quantities it never agreed to.
        buyOrder <- fetch buyOrderCid
        sellOrder <- fetch sellOrderCid

        assertMsg "buy order operator mismatch" (buyOrder.operator == operator)
        assertMsg "sell order operator mismatch" (sellOrder.operator == operator)
        assertMsg "buy order must be a Bid" (buyOrder.side == Bid)
        assertMsg "sell order must be an Ask" (sellOrder.side == Ask)

        -- A never-funded order has no collateral behind it, so a fill would be
        -- recorded against nothing.
        assertMsg "buy order is not funded"
          (buyOrder.status == OS_Funded || buyOrder.status == OS_PartiallyFilled)
        assertMsg "sell order is not funded"
          (sellOrder.status == OS_Funded || sellOrder.status == OS_PartiallyFilled)

        -- Without this the fill can spend the collateral of a DIFFERENT resting
        -- order of the same trader: the batch still conserves, so nothing
        -- downstream catches it, and that other order is left bound to an
        -- archived allocation.
        assertMsg "buyer allocation is not the bid order's allocation"
          (buyOrder.allocationCid == Some buyerAllocationCid)
        assertMsg "seller allocation is not the ask order's allocation"
          (sellOrder.allocationCid == Some sellerAllocationCid)

        -- The match's accounts must be the orders' own traders, so the legs
        -- move the actual order owners' funds (not third parties').
        assertMsg "buyer account is not the bid trader"
          (match.buyerAccount.owner == Some buyOrder.trader)
        assertMsg "seller account is not the ask trader"
          (match.sellerAccount.owner == Some sellOrder.trader)

        -- Instrument ids are only meaningful under a registry admin, so two
        -- orders naming the same id under different admins are different
        -- instruments.
        assertMsg "registry admin mismatch" (buyOrder.admin == sellOrder.admin)

        -- Instruments must agree across both orders and the match.
        assertMsg "base instrument mismatch"
          (buyOrder.baseInstrumentId == sellOrder.baseInstrumentId
            && match.baseInstrumentId == buyOrder.baseInstrumentId)
        assertMsg "quote instrument mismatch"
          (buyOrder.quoteInstrumentId == sellOrder.quoteInstrumentId
            && match.quoteInstrumentId == buyOrder.quoteInstrumentId)

        -- Quantity must be positive and within both orders' remaining size.
        assertMsg "fill quantity must be positive" (match.fillQty > 0.0)
        assertMsg "fill exceeds bid remaining quantity"
          (match.fillQty <= buyOrder.remainingQty)
        assertMsg "fill exceeds ask remaining quantity"
          (match.fillQty <= sellOrder.remainingQty)

        -- Price band: a buyer never pays above their limit and a seller never
        -- receives below theirs. A crossing book guarantees such a price exists
        -- (bid limit >= ask limit); the cleared fill price must sit in [ask, bid].
        assertMsg "fill price must be positive" (match.fillPrice > 0.0)
        assertMsg "fill price above bid limit"
          (match.fillPrice <= buyOrder.limitPrice)
        assertMsg "fill price below ask limit"
          (match.fillPrice >= sellOrder.limitPrice)

        let transferLegs = mkMatchTransferLegs match
            settlement = V2.SettlementInfo with
              executors = [operator]
              id = mkOrderMatchRefId matchId
              cid = None
              meta = emptyMetadata

        buyerAllocation <- fetch buyerAllocationCid
        sellerAllocation <- fetch sellerAllocationCid

        -- Each side authorizes both legs; legsToSides projects each account's
        -- own sides. The budget the remainder comes out of is the allocation's
        -- own, never a caller-supplied one: a budget recomputed from the
        -- order's face terms can round an ulp above the residual the previous
        -- fill rolled forward, and every later settle of that allocation then
        -- aborts on the registry's coverage check. A side the fill closes out
        -- rolls nothing forward, so its surplus is released rather than locked
        -- behind an order that is gone.
        let sideFunding : Order -> V2.Allocation -> V2.Account -> Optional Utils.Funding
            sideFunding order allocation account
              | match.fillQty >= order.remainingQty = None
              | otherwise =
                  remainderFunding account (allocationFunding allocation) transferLegs
            buyerFunding = sideFunding buyOrder buyerAllocation match.buyerAccount
            sellerFunding = sideFunding sellOrder sellerAllocation match.sellerAccount
            buyerFinalized = Utils.mkFinalizedAllocation
              buyerAllocationCid
              (Utils.legsToSides match.buyerAccount transferLegs)
              buyerFunding
            sellerFinalized = Utils.mkFinalizedAllocation
              sellerAllocationCid
              (Utils.legsToSides match.sellerAccount transferLegs)
              sellerFunding

        settleResult <- exercise factoryCid V2.SettlementFactory_SettleBatch with
          settlement
          transferLegs
          allocations = [buyerFinalized, sellerFinalized]
          actors = [operator]
          extraArgs

        let nextIterCids = Utils.nextIterationAllocationCids settleResult
            buyerNext = case nextIterCids of
              (cid :: _) -> cid
              _ -> None
            sellerNext = case nextIterCids of
              (_ :: cid :: _) -> cid
              _ -> None

        -- Both orders roll forward here, not in a follow-up submission: the
        -- settle has archived the allocations they are bound to, so an order
        -- left behind by a failure between the two would be uncancellable
        -- (Order_Cancel exercises the archived cid) and unfillable for ever.
        buyRemainderCid <- rollOrderForward
          buyOrderCid buyOrder match.fillQty buyerFunding buyerNext
        sellRemainderCid <- rollOrderForward
          sellOrderCid sellOrder match.fillQty sellerFunding sellerNext

        now <- getTime
        settledTradeCid <- create MT.SettledTrade with
          operator
          admin = buyOrder.admin
          matchId
          transferLegs
          settledAt = now

        pure OrderMatch_ExecuteResult with
          settleResult
          buyerNextAllocationCid = buyerNext
          sellerNextAllocationCid = sellerNext
          buyRemainderCid
          sellRemainderCid
          settledTradeCid

    choice OrderMatchExecution_Abort : ()
      controller operator
      do pure ()
