-- | Liquidity add/remove at the pool boundary.
--
-- The pool stays operator-custodied between operations. Add/remove settle
-- as DvP: base and quote each under their instrument's admin, LP mint/burn
-- under `pool.lpRegistrar`.
--
-- Design guide: `docs/concepts/design-tour.md#liquidity-and-pool-custody`.
module CantonDex.Dex.PoolLiquidityRules where

import DA.Assert (assertWithinDeadline)
import DA.Foldable (forA_)
import DA.List (dedup)
import DA.Map qualified as Map
import DA.TextMap qualified as TextMap

import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.AllocationInstructionV2 qualified as V2
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.MetadataV1

import CantonDex.Dex.Pool
import CantonDex.Dex.PoolState qualified as PS
import CantonDex.Dex.PoolSlice qualified as PSlice
import CantonDex.Dex.PoolModel qualified as PM
import CantonDex.Dex.PoolExecution qualified as PE
import CantonDex.Lp.Policy qualified as LP
import CantonDex.Dex.LiquidityAllocationRequest qualified as LAR
import CantonDex.Lp.Instrument qualified as Lp
import CantonDex.Trading.Utils qualified as Utils
import CantonDex.Trading.AdminBatch qualified as AB

data PoolLiquidityRules_SettleAddResult = PoolLiquidityRules_SettleAddResult with
    poolStateCid : ContractId PS.PoolState
    baseSliceCid : ContractId PSlice.PoolSlice
    quoteSliceCid : ContractId PSlice.PoolSlice
    lpPolicyCid : ContractId LP.LPTokenPolicy
    lpTokensMinted : Decimal
    baseAdded : Optional Decimal
      -- ^ The ratio-matched part of the deposit that entered the reserves;
      --   the rest of the requested amount was refunded to the provider.
    quoteAdded : Optional Decimal
  deriving (Eq, Show)

data PoolLiquidityRules_SettleRemoveResult = PoolLiquidityRules_SettleRemoveResult with
    poolStateCid : ContractId PS.PoolState
    boundaryBaseSliceCid : Optional (ContractId PSlice.PoolSlice)
    boundaryQuoteSliceCid : Optional (ContractId PSlice.PoolSlice)
    lpPolicyCid : ContractId LP.LPTokenPolicy
    baseReturned : Decimal
    quoteReturned : Decimal
  deriving (Eq, Show)

-- Operator-authored committed receiver allocation over `leg` (receives into
-- the pool). Funding is applied on the FinalizedAllocation at settle, not at
-- allocate time (avoids the factory coverage check), mirroring swap.
mkOperatorReceiver
  : Party -> Party -> V2.SettlementInfo -> V2.TransferLeg -> Time -> ExtraArgs
  -> V2.AllocationFactory_Allocate
mkOperatorReceiver operator admin settlement leg requestedAt extraArgs =
  let poolAccount = Utils.basicAccount operator
  in V2.AllocationFactory_Allocate with
       settlement
       allocation = V2.AllocationSpecification with
         admin
         authorizer = poolAccount
         transferLegSides = Utils.legsToSides poolAccount [leg]
         settlementDeadline = None
         -- Some(empty) enables iterated settlement with zero initial funding,
         -- allowing incoming deposit credits to become the next pool slice.
         nextIterationFunding = Some TextMap.empty
         -- Pool inventory is a long-lived operator-authored allocation. With no
         -- deadline, the operator authorizer cannot withdraw it. The operator is
         -- also the settlement executor and can cancel it through
         -- `Allocation_Cancel`; an LP holder cannot. This is operator custody,
         -- not an LP-holder withdrawal right. See the design guide for the exit
         -- and liveness trade-off.
         committed = True
         meta = emptyMetadata
       requestedAt
       inputHoldingCids = []
       actors = [operator]
       extraArgs

-- Enforce the deadline carried on an allocation.
enforceAllocationDeadline : ContractId V2.Allocation -> Update ()
enforceAllocationDeadline cid = do
  v <- view <$> fetch cid
  case v.allocation.settlementDeadline of
    None -> pure ()
    Some deadline -> assertWithinDeadline "settlementDeadline" deadline

-- Small tolerance for conservative off-ledger quotes.
lpMintDustTolerance : Decimal
lpMintDustTolerance = 0.000001

-- The amount on one named transfer-leg side.
allocationLegAmount : Text -> ContractId V2.Allocation -> Update Decimal
allocationLegAmount legId cid = do
  v <- view <$> fetch cid
  case find (\s -> s.transferLegId == legId) v.allocation.transferLegSides of
    Some s -> pure s.amount
    None -> abort ("allocation missing expected leg: " <> legId)

-- Validation terms supplied by one of the two supported wallet integration
-- modes: a live request for direct allocation, or an acceptance receipt after
-- AllocationRequest_Accept consumes that request.
data LiquidityBinding = LiquidityBinding with
    lp : Party
    settlement : V2.SettlementInfo
    allocations : [V2.AllocationSpecification]
    settleAt : Optional Time

-- Resolve the settle binding. Exactly one source must be present.
resolveBinding
  : Optional (ContractId LAR.LiquidityAllocationRequest)
  -> Optional (ContractId LAR.LiquidityAllocationAcceptance)
  -> Update LiquidityBinding
resolveBinding mReq mAcc = case (mReq, mAcc) of
  (Some r, None) -> do
    req <- fetch r
    pure LiquidityBinding with
      lp = req.lp; settlement = req.settlement
      allocations = req.allocations; settleAt = req.settleAt
  (None, Some a) -> do
    acc <- fetch a
    pure LiquidityBinding with
      lp = acc.lp; settlement = acc.settlement
      allocations = acc.allocations; settleAt = acc.settleAt
  (Some _, Some _) ->
    abort "settle requires exactly one of requestCid or acceptanceCid"
  (None, None) ->
    abort "settle requires a live request or acceptance evidence"

-- Validate the supplied allocations against the resolved binding.
validateAgainstBinding
  : LiquidityBinding
  -> Party
  -> V2.SettlementInfo
  -> [ContractId V2.Allocation]
  -> Update ()
validateAgainstBinding binding expectedParty settlement allocCids = do
  assertMsg "settle settlement must match the accepted request/evidence"
    (binding.settlement == settlement)
  assertMsg "request party must match the settle recipient/holder"
    (binding.lp == expectedParty)
  case binding.settleAt of
    None -> pure ()
    Some deadline -> assertWithinDeadline "settleAt" deadline
  -- Every supplied allocation must match one requested spec.
  forA_ allocCids $ \cid -> do
    v <- view <$> fetch cid
    assertMsg "supplied allocation does not match any spec in the request"
      (v.allocation `elem` binding.allocations)

-- Archive whichever binding source(s) were supplied, as settle-time cleanup
-- (the canonical pattern: the app consumes the request/evidence at settle).
archiveBinding
  : Optional (ContractId LAR.LiquidityAllocationRequest)
  -> Optional (ContractId LAR.LiquidityAllocationAcceptance)
  -> Update ()
archiveBinding mReq mAcc = do
  forA_ mReq archive
  forA_ mAcc archive

-- Canonical leg + spec builders shared by request creation, tests, and
-- wallet flows.

dvpLeg : Text -> V2.Account -> V2.Account -> Decimal -> Text -> V2.TransferLeg
dvpLeg legId sender receiver amount instrumentId = V2.TransferLeg with
  transferLegId = legId; sender; receiver; amount; instrumentId; meta = emptyMetadata

dvpSpec : Party -> V2.Account -> [V2.TransferLeg] -> Bool -> V2.AllocationSpecification
dvpSpec admin authorizer legs committed = V2.AllocationSpecification with
  admin; authorizer
  transferLegSides = Utils.legsToSides authorizer legs
  settlementDeadline = None; nextIterationFunding = None; committed
  meta = emptyMetadata

-- A deposit leg is committed, but the settle takes only the ratio-matched part
-- of it and refunds the rest in the same batch. V2 permits the executor to add
-- that refund side only on an iterated-enabled allocation, hence Some(empty).
depositSpec : Party -> V2.Account -> V2.TransferLeg -> V2.AllocationSpecification
depositSpec admin authorizer leg =
  (dvpSpec admin authorizer [leg] True) with nextIterationFunding = Some TextMap.empty

-- The three add specs the LP authors.
addLiquiditySpecs
  : Pool -> Party -> Party -> Decimal -> Decimal -> Decimal -> [V2.AllocationSpecification]
addLiquiditySpecs pool operator recipient baseAmount quoteAmount lpAmount =
  let lpAcct = Utils.basicAccount recipient
      opAcct = Utils.basicAccount operator
      baseLeg = dvpLeg "lp-base-deposit" lpAcct opAcct baseAmount pool.baseInstrumentId.id
      quoteLeg = dvpLeg "lp-quote-deposit" lpAcct opAcct quoteAmount pool.quoteInstrumentId.id
      mintLeg = Lp.lpMintLeg lpAcct pool.lpInstrumentId.id lpAmount
  in [ depositSpec pool.baseInstrumentId.admin lpAcct baseLeg
     , depositSpec pool.quoteInstrumentId.admin lpAcct quoteLeg
     , Lp.mintReceiptSpec pool.lpRegistrar lpAcct mintLeg ]

-- The three remove specs the holder authors.
removeLiquiditySpecs
  : Pool -> Party -> Party -> [Decimal] -> [Decimal] -> Decimal -> [V2.AllocationSpecification]
removeLiquiditySpecs pool operator holder baseOuts quoteOuts lpBurnAmount =
  let holderAcct = Utils.basicAccount holder
      opAcct = Utils.basicAccount operator
      outLegs prefix instrumentId amounts =
        [ dvpLeg (prefix <> show (i : Int)) opAcct holderAcct amt instrumentId
        | (i, amt) <- zip [0 .. length amounts - 1] amounts ]
      baseLegs = outLegs "lp-base-out-" pool.baseInstrumentId.id baseOuts
      quoteLegs = outLegs "lp-quote-out-" pool.quoteInstrumentId.id quoteOuts
      burnLeg = Lp.lpBurnLeg holderAcct pool.lpInstrumentId.id lpBurnAmount
  in [ dvpSpec pool.baseInstrumentId.admin holderAcct baseLegs False
     , dvpSpec pool.quoteInstrumentId.admin holderAcct quoteLegs False
     , dvpSpec pool.lpRegistrar holderAcct [burnLeg] True ]

data AddLiquidityAllocationPlan = AddLiquidityAllocationPlan with
    baseReceiver : V2.AllocationFactory_Allocate
    quoteReceiver : V2.AllocationFactory_Allocate
    lpMintSender : V2.AllocationFactory_Allocate
  deriving (Eq, Show)

data RemoveLiquidityAllocationPlan = RemoveLiquidityAllocationPlan with
    lpBurnReceiver : V2.AllocationFactory_Allocate
  deriving (Eq, Show)

data PreparedAddLiquidity = PreparedAddLiquidity with
    addPool : Pool
    addState : PS.PoolState
    addRecipientAccount : V2.Account
    addOperatorAccount : V2.Account
    addSettlement : V2.SettlementInfo
    addBaseDepositLeg : V2.TransferLeg
    addQuoteDepositLeg : V2.TransferLeg
    addBaseRefundLegs : [V2.TransferLeg]
    addQuoteRefundLegs : [V2.TransferLeg]
    addLpMintLeg : V2.TransferLeg
    addLpAmount : Decimal
    addBaseUsed : Decimal
    addQuoteUsed : Decimal

prepareAddLiquidity
  : Party
  -> Party
  -> PoolId
  -> ContractId Pool
  -> ContractId PS.PoolState
  -> ContractId LP.LPTokenPolicy
  -> Optional (ContractId LAR.LiquidityAllocationRequest)
  -> Optional (ContractId LAR.LiquidityAllocationAcceptance)
  -> Party
  -> ContractId V2.Allocation
  -> ContractId V2.Allocation
  -> ContractId V2.Allocation
  -> Decimal
  -> Decimal
  -> Decimal
  -> Decimal
  -> Update PreparedAddLiquidity
prepareAddLiquidity
    operator lpRegistrar expectedPoolId poolCid poolStateCid lpPolicyCid
    requestCid acceptanceCid recipient lpBaseDepositCid lpQuoteDepositCid
    lpReceiptCid baseAmount quoteAmount minLpTokens knownTotalLpSupply = do
  forA_ [lpBaseDepositCid, lpQuoteDepositCid, lpReceiptCid]
    enforceAllocationDeadline
  binding <- resolveBinding requestCid acceptanceCid
  let settlement = PM.poolSettlement poolCid operator
  validateAgainstBinding binding recipient settlement
    [lpBaseDepositCid, lpQuoteDepositCid, lpReceiptCid]
  (pool, state) <- PM.fetchPoolContext operator expectedPoolId poolCid poolStateCid
  assertMsg "Pool cannot be Paused" (state.status /= PS_Paused)
  assertMsg "LP registrar mismatch" (pool.lpRegistrar == lpRegistrar)
  assertMsg "Base amount must be positive" (baseAmount > 0.0)
  assertMsg "Quote amount must be positive" (quoteAmount > 0.0)
  assertMsg "recorded LP supply must be non-negative" (state.totalLpSupply >= 0.0)
  policy <- fetch lpPolicyCid
  assertMsg "LP policy supply must be non-negative" (policy.totalSupply >= 0.0)
  assertMsg "LPTokenPolicy/PoolState supply divergence"
    (policy.totalSupply == state.totalLpSupply)
  assertMsg "knownTotalLpSupply must match recorded supply"
    (knownTotalLpSupply == state.totalLpSupply)

  let recipientAcct = Utils.basicAccount recipient
      operatorAcct = Utils.basicAccount operator
      fairLp =
        if state.totalLpSupply == 0.0
        then PM.sqrtDecimal (baseAmount * quoteAmount)
        else min ((baseAmount * state.totalLpSupply) / state.reserves.baseAmount)
                 ((quoteAmount * state.totalLpSupply) / state.reserves.quoteAmount)
  lpAmount <- allocationLegAmount "lp-mint" lpReceiptCid
  assertMsg "LP tokens below minimum" (lpAmount >= minLpTokens)
  assertMsg "LP receipt exceeds fair share beyond dust tolerance"
    (lpAmount - fairLp <= lpMintDustTolerance)
  assertMsg "LP receipt shortfall beyond dust tolerance"
    (fairLp - lpAmount <= lpMintDustTolerance)

  let (baseUsed, quoteUsed) =
        if state.totalLpSupply == 0.0
          then (baseAmount, quoteAmount)
          else PM.ratioMatchedDeposit state.reserves baseAmount quoteAmount
      baseRefund = baseAmount - baseUsed
      quoteRefund = quoteAmount - quoteUsed
  assertMsg "Ratio-matched deposit must be positive on both sides"
    (baseUsed > 0.0 && quoteUsed > 0.0)

  let baseDepositLeg = dvpLeg
        "lp-base-deposit" recipientAcct operatorAcct baseAmount pool.baseInstrumentId.id
      quoteDepositLeg = dvpLeg
        "lp-quote-deposit" recipientAcct operatorAcct quoteAmount pool.quoteInstrumentId.id
      refundLeg legId instrumentId amount =
        dvpLeg legId operatorAcct recipientAcct amount instrumentId
      baseRefundLegs =
        [refundLeg "lp-base-refund" pool.baseInstrumentId.id baseRefund | baseRefund > 0.0]
      quoteRefundLegs =
        [refundLeg "lp-quote-refund" pool.quoteInstrumentId.id quoteRefund | quoteRefund > 0.0]
      lpMintLeg = Lp.lpMintLeg recipientAcct pool.lpInstrumentId.id lpAmount

  pure PreparedAddLiquidity with
    addPool = pool
    addState = state
    addRecipientAccount = recipientAcct
    addOperatorAccount = operatorAcct
    addSettlement = settlement
    addBaseDepositLeg = baseDepositLeg
    addQuoteDepositLeg = quoteDepositLeg
    addBaseRefundLegs = baseRefundLegs
    addQuoteRefundLegs = quoteRefundLegs
    addLpMintLeg = lpMintLeg
    addLpAmount = lpAmount
    addBaseUsed = baseUsed
    addQuoteUsed = quoteUsed

mkAddAllocationPlan
  : Party -> Party -> Time -> PreparedAddLiquidity -> AddLiquidityAllocationPlan
mkAddAllocationPlan operator lpRegistrar requestedAt prepared =
  AddLiquidityAllocationPlan with
    baseReceiver = mkOperatorReceiver
      operator prepared.addPool.baseInstrumentId.admin prepared.addSettlement
      prepared.addBaseDepositLeg requestedAt Utils.emptyExtraArgs
    quoteReceiver = mkOperatorReceiver
      operator prepared.addPool.quoteInstrumentId.admin prepared.addSettlement
      prepared.addQuoteDepositLeg requestedAt Utils.emptyExtraArgs
    lpMintSender = V2.AllocationFactory_Allocate with
      settlement = prepared.addSettlement
      allocation = Lp.mintSenderSpec lpRegistrar prepared.addLpMintLeg
      requestedAt
      inputHoldingCids = []
      actors = [lpRegistrar]
      extraArgs = Utils.emptyExtraArgs

-- Group the add legs and allocations by admin: base deposit/refund under the
-- base instrument's admin, quote under the quote instrument's admin, LP mint
-- under the LP registrar. A single-admin pool collapses the base and quote
-- fragments into one asset batch.
addSettlementFragments
  : PreparedAddLiquidity
  -> ContractId V2.Allocation
  -> ContractId V2.Allocation
  -> ContractId V2.Allocation
  -> ContractId V2.Allocation
  -> ContractId V2.Allocation
  -> ContractId V2.Allocation
  -> Map.Map Party AB.AdminFragment
addSettlementFragments
    prepared lpBaseDepositCid lpQuoteDepositCid lpReceiptCid
    operatorBaseReceiverCid operatorQuoteReceiverCid registrarMintCid =
  let pool = prepared.addPool
      baseFrag = AB.AdminFragment with
        transferLegs = prepared.addBaseDepositLeg :: prepared.addBaseRefundLegs
        allocations =
          [ Utils.mkFinalizedAllocation lpBaseDepositCid
              (Utils.legsToSides prepared.addRecipientAccount prepared.addBaseRefundLegs) None
          , Utils.mkFinalizedAllocation operatorBaseReceiverCid
              (Utils.legsToSides prepared.addOperatorAccount prepared.addBaseRefundLegs)
              (Some (TextMap.fromList [(pool.baseInstrumentId.id, prepared.addBaseUsed)]))
          ]
      quoteFrag = AB.AdminFragment with
        transferLegs = prepared.addQuoteDepositLeg :: prepared.addQuoteRefundLegs
        allocations =
          [ Utils.mkFinalizedAllocation lpQuoteDepositCid
              (Utils.legsToSides prepared.addRecipientAccount prepared.addQuoteRefundLegs) None
          , Utils.mkFinalizedAllocation operatorQuoteReceiverCid
              (Utils.legsToSides prepared.addOperatorAccount prepared.addQuoteRefundLegs)
              (Some (TextMap.fromList [(pool.quoteInstrumentId.id, prepared.addQuoteUsed)]))
          ]
      lpFrag = AB.AdminFragment with
        transferLegs = [prepared.addLpMintLeg]
        allocations =
          [Utils.finalAllocation registrarMintCid, Utils.finalAllocation lpReceiptCid]
  in AB.groupByAdmin
       [ (pool.baseInstrumentId.admin, baseFrag)
       , (pool.quoteInstrumentId.admin, quoteFrag)
       , (pool.lpRegistrar, lpFrag)
       ]

-- The caller's allocation-factory context for one admin, used only on the
-- in-choice authoring path. It is operation-specific and distinct from the
-- per-admin settlement context in `batchesByAdmin`; the fallback path aborts
-- rather than borrow settlement context to create an allocation.
lookupAllocationContext
  : Map.Map Party ExtraArgs -> Party -> Update ExtraArgs
lookupAllocationContext allocationContextByAdmin admin =
  case Map.lookup admin allocationContextByAdmin of
    Some ctx -> pure ctx
    None -> abort
      ("no allocation-factory context for admin " <> show admin
        <> "; supply staged allocation cids or a per-admin allocation context")

-- The boundary slice's roll-forward allocation for one side, located by the
-- boundary slice's own allocation cid under the side's admin. None when the
-- boundary was fully consumed (leftover 0) or absent, matching the delivery's
-- decision to roll the boundary forward only when its leftover is positive.
resolveBoundaryRoll
  : Map.Map Party AB.AdminFragment
  -> Map.Map Party V2.SettlementFactory_SettleBatchResult
  -> Party
  -> PM.SliceDraw
  -> Update (Optional (ContractId V2.Allocation))
resolveBoundaryRoll grouped resultsByAdmin admin draw = case draw.boundary of
  Some (_, slice, _, leftover) | leftover > 0.0 ->
    Some <$> AB.requiredNextIteration grouped resultsByAdmin admin slice.allocationCid
  _ -> pure None

data PreparedRemoveLiquidity = PreparedRemoveLiquidity with
    removePool : Pool
    removeState : PS.PoolState
    removeHolderAccount : V2.Account
    removeOperatorAccount : V2.Account
    removeSettlement : V2.SettlementInfo
    removeBurnLeg : V2.TransferLeg
    removeBaseDraw : PM.SliceDraw
    removeQuoteDraw : PM.SliceDraw
    removeBaseDelivery : PE.SideDelivery
    removeQuoteDelivery : PE.SideDelivery
    removeBaseOut : Decimal
    removeQuoteOut : Decimal

prepareRemoveLiquidity
  : Party
  -> Party
  -> PoolId
  -> ContractId Pool
  -> ContractId PS.PoolState
  -> ContractId LP.LPTokenPolicy
  -> Optional (ContractId LAR.LiquidityAllocationRequest)
  -> Optional (ContractId LAR.LiquidityAllocationAcceptance)
  -> Party
  -> Decimal
  -> Decimal
  -> Decimal
  -> Decimal
  -> [ContractId PSlice.PoolSlice]
  -> [ContractId PSlice.PoolSlice]
  -> ContractId V2.Allocation
  -> ContractId V2.Allocation
  -> ContractId V2.Allocation
  -> Update PreparedRemoveLiquidity
prepareRemoveLiquidity
    operator lpRegistrar expectedPoolId poolCid poolStateCid lpPolicyCid
    requestCid acceptanceCid holder lpTokensToRedeem knownTotalLpSupply
    minBaseOut minQuoteOut baseSliceCids quoteSliceCids holderBaseReceiptCid
    holderQuoteReceiptCid holderBurnSenderCid = do
  forA_ [holderBaseReceiptCid, holderQuoteReceiptCid, holderBurnSenderCid]
    enforceAllocationDeadline
  binding <- resolveBinding requestCid acceptanceCid
  let settlement = PM.poolSettlement poolCid operator
  validateAgainstBinding binding holder settlement
    [holderBaseReceiptCid, holderQuoteReceiptCid, holderBurnSenderCid]
  (pool, state) <- PM.fetchPoolContext operator expectedPoolId poolCid poolStateCid
  assertMsg "Pool must be Active to remove liquidity" (state.status == PS_Active)
  assertMsg "LP registrar mismatch" (pool.lpRegistrar == lpRegistrar)
  assertMsg "LP tokens must be positive" (lpTokensToRedeem > 0.0)
  assertMsg "recorded LP supply must be positive" (state.totalLpSupply > 0.0)
  assertMsg "known LP supply must be positive" (knownTotalLpSupply > 0.0)
  assertMsg "Cannot redeem more than supply" (lpTokensToRedeem <= knownTotalLpSupply)
  policy <- fetch lpPolicyCid
  assertMsg "LP policy supply must be positive" (policy.totalSupply > 0.0)
  assertMsg "LPTokenPolicy/PoolState supply divergence"
    (policy.totalSupply == state.totalLpSupply)
  assertMsg "knownTotalLpSupply must match recorded supply"
    (knownTotalLpSupply == state.totalLpSupply)

  let share = PM.floorDiv lpTokensToRedeem knownTotalLpSupply
      baseOut = PM.floorMul state.reserves.baseAmount share
      quoteOut = PM.floorMul state.reserves.quoteAmount share
  assertMsg "Base output below minimum" (baseOut >= minBaseOut)
  assertMsg "Quote output below minimum" (quoteOut >= minQuoteOut)
  assertMsg "Remove base slices must be unique"
    (length (dedup baseSliceCids) == length baseSliceCids)
  assertMsg "Remove quote slices must be unique"
    (length (dedup quoteSliceCids) == length quoteSliceCids)

  baseItems <- forA baseSliceCids (\cid -> do s <- fetch cid; pure (cid, s))
  quoteItems <- forA quoteSliceCids (\cid -> do s <- fetch cid; pure (cid, s))
  forA_ baseItems $ \(_, s) -> do
    assertMsg "Base slice belongs to a different pool" (s.poolId == pool.poolId)
    assertMsg "Base slice operator mismatch" (s.operator == operator)
    assertMsg "Base slice is on the wrong reserve side" (s.side == BaseSide)
  forA_ quoteItems $ \(_, s) -> do
    assertMsg "Quote slice belongs to a different pool" (s.poolId == pool.poolId)
    assertMsg "Quote slice operator mismatch" (s.operator == operator)
    assertMsg "Quote slice is on the wrong reserve side" (s.side == QuoteSide)
  assertMsg "Provided base slices cannot cover the redemption"
    (foldl (\a (_, s) -> a + s.amount) 0.0 baseItems >= baseOut)
  assertMsg "Provided quote slices cannot cover the redemption"
    (foldl (\a (_, s) -> a + s.amount) 0.0 quoteItems >= quoteOut)

  let holderAcct = Utils.basicAccount holder
      operatorAcct = Utils.basicAccount operator
      burnLeg = Lp.lpBurnLeg holderAcct pool.lpInstrumentId.id lpTokensToRedeem
      baseDraw = PM.drawFromSlices baseOut baseItems
      quoteDraw = PM.drawFromSlices quoteOut quoteItems
      baseDel = PE.buildSideDelivery
        "lp-base-out-" operatorAcct holderAcct pool.baseInstrumentId.id baseDraw
      quoteDel = PE.buildSideDelivery
        "lp-quote-out-" operatorAcct holderAcct pool.quoteInstrumentId.id quoteDraw

  pure PreparedRemoveLiquidity with
    removePool = pool
    removeState = state
    removeHolderAccount = holderAcct
    removeOperatorAccount = operatorAcct
    removeSettlement = settlement
    removeBurnLeg = burnLeg
    removeBaseDraw = baseDraw
    removeQuoteDraw = quoteDraw
    removeBaseDelivery = baseDel
    removeQuoteDelivery = quoteDel
    removeBaseOut = baseOut
    removeQuoteOut = quoteOut

mkRemoveAllocationPlan
  : Party -> Time -> PreparedRemoveLiquidity -> RemoveLiquidityAllocationPlan
mkRemoveAllocationPlan lpRegistrar requestedAt prepared =
  RemoveLiquidityAllocationPlan with
    lpBurnReceiver = V2.AllocationFactory_Allocate with
      settlement = prepared.removeSettlement
      allocation = Lp.burnReceiptSpec lpRegistrar prepared.removeBurnLeg
      requestedAt
      inputHoldingCids = []
      actors = [lpRegistrar]
      extraArgs = Utils.emptyExtraArgs

-- Group the remove legs and allocations by admin: base delivery under the base
-- instrument's admin, quote delivery under the quote instrument's admin, LP
-- burn under the LP registrar. A single-admin pool collapses base and quote
-- into one asset batch.
removeSettlementFragments
  : PreparedRemoveLiquidity
  -> ContractId V2.Allocation
  -> ContractId V2.Allocation
  -> ContractId V2.Allocation
  -> ContractId V2.Allocation
  -> Map.Map Party AB.AdminFragment
removeSettlementFragments
    prepared holderBaseReceiptCid holderQuoteReceiptCid
    holderBurnSenderCid registrarBurnReceiverCid =
  let pool = prepared.removePool
      baseFrag = AB.AdminFragment with
        transferLegs = prepared.removeBaseDelivery.legs
        allocations =
          prepared.removeBaseDelivery.sliceFinalizeds
            ++ [Utils.finalAllocation holderBaseReceiptCid]
      quoteFrag = AB.AdminFragment with
        transferLegs = prepared.removeQuoteDelivery.legs
        allocations =
          prepared.removeQuoteDelivery.sliceFinalizeds
            ++ [Utils.finalAllocation holderQuoteReceiptCid]
      lpFrag = AB.AdminFragment with
        transferLegs = [prepared.removeBurnLeg]
        allocations =
          [ Utils.finalAllocation holderBurnSenderCid
          , Utils.finalAllocation registrarBurnReceiverCid
          ]
  in AB.groupByAdmin
       [ (pool.baseInstrumentId.admin, baseFrag)
       , (pool.quoteInstrumentId.admin, quoteFrag)
       , (pool.lpRegistrar, lpFrag)
       ]

data AddLiquidityPreparationArgs = AddLiquidityPreparationArgs with
    expectedPoolId : PoolId
    poolCid : ContractId Pool
    poolStateCid : ContractId PS.PoolState
    lpPolicyCid : ContractId LP.LPTokenPolicy
    requestCid : Optional (ContractId LAR.LiquidityAllocationRequest)
    acceptanceCid : Optional (ContractId LAR.LiquidityAllocationAcceptance)
    recipient : Party
    lpBaseDepositCid : ContractId V2.Allocation
    lpQuoteDepositCid : ContractId V2.Allocation
    lpReceiptCid : ContractId V2.Allocation
    baseAmount : Decimal
    quoteAmount : Decimal
    minLpTokens : Decimal
    knownTotalLpSupply : Decimal
  deriving (Eq, Show)

prepareAddFrom
  : Party -> Party -> AddLiquidityPreparationArgs -> Update PreparedAddLiquidity
prepareAddFrom operator lpRegistrar args =
  prepareAddLiquidity
    operator lpRegistrar args.expectedPoolId args.poolCid args.poolStateCid
    args.lpPolicyCid args.requestCid args.acceptanceCid args.recipient
    args.lpBaseDepositCid args.lpQuoteDepositCid args.lpReceiptCid
    args.baseAmount args.quoteAmount args.minLpTokens args.knownTotalLpSupply

data RemoveLiquidityPreparationArgs = RemoveLiquidityPreparationArgs with
    expectedPoolId : PoolId
    poolCid : ContractId Pool
    poolStateCid : ContractId PS.PoolState
    lpPolicyCid : ContractId LP.LPTokenPolicy
    requestCid : Optional (ContractId LAR.LiquidityAllocationRequest)
    acceptanceCid : Optional (ContractId LAR.LiquidityAllocationAcceptance)
    holder : Party
    lpTokensToRedeem : Decimal
    knownTotalLpSupply : Decimal
    minBaseOut : Decimal
    minQuoteOut : Decimal
    baseSliceCids : [ContractId PSlice.PoolSlice]
    quoteSliceCids : [ContractId PSlice.PoolSlice]
    holderBaseReceiptCid : ContractId V2.Allocation
    holderQuoteReceiptCid : ContractId V2.Allocation
    holderBurnSenderCid : ContractId V2.Allocation
  deriving (Eq, Show)

prepareRemoveFrom
  : Party -> Party -> RemoveLiquidityPreparationArgs -> Update PreparedRemoveLiquidity
prepareRemoveFrom operator lpRegistrar args =
  prepareRemoveLiquidity
    operator lpRegistrar args.expectedPoolId args.poolCid args.poolStateCid
    args.lpPolicyCid args.requestCid args.acceptanceCid args.holder
    args.lpTokensToRedeem args.knownTotalLpSupply args.minBaseOut args.minQuoteOut
    args.baseSliceCids args.quoteSliceCids args.holderBaseReceiptCid
    args.holderQuoteReceiptCid args.holderBurnSenderCid

template PoolLiquidityRules with
    operator : Party
    lpRegistrar : Party
  where
    signatory operator, lpRegistrar

    -- Create the directional request the LP/holder accepts to author the
    -- boundary allocations; the substance is in the Settle choices.
    nonconsuming choice PoolLiquidityRules_RequestAddLiquidity : ContractId LAR.LiquidityAllocationRequest
      with
        poolCid : ContractId Pool
        recipient : Party
        baseAmount : Decimal
        quoteAmount : Decimal
        lpAmount : Decimal
          -- ^ Operator's off-ledger LP quote; the settle bounds it within dust.
        requestedAt : Time
        settleAt : Optional Time
      controller operator
      do
        pool <- fetch poolCid
        let settlement = PM.poolSettlement poolCid operator
            allocations = addLiquiditySpecs pool operator recipient baseAmount quoteAmount lpAmount
        create LAR.LiquidityAllocationRequest with
          operator; lp = recipient; settlement; allocations; requestedAt; settleAt

    nonconsuming choice PoolLiquidityRules_RequestRemoveLiquidity : ContractId LAR.LiquidityAllocationRequest
      with
        poolCid : ContractId Pool
        holder : Party
        baseOuts : [Decimal]
          -- ^ Per-slice out amounts (operator's slice draw), in order.
        quoteOuts : [Decimal]
        lpBurnAmount : Decimal
        requestedAt : Time
        settleAt : Optional Time
      controller operator
      do
        pool <- fetch poolCid
        let settlement = PM.poolSettlement poolCid operator
            allocations = removeLiquiditySpecs pool operator holder baseOuts quoteOuts lpBurnAmount
        create LAR.LiquidityAllocationRequest with
          operator; lp = holder; settlement; allocations; requestedAt; settleAt

    -- The registry sees each exact allocation request before the operator or
    -- registrar creates it. This is a read-only preview; no funds move.
    nonconsuming choice PoolLiquidityRules_PreviewAddAllocations
      : AddLiquidityAllocationPlan
      with
        preparation : AddLiquidityPreparationArgs
        requestedAt : Time
      controller operator, lpRegistrar
      do
        prepared <- prepareAddFrom operator lpRegistrar preparation
        pure $ mkAddAllocationPlan operator lpRegistrar requestedAt prepared

    -- Once those allocations exist, preview the exact per-admin batches so each
    -- registry can return its own settlement context.
    nonconsuming choice PoolLiquidityRules_PreviewAddSettlement
      : Map.Map Party V2.SettlementFactory_SettleBatch
      with
        preparation : AddLiquidityPreparationArgs
        operatorBaseReceiverCid : ContractId V2.Allocation
        operatorQuoteReceiverCid : ContractId V2.Allocation
        registrarMintCid : ContractId V2.Allocation
      controller operator, lpRegistrar
      do
        prepared <- prepareAddFrom operator lpRegistrar preparation
        let grouped = addSettlementFragments
              prepared preparation.lpBaseDepositCid
              preparation.lpQuoteDepositCid preparation.lpReceiptCid
              operatorBaseReceiverCid operatorQuoteReceiverCid registrarMintCid
        pure $ AB.previewByAdmin prepared.addSettlement [operator] grouped

    -- DvP add: allocation creation is staged only so registries can return
    -- operation-specific context. The per-admin settlement batches, pool
    -- slices, reserve accounting, and LP supply update remain one atomic
    -- transaction. A single-admin pool collapses the base and quote batches
    -- into one; a cross-admin pool settles one batch per instrument admin.
    nonconsuming choice PoolLiquidityRules_SettleAddLiquidity
      : PoolLiquidityRules_SettleAddResult
      with
        expectedPoolId : PoolId
        poolCid : ContractId Pool
        poolStateCid : ContractId PS.PoolState
        lpPolicyCid : ContractId LP.LPTokenPolicy
        requestCid : Optional (ContractId LAR.LiquidityAllocationRequest)
        acceptanceCid : Optional (ContractId LAR.LiquidityAllocationAcceptance)
        recipient : Party
        lpBaseDepositCid : ContractId V2.Allocation
        lpQuoteDepositCid : ContractId V2.Allocation
        lpReceiptCid : ContractId V2.Allocation
        baseFactoryCid : ContractId V2.AllocationFactory
        quoteFactoryCid : ContractId V2.AllocationFactory
        lpFactoryCid : ContractId V2.AllocationFactory
        baseAmount : Decimal
        quoteAmount : Decimal
        minLpTokens : Decimal
        knownTotalLpSupply : Decimal
        requestedAt : Time
        batchesByAdmin : Map.Map Party AB.RegistryBatchInput
          -- ^ Per-admin settlement factory + context, keyed by instrument admin
          --   (and the LP registrar). The choice derives the expected admins
          --   from the pool and settles one batch per key.
        -- Optional staging cids. When present the pre-created operator receiver
        -- and registrar mint allocations are settled directly; when all absent
        -- the choice authors them through the factory fields above, using each
        -- admin's allocation-factory context from `allocationContextByAdmin`.
        operatorBaseReceiverCid : Optional (ContractId V2.Allocation)
        operatorQuoteReceiverCid : Optional (ContractId V2.Allocation)
        registrarMintCid : Optional (ContractId V2.Allocation)
        allocationContextByAdmin : Map.Map Party ExtraArgs
          -- ^ Per-admin allocation-factory context for the in-choice authoring
          --   path, distinct from the settlement context in `batchesByAdmin`.
          --   Unused (may be empty) when staged allocation cids are supplied.
      controller operator, lpRegistrar
      do
        let preparation = AddLiquidityPreparationArgs with
              expectedPoolId; poolCid; poolStateCid; lpPolicyCid
              requestCid; acceptanceCid; recipient
              lpBaseDepositCid; lpQuoteDepositCid; lpReceiptCid
              baseAmount; quoteAmount; minLpTokens; knownTotalLpSupply
        prepared <- prepareAddFrom operator lpRegistrar preparation
        let allocationPlan = mkAddAllocationPlan operator lpRegistrar requestedAt prepared
            pool = prepared.addPool
            baseAdmin = pool.baseInstrumentId.admin
            quoteAdmin = pool.quoteInstrumentId.admin
        (baseReceiverCid, quoteReceiverCid, mintCid) <-
          case (operatorBaseReceiverCid, operatorQuoteReceiverCid, registrarMintCid) of
            (Some b, Some q, Some m) -> pure (b, q, m)
            (None, None, None) -> do
              baseCtx <- lookupAllocationContext allocationContextByAdmin baseAdmin
              quoteCtx <- lookupAllocationContext allocationContextByAdmin quoteAdmin
              lpCtx <- lookupAllocationContext allocationContextByAdmin pool.lpRegistrar
              b <- exercise baseFactoryCid
                (allocationPlan.baseReceiver with extraArgs = baseCtx)
                >>= PM.extractCompleted
              q <- exercise quoteFactoryCid
                (allocationPlan.quoteReceiver with extraArgs = quoteCtx)
                >>= PM.extractCompleted
              m <- exercise lpFactoryCid
                (allocationPlan.lpMintSender with extraArgs = lpCtx)
                >>= PM.extractCompleted
              pure (b, q, m)
            _ -> abort "SettleAddLiquidity: staged allocation cids must be all present or all absent"
        let state = prepared.addState
            lpAmount = prepared.addLpAmount
            baseUsed = prepared.addBaseUsed
            quoteUsed = prepared.addQuoteUsed
            grouped = addSettlementFragments
              prepared preparation.lpBaseDepositCid
              preparation.lpQuoteDepositCid preparation.lpReceiptCid
              baseReceiverCid quoteReceiverCid mintCid

        resultsByAdmin <-
          AB.settleByAdmin prepared.addSettlement [operator] grouped batchesByAdmin
        nextBaseAllocCid <-
          AB.requiredNextIteration grouped resultsByAdmin baseAdmin baseReceiverCid
        nextQuoteAllocCid <-
          AB.requiredNextIteration grouped resultsByAdmin quoteAdmin quoteReceiverCid

        PM.validateSliceAllocation nextBaseAllocCid pool.baseInstrumentId
        PM.validateSliceAllocation nextQuoteAllocCid pool.quoteInstrumentId
        baseSliceCid <- create PSlice.PoolSlice with
          poolId = pool.poolId; operator; side = BaseSide
          instrumentId = pool.baseInstrumentId
          allocationCid = nextBaseAllocCid; amount = baseUsed
        quoteSliceCid <- create PSlice.PoolSlice with
          poolId = pool.poolId; operator; side = QuoteSide
          instrumentId = pool.quoteInstrumentId
          allocationCid = nextQuoteAllocCid; amount = quoteUsed

        newPolicyCid <- exercise preparation.lpPolicyCid
          LP.LPTokenPolicy_RecordMint with amount = lpAmount

        archiveBinding preparation.requestCid preparation.acceptanceCid
        -- Per-choice delta conservation. This choice creates exactly
        -- one slice per side; the reserve deltas it writes must equal those
        -- created slice amounts.
        newBaseSlice <- fetch baseSliceCid
        newQuoteSlice <- fetch quoteSliceCid
        assertMsg "add: base reserve delta must equal created base slice amount"
          (newBaseSlice.amount == baseUsed)
        assertMsg "add: quote reserve delta must equal created quote slice amount"
          (newQuoteSlice.amount == quoteUsed)
        archive preparation.poolStateCid
        newStateCid <- create state with
          status = PS_Active
          reserves = PoolReserves with
            baseAmount = state.reserves.baseAmount + baseUsed
            quoteAmount = state.reserves.quoteAmount + quoteUsed
          totalLpSupply = state.totalLpSupply + lpAmount

        pure PoolLiquidityRules_SettleAddResult with
          poolStateCid = newStateCid
          baseSliceCid; quoteSliceCid
          lpPolicyCid = newPolicyCid
          lpTokensMinted = lpAmount
          baseAdded = Some baseUsed
          quoteAdded = Some quoteUsed

    nonconsuming choice PoolLiquidityRules_PreviewRemoveAllocations
      : RemoveLiquidityAllocationPlan
      with
        preparation : RemoveLiquidityPreparationArgs
        requestedAt : Time
      controller operator, lpRegistrar
      do
        prepared <- prepareRemoveFrom operator lpRegistrar preparation
        pure $ mkRemoveAllocationPlan lpRegistrar requestedAt prepared

    nonconsuming choice PoolLiquidityRules_PreviewRemoveSettlement
      : Map.Map Party V2.SettlementFactory_SettleBatch
      with
        preparation : RemoveLiquidityPreparationArgs
        registrarBurnReceiverCid : ContractId V2.Allocation
      controller operator, lpRegistrar
      do
        prepared <- prepareRemoveFrom operator lpRegistrar preparation
        let grouped = removeSettlementFragments
              prepared preparation.holderBaseReceiptCid
              preparation.holderQuoteReceiptCid preparation.holderBurnSenderCid
              registrarBurnReceiverCid
        pure $ AB.previewByAdmin prepared.removeSettlement [operator] grouped

    -- DvP remove: the pre-created registrar burn receiver is combined with the
    -- per-admin settlement batches in one atomic pool-state transition. A
    -- single-admin pool collapses base and quote into one asset batch; a
    -- cross-admin pool settles one batch per instrument admin.
    nonconsuming choice PoolLiquidityRules_SettleRemoveLiquidity
      : PoolLiquidityRules_SettleRemoveResult
      with
        expectedPoolId : PoolId
        poolCid : ContractId Pool
        poolStateCid : ContractId PS.PoolState
        lpPolicyCid : ContractId LP.LPTokenPolicy
        requestCid : Optional (ContractId LAR.LiquidityAllocationRequest)
        acceptanceCid : Optional (ContractId LAR.LiquidityAllocationAcceptance)
        holder : Party
        lpTokensToRedeem : Decimal
        knownTotalLpSupply : Decimal
        minBaseOut : Decimal
        minQuoteOut : Decimal
        baseSliceCids : [ContractId PSlice.PoolSlice]
        quoteSliceCids : [ContractId PSlice.PoolSlice]
        holderBaseReceiptCid : ContractId V2.Allocation
        holderQuoteReceiptCid : ContractId V2.Allocation
        holderBurnSenderCid : ContractId V2.Allocation
        lpFactoryCid : ContractId V2.AllocationFactory
        requestedAt : Time
        batchesByAdmin : Map.Map Party AB.RegistryBatchInput
          -- ^ Per-admin settlement factory + context, keyed by instrument admin
          --   (and the LP registrar).
        registrarBurnReceiverCid : Optional (ContractId V2.Allocation)
        allocationContextByAdmin : Map.Map Party ExtraArgs
          -- ^ Per-admin allocation-factory context for the in-choice authoring
          --   path (the registrar burn receiver), distinct from the settlement
          --   context in `batchesByAdmin`. Unused when a staged cid is supplied.
      controller operator, lpRegistrar
      do
        let preparation = RemoveLiquidityPreparationArgs with
              expectedPoolId; poolCid; poolStateCid; lpPolicyCid
              requestCid; acceptanceCid; holder
              lpTokensToRedeem; knownTotalLpSupply; minBaseOut; minQuoteOut
              baseSliceCids; quoteSliceCids
              holderBaseReceiptCid; holderQuoteReceiptCid; holderBurnSenderCid
        prepared <- prepareRemoveFrom operator lpRegistrar preparation
        let pool = prepared.removePool
            baseAdmin = pool.baseInstrumentId.admin
            quoteAdmin = pool.quoteInstrumentId.admin
        burnReceiverCid <- case registrarBurnReceiverCid of
          Some cid -> pure cid
          None -> do
            lpCtx <- lookupAllocationContext allocationContextByAdmin pool.lpRegistrar
            let allocationPlan = mkRemoveAllocationPlan lpRegistrar requestedAt prepared
            exercise lpFactoryCid
              (allocationPlan.lpBurnReceiver with extraArgs = lpCtx)
              >>= PM.extractCompleted
        let state = prepared.removeState
            baseOut = prepared.removeBaseOut
            quoteOut = prepared.removeQuoteOut
            baseDraw = prepared.removeBaseDraw
            quoteDraw = prepared.removeQuoteDraw
            baseDel = prepared.removeBaseDelivery
            quoteDel = prepared.removeQuoteDelivery
            grouped = removeSettlementFragments
              prepared preparation.holderBaseReceiptCid
              preparation.holderQuoteReceiptCid preparation.holderBurnSenderCid
              burnReceiverCid

        resultsByAdmin <-
          AB.settleByAdmin prepared.removeSettlement [operator] grouped batchesByAdmin
        -- The boundary slice on each side rolls forward when its leftover is
        -- positive; find that roll-forward under the side's own admin.
        baseRollCid <- resolveBoundaryRoll grouped resultsByAdmin baseAdmin baseDraw
        quoteRollCid <- resolveBoundaryRoll grouped resultsByAdmin quoteAdmin quoteDraw

        forA_ (baseDel.drainedSliceCids ++ quoteDel.drainedSliceCids) archive
        -- Re-wrap each boundary slice: archive the old; create a fresh one for
        -- the leftover when >0 (else it drains too).
        let rewrapBoundary side instrumentId rollCid mb = case mb of
              None -> pure None
              Some (oldCid, leftover) -> do
                archive oldCid
                if leftover > 0.0
                  then case rollCid of
                    Some cid -> do
                      PM.validateSliceAllocation cid instrumentId
                      Some <$> create PSlice.PoolSlice with
                        poolId = pool.poolId; operator; side
                        instrumentId
                        allocationCid = cid; amount = leftover
                    None -> abort "remove: boundary must roll forward"
                  else pure None
        boundaryBaseSliceCid <-
          rewrapBoundary BaseSide pool.baseInstrumentId baseRollCid baseDel.boundary
        boundaryQuoteSliceCid <-
          rewrapBoundary QuoteSide pool.quoteInstrumentId quoteRollCid quoteDel.boundary

        newPolicyCid <- exercise preparation.lpPolicyCid
          LP.LPTokenPolicy_RecordBurn with amount = preparation.lpTokensToRedeem

        archiveBinding preparation.requestCid preparation.acceptanceCid

        -- Per-choice delta conservation. The reserve delta per side
        -- must equal the net slice-amount change this choice performed:
        -- consumed slice amounts (drained + old boundary) minus the re-wrapped
        -- boundary leftover.
        let consumedOf : PM.SliceDraw -> Decimal
            consumedOf d =
              foldl (\acc (_, s) -> acc + s.amount) 0.0 d.fullyConsumed
                + (case d.boundary of Some (_, s, _, _) -> s.amount; None -> 0.0)
            leftoverOf : PM.SliceDraw -> Decimal
            leftoverOf d = case d.boundary of Some (_, _, _, lo) -> lo; None -> 0.0
        assertMsg "remove: net base slice delta must equal -baseOut"
          (consumedOf baseDraw - leftoverOf baseDraw == baseOut)
        assertMsg "remove: net quote slice delta must equal -quoteOut"
          (consumedOf quoteDraw - leftoverOf quoteDraw == quoteOut)

        let newBase = state.reserves.baseAmount - baseOut
            newQuote = state.reserves.quoteAmount - quoteOut
        archive preparation.poolStateCid
        newStateCid <- create state with
          status = if newBase == 0.0 && newQuote == 0.0 then PS_Unfunded else PS_Active
          reserves = PoolReserves with baseAmount = newBase; quoteAmount = newQuote
          totalLpSupply = state.totalLpSupply - preparation.lpTokensToRedeem

        pure PoolLiquidityRules_SettleRemoveResult with
          poolStateCid = newStateCid
          boundaryBaseSliceCid; boundaryQuoteSliceCid
          lpPolicyCid = newPolicyCid
          baseReturned = baseOut
          quoteReturned = quoteOut
