-- | Shared pool primitives: the constant-product math, the pool settlement
-- descriptor, the config/state fetch guard, and the ordered slice draw.
-- Both venues (PoolRules swap, PoolLiquidityRules add/remove) build on
-- these, so they live here rather than in either venue module.
module CantonDex.Dex.PoolModel where

import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.AllocationInstructionV2 qualified as V2
import Splice.Api.Token.MetadataV1

import CantonDex.Dex.Pool
import CantonDex.Dex.PoolState
import CantonDex.Dex.PoolSlice

-- Math --------------------------------------------------------------------

-- | One unit in the last place of `Decimal` (= `Numeric 10`).
ulp : Decimal
ulp = 0.0000000001

-- | Integer and fractional parts; the fraction is always in [0.0, 1.0).
splitInt : Decimal -> (Decimal, Decimal)
splitInt v = let i = intToDecimal (floor v) in (i, v - i)

-- | Orders the EXACT products `a * b` and `c * d`. Daml's `*` rounds its
-- result to 10 dp, discarding precisely the sub-ulp margin the floors below
-- turn on, so each product is compared as an exactly representable 10 dp part
-- plus its scaled sub-unit remainder.
compareProducts : Decimal -> Decimal -> Decimal -> Decimal -> Ordering
compareProducts a b c d =
  let (ai, af) = splitInt a
      (bi, bf) = splitInt b
      (ci, cf) = splitInt c
      (di, df) = splitInt d
      hi = (ai * bi + ai * bf + af * bi) - (ci * di + ci * df + cf * di)
      loL = (af * 1e10) * (bf * 1e10) / 1e10
      loR = (cf * 1e10) * (df * 1e10) / 1e10
  in if hi >= 1.0 then GT
     else if hi <= -1.0 then LT
     else compare (hi * 1e10 + loL) loR

-- | Largest `Decimal` not exceeding the exact product `x * y`. Payouts
-- sourced from the pool (constant-product output, pro-rata redemption) round
-- DOWN so the pool never pays out more than the exact amount, keeping x*y=k
-- non-decreasing; `Decimal` is already scale 10, so the rounding has to be
-- corrected here rather than by re-flooring the finished product.
floorMul : Decimal -> Decimal -> Decimal
floorMul x y =
  let p = x * y
  in if compareProducts x y p 1.0 == LT then p - ulp else p

-- | Largest `Decimal` not exceeding the exact quotient `n / d`, for `d > 0.0`.
floorDiv : Decimal -> Decimal -> Decimal
floorDiv n d =
  let q = n / d
  in if compareProducts q d n 1.0 == GT then q - ulp else q

-- | Smallest `Decimal` not below the exact product `x * y`. The mirror of
-- `floorMul`: amounts drawn INTO the pool round up.
ceilMul : Decimal -> Decimal -> Decimal
ceilMul x y =
  let p = x * y
  in if compareProducts x y p 1.0 == GT then p + ulp else p

-- | Smallest `Decimal` not below the exact quotient `n / d`, for `d > 0.0`.
ceilDiv : Decimal -> Decimal -> Decimal
ceilDiv n d =
  let q = n / d
  in if compareProducts q d n 1.0 == LT then q + ulp else q

-- | Smallest `Decimal` not below the exact value `x * y / d`, for `d > 0.0`.
-- Chaining `ceilMul` onto `ceilDiv` will not do: each rounds independently, so
-- the quotient's ulp of slack comes back multiplied by `y`. Two round-ups do
-- make an upper bound, which is all the estimate has to be; `compareProducts`
-- then walks it down to the exact boundary.
ceilMulDiv : Decimal -> Decimal -> Decimal -> Decimal
ceilMulDiv x y d
  | x <= 0.0 || y <= 0.0 = 0.0
  | otherwise =
      let reaches q = compareProducts q d x y /= LT
      in stepDownTo reaches (ceilDiv (ceilMul x y) d) ulp

-- Step down from a satisfying `hi` by a doubling stride until a value that
-- does not satisfy, then halve the bracket. `holds` must be monotone and
-- must not hold at 0.0.
stepDownTo : (Decimal -> Bool) -> Decimal -> Decimal -> Decimal
stepDownTo holds hi step =
  let lo = max 0.0 (hi - step)
  in if holds lo then stepDownTo holds lo (step * 2.0) else halveTo holds lo hi

-- Smallest satisfying value in `(lo, hi]`, where `lo` does not satisfy.
halveTo : (Decimal -> Bool) -> Decimal -> Decimal -> Decimal
halveTo holds lo hi
  | hi - lo <= ulp = hi
  | otherwise =
      let mid = lo + (hi - lo) / 2.0
      in if holds mid then halveTo holds lo mid else halveTo holds mid hi

-- | The portion of a two-sided deposit that matches the pool's current ratio,
-- for a funded pool (both reserves > 0). The side that is short relative to
-- the reserve ratio goes in whole; the other goes in only as far as that side
-- exactly backs, rounded up by at most one ulp and capped at what was offered.
-- The remainder buys no LP tokens, so the pool must not take it.
ratioMatchedDeposit : PoolReserves -> Decimal -> Decimal -> (Decimal, Decimal)
ratioMatchedDeposit reserves baseAmount quoteAmount =
  let rb = reserves.baseAmount
      rq = reserves.quoteAmount
  in if compareProducts baseAmount rq quoteAmount rb == GT
       then (min baseAmount (ceilMulDiv quoteAmount rb rq), quoteAmount)
       else (baseAmount, min quoteAmount (ceilMulDiv baseAmount rq rb))

newtonSqrt : Decimal -> Decimal -> Int -> Decimal
newtonSqrt target guess iteration
  | iteration >= 50 = guess
  | abs (guess * guess - target) < 0.0000000001 = guess
  | otherwise = newtonSqrt target ((guess + target / guess) / 2.0) (iteration + 1)

sqrtDecimal : Decimal -> Decimal
sqrtDecimal x
  | x <= 0.0 = 0.0
  | otherwise = newtonSqrt x (x / 2.0) 0

constantProductOut : Decimal -> Decimal -> Int -> Decimal -> Decimal
constantProductOut reserveIn reserveOut feeBps inputAmount =
  let amountInAfterFee =
        floorDiv (floorMul inputAmount (intToDecimal (10000 - feeBps))) 10000.0
  in floorDiv (floorMul amountInAfterFee reserveOut) (reserveIn + amountInAfterFee)

-- Helpers -----------------------------------------------------------------

extractCompleted : V2.AllocationInstructionResult -> Update (ContractId V2.Allocation)
extractCompleted result = case result.output of
  V2.AllocationInstructionResult_Completed allocCid -> pure allocCid
  _ -> abort "Pool allocation requires immediate completion"

poolSettlement : ContractId Pool -> Party -> V2.SettlementInfo
poolSettlement poolCid operator = V2.SettlementInfo with
  executors = [operator]
  id = "DexPool"
  cid = Some (coerceContractId poolCid)
  meta = emptyMetadata

-- Fetch config + state and assert they are the expected, mutually consistent
-- pool (the expectedPoolId contract-swap guard).
fetchPoolContext
  : Party -> PoolId -> ContractId Pool -> ContractId PoolState
  -> Update (Pool, PoolState)
fetchPoolContext operator expectedPoolId poolCid poolStateCid = do
  pool <- fetch poolCid
  state <- fetch poolStateCid
  assertMsg "expectedPoolId mismatch (pool config swapped?)"
    (pool.poolId == expectedPoolId)
  assertMsg "PoolState does not belong to this pool"
    (state.poolId == expectedPoolId)
  assertMsg "Pool config operator mismatch" (pool.operator == operator)
  assertMsg "PoolState operator mismatch" (state.operator == operator)
  pure (pool, state)

-- Draw `target` from the front of an ordered (cid, slice) list: the
-- fully-consumed slices, plus the boundary slice (drawn + leftover). Aborts
-- if the slices cannot cover `target`.
data SliceDraw = SliceDraw with
    fullyConsumed : [(ContractId PoolSlice, PoolSlice)]
    boundary : Optional (ContractId PoolSlice, PoolSlice, Decimal, Decimal)
      -- ^ (cid, slice, drawn, leftover)
  deriving (Eq, Show)

drawFromSlices
  : Decimal -> [(ContractId PoolSlice, PoolSlice)] -> SliceDraw
drawFromSlices target items = drawFromSlicesAcc target items []

drawFromSlicesAcc
  : Decimal
  -> [(ContractId PoolSlice, PoolSlice)]
  -> [(ContractId PoolSlice, PoolSlice)]
  -> SliceDraw
drawFromSlicesAcc remaining xs acc
  | remaining <= 0.0 = SliceDraw with fullyConsumed = reverse acc; boundary = None
  | otherwise = case xs of
      [] -> error "drawFromSlices: provided slices cannot cover the required amount"
      (cid, s) :: rest
        | remaining >= s.amount -> drawFromSlicesAcc (remaining - s.amount) rest ((cid, s) :: acc)
        | otherwise ->
            SliceDraw with
              fullyConsumed = reverse acc
              boundary = Some (cid, s, remaining, s.amount - remaining)
