-- | One committed allocation backing one side of a pool.
--
-- Moving slices out of the `Pool` contract prevents an unbounded allocation
-- list on the hot state. `PoolState` remains the pricing serialization point,
-- while remove/swap touch only the reserve slices they source. The
-- operator-backend indexer tracks slices by `poolId` and supplies the relevant
-- `ContractId`s to each rules choice.
--
-- `amount` is stored alongside the allocation cid so the rules choices
-- can walk slices without a `fetch` per slice for the amount. It is
-- always reconciled against the underlying allocation's funding by the
-- choice that writes the slice.
--
-- Design guide: `docs/concepts/design-tour.md#liquidity-and-pool-custody`.
module CantonDex.Dex.PoolSlice where

import Splice.Api.Token.AllocationV2 qualified as V2

import CantonDex.Dex.Pool (PoolId, Side)

template PoolSlice with
    poolId : PoolId
    operator : Party
    side : Side
      -- ^ Which pool leg (base or quote) this slice funds.
    allocationCid : ContractId V2.Allocation
      -- ^ The committed allocation holding this slice's funds.
    amount : Decimal
      -- ^ Cached funded amount; reconciled against the allocation by the
      --   choice that writes the slice.
  where
    signatory operator

    ensure poolId /= "" && amount > 0.0
