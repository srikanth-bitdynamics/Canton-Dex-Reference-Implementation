-- | Minimal credential model for the standalone lifecycle sample. It is not a
-- Token Standard V2 credential API and active DEX workflows do not query it.
-- The verifier accepts party-issued claims at face value, so it is unsuitable
-- for production authorization. [COMPAT] It remains for package lineage.
--
-- Design guide: `docs/concepts/design-tour.md#active-and-compatibility-surfaces`.
module CantonDex.Instrument.Credentials where

-- | One credential requirement on an InstrumentConfiguration.
data CredentialRequirement = CredentialRequirement with
    issuer : Party
    property : Text
      -- ^ e.g. "isHolderOf", "isIssuerOf".
    value : Text
  deriving (Eq, Show, Ord)

-- | A claim presented by a party, signed by `issuer`.
template Credential with
    issuer : Party
    holder : Party
    property : Text
    value : Text
  where
    signatory issuer
    observer holder

-- | Each requirement must have at least one matching claim.
verifyCredentials
  : Party -> [CredentialRequirement] -> [Credential] -> Bool
verifyCredentials party reqs claims =
  all matchOne reqs
  where
    matchOne req = any
      (\c -> c.issuer == req.issuer
          && c.property == req.property
          && c.value == req.value
          && c.holder == party)
      claims
